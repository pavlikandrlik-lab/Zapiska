<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="PM Tracker (Zapiska)" id="pmtracker-model" version="5.0.0">
  <purpose>Kompletni dokumentacni ArchiMate model aplikace PM Tracker (interni aplikace pro evidenci a rizeni projektu, jednani, zaznamu, tymu a ciselniku). Model zachycuje cca 70-85 % funkcionality; zbytek se doplni po dokonceni. Generovano z /tmp/gen_archimate.py - editujte generator, ne vystupni soubor.</purpose>
  <folder name="Strategy" id="folder-strategy" type="strategy"/>
  <folder name="Business" id="folder-business" type="business">
    <folder name="Actors" id="folder-business-actors">
      <element xsi:type="archimate:BusinessActor" name="Projektovy manazer (PM)" id="ba-pm" documentation="Ridi projekt, eviduje zaznamy, planuje jednani, spravuje tym. Role PROJ_MAN."/>
      <element xsi:type="archimate:BusinessActor" name="Vlastnik projektu" id="ba-vlastnik" documentation="Business Owner - schvaluje jednani, odpovida za projekt ke sponzorovi. Role VLASTNIK_PROJEKTU."/>
      <element xsi:type="archimate:BusinessActor" name="Admin projektu" id="ba-admin-proj" documentation="Administrator projektu - spravuje metadata, tym, ciselniky; nema schvalovaci prava. Role ADM_PROJ."/>
      <element xsi:type="archimate:BusinessActor" name="Vedouci subsystemu" id="ba-vedouci-ss" documentation="Odpovida za subsystem, komentuje zaznamy tykajici se jeho subsystemu. Role VEDOUCI_SUBSYSTEMU."/>
      <element xsi:type="archimate:BusinessActor" name="Zastupce vedouciho subsystemu" id="ba-zastupce-ss" documentation="Zastupuje vedouciho subsystemu v komentarich. Role ZASTUPCE_VEDOUCIHO_SUBSYSTEMU."/>
      <element xsi:type="archimate:BusinessActor" name="Metodik subsystemu" id="ba-metodik-ss" documentation="Metodicke vedeni subsystemu, navrhove dokumenty. Role METODIK_SUBSYSTEMU."/>
      <element xsi:type="archimate:BusinessActor" name="Clen tymu projektu" id="ba-clen-tymu" documentation="Osoba priradena k tymu projektu, read-only pristup k relevantnim zaznamum."/>
      <element xsi:type="archimate:BusinessActor" name="SuperAdmin / IT Admin" id="ba-super-admin" documentation="Systemovy administrator - spravuje uzivatele, role, permission mapping, ciselniky."/>
    </folder>
    <folder name="Roles" id="folder-business-roles">
      <element xsi:type="archimate:BusinessRole" name="Role PM" id="br-project-manager" documentation="Klic rolovych opravneni pro projektoveho manazera (projects.edit, records.edit, meetings.create, team.manage)."/>
      <element xsi:type="archimate:BusinessRole" name="Role vlastnika projektu" id="br-project-owner" documentation="Klic pro vlastnika (projects.edit, meetings.edit, schvalovani jednani)."/>
      <element xsi:type="archimate:BusinessRole" name="Role admina projektu" id="br-project-admin" documentation="Klic pro admina projektu (projects.edit metadata, team.manage, people.manage)."/>
      <element xsi:type="archimate:BusinessRole" name="Role vedouciho subsystemu" id="br-subsystem-lead" documentation="Klic pro vedouciho/zastupce/metodika subsystemu (records.comment.subsystemlead, schedule.edit)."/>
      <element xsi:type="archimate:BusinessRole" name="Role clena tymu" id="br-team-member" documentation="Implicitni role pro cleny tymu (read-only pristup k priraznenym projektum)."/>
      <element xsi:type="archimate:BusinessRole" name="Role systemoveho administratora" id="br-system-admin" documentation="Plna prava (settings.manage, ciselniky.edit, users/roles/permissions)."/>
    </folder>
    <folder name="Functions" id="folder-business-functions">
      <element xsi:type="archimate:BusinessFunction" name="Rizeni projektu" id="bf-rizeni-projektu" documentation="Funkce zastresujici kompletni lifecycle projektu - zalozeni, harmonogram, tym, uzavreni."/>
      <element xsi:type="archimate:BusinessFunction" name="Rizeni jednani" id="bf-rizeni-jednani" documentation="Funkce planovani a evidence jednani vcetne schvalovaciho workflow."/>
      <element xsi:type="archimate:BusinessFunction" name="Evidence zaznamu / ukolu" id="bf-evidence-ukolu" documentation="Funkce evidence zaznamu (tasks) s harmonogramem, prioritou, komentari subsystemu."/>
      <element xsi:type="archimate:BusinessFunction" name="Personalni sprava" id="bf-personalni-sprava" documentation="Funkce onboardingu osob (AD lookup), spravy uzivatelu a jejich prirazeni."/>
      <element xsi:type="archimate:BusinessFunction" name="Referencni data / Ciselniky" id="bf-referencni-data" documentation="Funkce spravy lookup values - stavy, kategorie, role, subsystemy, typy."/>
      <element xsi:type="archimate:BusinessFunction" name="Sprava vyzev (Tender)" id="bf-tender-management" documentation="Funkce evidence vyzev v ramci projektu a jejich stavoveho workflow."/>
      <element xsi:type="archimate:BusinessFunction" name="Reporting" id="bf-reporting" documentation="Funkce reportovani - exporty, dashboardy, priority matrix."/>
      <element xsi:type="archimate:BusinessFunction" name="Bezpecnost &amp; autorizace" id="bf-bezpecnost-autz" documentation="Funkce rizeni pristupu - role, permissions, scopes (Global/Project/Subsystem)."/>
    </folder>
    <folder name="Processes" id="folder-business-processes">
      <element xsi:type="archimate:BusinessProcess" name="Sprava projektu (lifecycle)" id="bp-sprava-projektu" documentation="Proces od zalozeni projektu, pres aktualizaci metadat, harmonogramu, az po uzavreni."/>
      <element xsi:type="archimate:BusinessProcess" name="Planovani a evidence jednani" id="bp-planovani-jednani" documentation="Zalozeni jednani, pozvani ucastniku, evidence prubehu."/>
      <element xsi:type="archimate:BusinessProcess" name="Schvalovani jednani" id="bp-schvalovani-jednani" documentation="Workflow prechodu jednani ze stavu &#x27;otevrene&#x27; do &#x27;uzavrene&#x27; se zaznamem o schvaleni."/>
      <element xsi:type="archimate:BusinessProcess" name="Sprava zaznamu a harmonogramu" id="bp-sprava-zaznamu" documentation="Zalozeni/edit zaznamu, planovany vs. skutecny harmonogram, prioritni matrix."/>
      <element xsi:type="archimate:BusinessProcess" name="Sprava tymu projektu" id="bp-sprava-tymu" documentation="Prirazovani osob k projektu, roli a subsystemu."/>
      <element xsi:type="archimate:BusinessProcess" name="Sprava osob (AD onboarding)" id="bp-sprava-osob" documentation="Vyhledani osoby v AD, manualni vytvoreni interniho zaznamu, aktualizace."/>
      <element xsi:type="archimate:BusinessProcess" name="Sprava vyzev (Vyzvy)" id="bp-sprava-vyzev" documentation="Evidence vyzev, sledovani stavu a vazeb na projekt."/>
      <element xsi:type="archimate:BusinessProcess" name="Komentare subsystemu k zaznamum" id="bp-komentare-ss" documentation="Vedouci/zastupce/metodik subsystemu pridava vyjadreni k zaznamum ovlivnujicim subsystem."/>
    </folder>
    <folder name="Services" id="folder-business-services">
      <element xsi:type="archimate:BusinessService" name="Sluzba evidence projektu" id="bs-evidence-projektu" documentation="Externi business sluzba - moznost zaznamenavat a aktualizovat informace o projektech."/>
      <element xsi:type="archimate:BusinessService" name="Sluzba rizeni jednani" id="bs-rizeni-jednani" documentation="Externi business sluzba - planovani jednani, evidence pozvaneek a ucasti."/>
      <element xsi:type="archimate:BusinessService" name="Sluzba schvalovani jednani" id="bs-schvalovani-jednani" documentation="Externi business sluzba - uzavirani jednani vlastnikem/PM."/>
      <element xsi:type="archimate:BusinessService" name="Sluzba spravy zaznamu" id="bs-sprava-zaznamu" documentation="Externi business sluzba - evidence zaznamu/ukolu a jejich harmonogramu."/>
      <element xsi:type="archimate:BusinessService" name="Sluzba reportingu projektu" id="bs-reporting-projektu" documentation="Externi business sluzba - generovani exportu (PDF/Word) a dashboardu."/>
      <element xsi:type="archimate:BusinessService" name="Sluzba autorizace uzivatelu" id="bs-autorizace-uzivatelu" documentation="Externi business sluzba - prideleni roli a opravneni uzivatelum."/>
      <element xsi:type="archimate:BusinessService" name="Sluzba evidence vyzev" id="bs-evidence-vyzev" documentation="Externi business sluzba - evidence a sledovani vyzev (Vyzvy)."/>
      <element xsi:type="archimate:BusinessService" name="Sluzba spravy osob" id="bs-sprava-osob" documentation="Externi business sluzba - onboarding osob z AD, sprava kontaktu."/>
    </folder>
  </folder>
  <folder name="Application" id="folder-application" type="application">
    <folder name="Components" id="folder-app-components">
      <folder name="Web &amp; Moduly" id="folder-app-components-web">
      <element xsi:type="archimate:ApplicationComponent" name="PmTracker.Web (MVC + API)" id="ac-pmtracker-web" documentation="ASP.NET Core MVC monolit, .NET 8, hostujici Web UI, API endpointy a business moduly. Deploy na IIS."/>
      <element xsi:type="archimate:ApplicationComponent" name="Projects Module" id="ac-projects-module" documentation="Feature modul - CRUD projektu, harmonogram, metadata, subsystemy v projektu."/>
      <element xsi:type="archimate:ApplicationComponent" name="Records Module" id="ac-records-module" documentation="Feature modul - CRUD zaznamu (tasks), schedule (planovany vs skutecny), priority matrix, navrhy uprav."/>
      <element xsi:type="archimate:ApplicationComponent" name="Meetings Module" id="ac-meetings-module" documentation="Feature modul - CRUD jednani, ucast, workflow (otevrene/uzavrene), vazby na zaznamy."/>
      <element xsi:type="archimate:ApplicationComponent" name="People Module" id="ac-people-module" documentation="Feature modul - sprava osob, AD lookup, onboarding, kontaktni udaje."/>
      <element xsi:type="archimate:ApplicationComponent" name="Team Module" id="ac-team-module" documentation="Feature modul - clenstvi v tymu projektu, prirazovani role a subsystemu."/>
      <element xsi:type="archimate:ApplicationComponent" name="Ciselniky Module" id="ac-ciselniky-module" documentation="Feature modul - sprava referencnich dat (stavy, kategorie, role, typy)."/>
      <element xsi:type="archimate:ApplicationComponent" name="Vyzvy Module" id="ac-vyzvy-module" documentation="Feature modul - evidence vyzev v ramci projektu, sledovani stavu."/>
      <element xsi:type="archimate:ApplicationComponent" name="Dashboard Module" id="ac-dashboard-module" documentation="Feature modul - prehledove dashboardy, priority matrix, kompozitni widgety."/>
      <element xsi:type="archimate:ApplicationComponent" name="Authorization Module" id="ac-authz-module" documentation="Feature modul - AuthzRole, AuthzPermission, RoleScope (Global/Project/Subsystem), mapping z ciselnik_roli_*."/>
      <element xsi:type="archimate:ApplicationComponent" name="Documentation Module" id="ac-docs-module" documentation="Feature modul - in-app dokumentace renderovana z docs/*.md pres Markdig."/>
      </folder>
      <folder name="Workers &amp; Adapters" id="folder-app-components-workers">
      <element xsi:type="archimate:ApplicationComponent" name="PmTracker.ServiceDesk.Contracts" id="ac-sd-contracts" documentation="Interface library - kontrakty (IStoredTicketRepository) pro integraci se ServiceDesk."/>
      <element xsi:type="archimate:ApplicationComponent" name="PmTracker.ServiceDesk.Sql (Adapter)" id="ac-sd-sql" documentation="SQL adapter - read-only dotazy nad externi ServiceDesk databazi."/>
      <element xsi:type="archimate:ApplicationComponent" name="AD Connector" id="ac-ad-connector" documentation="Wrapper nad System.DirectoryServices pro lookup uzivatelu v Active Directory."/>
      <element xsi:type="archimate:ApplicationComponent" name="Export Service (PDF/Word)" id="ac-export-service" documentation="Generuje exporty projektu/zaznamu/jednani pres DocumentFormat.OpenXml."/>
      <element xsi:type="archimate:ApplicationComponent" name="SearchReindex Worker" id="ac-search-worker" documentation="IHostedService - periodicka reindexace full-text vyhledavani (SearchReindexHostedService)."/>
      <element xsi:type="archimate:ApplicationComponent" name="PriorityMatrix Worker" id="ac-priority-worker" documentation="IHostedService - vypocet priority matrix pro dashboard cache (PriorityMatrixHostedServices)."/>
      <element xsi:type="archimate:ApplicationComponent" name="SqlStartupValidator Worker" id="ac-sql-validator" documentation="IHostedService - startup validace DB schematu a seed dat (SqlStartupValidatorHostedService)."/>
      </folder>
    </folder>
    <folder name="Services" id="folder-app-services">
      <element xsi:type="archimate:ApplicationService" name="ProjectManagement Service" id="as-project-mgmt" documentation="CRUD projektu, harmonogram, sprava tymu a subsystemu v projektu."/>
      <element xsi:type="archimate:ApplicationService" name="RecordManagement Service" id="as-record-mgmt" documentation="CRUD zaznamu, scheduling, navrhy uprav, koment subsystemu."/>
      <element xsi:type="archimate:ApplicationService" name="MeetingManagement Service" id="as-meeting-mgmt" documentation="CRUD jednani, ucast, workflow otevrene/uzavrene, vazby na zaznamy."/>
      <element xsi:type="archimate:ApplicationService" name="PeopleDirectory Service" id="as-people-directory" documentation="Adresar osob + lookup v AD, onboarding."/>
      <element xsi:type="archimate:ApplicationService" name="RoleManagement Service" id="as-role-mgmt" documentation="Sprava AuthzRole, AuthzPermission, RoleScope; permission evaluation."/>
      <element xsi:type="archimate:ApplicationService" name="ReferenceData Service" id="as-reference-data" documentation="Sprava ciselniku (referencnich dat)."/>
      <element xsi:type="archimate:ApplicationService" name="TenderManagement Service" id="as-tender-mgmt" documentation="Sprava vyzev (Vyzvy)."/>
      <element xsi:type="archimate:ApplicationService" name="ExportReporting Service" id="as-export-reporting" documentation="Exporty projektu/zaznamu/jednani do PDF/Word (OpenXml)."/>
      <element xsi:type="archimate:ApplicationService" name="Dashboard Service" id="as-dashboard" documentation="Prehledove dashboardy, priority matrix."/>
      <element xsi:type="archimate:ApplicationService" name="InApp Documentation Service" id="as-docs" documentation="In-app dokumentace renderovana z markdown souboru."/>
      <element xsi:type="archimate:ApplicationService" name="Authentication Service" id="as-authentication" documentation="Autentizace pres Windows Auth + mapping na internal user."/>
      <element xsi:type="archimate:ApplicationService" name="SearchIndexing Service" id="as-search-indexing" documentation="Full-text vyhledavani napric projekty/zaznamy/jednanimi."/>
      <element xsi:type="archimate:ApplicationService" name="ServiceDesk Integration Service" id="as-sd-integration" documentation="Integrace se ServiceDesk - read-only ticket lookup."/>
      <element xsi:type="archimate:ApplicationService" name="AD User Lookup Service" id="as-ad-lookup" documentation="Vyhledavani uzivatelu v Active Directory."/>
    </folder>
    <folder name="Functions" id="folder-app-functions">
      <element xsi:type="archimate:ApplicationFunction" name="Project Lifecycle" id="af-project-lifecycle" documentation="Interni logika zivotniho cyklu projektu."/>
      <element xsi:type="archimate:ApplicationFunction" name="Record Scheduling" id="af-record-scheduling" documentation="Logika harmonogramu zaznamu - planovany vs skutecny."/>
      <element xsi:type="archimate:ApplicationFunction" name="Meeting Workflow" id="af-meeting-workflow" documentation="Logika prechodu mezi stavy jednani."/>
      <element xsi:type="archimate:ApplicationFunction" name="Permission Evaluation" id="af-permission-eval" documentation="Vyhodnoceni opravneni podle role + scope."/>
      <element xsi:type="archimate:ApplicationFunction" name="Full-Text Indexing" id="af-fulltext-indexing" documentation="Logika plneni a obnovovani vyhledavaciho indexu."/>
      <element xsi:type="archimate:ApplicationFunction" name="Priority Matrix Computation" id="af-priority-matrix" documentation="Vypocet priority matrix - dashboard cache."/>
      <element xsi:type="archimate:ApplicationFunction" name="Document Export (OpenXml)" id="af-document-export" documentation="Generovani DOCX/XLSX dokumentu."/>
      <element xsi:type="archimate:ApplicationFunction" name="AD User Resolution" id="af-ad-resolution" documentation="Resolve AD userName na internal Person."/>
    </folder>
    <folder name="Data Objects" id="folder-app-data">
      <element xsi:type="archimate:DataObject" name="Project" id="do-project" documentation="Entita projektu - nazev, metadata, stav, harmonogram."/>
      <element xsi:type="archimate:DataObject" name="Record (Zaznam)" id="do-record" documentation="Entita zaznamu/ukolu - planovany termin, priorita, stav."/>
      <element xsi:type="archimate:DataObject" name="Meeting (Jednani)" id="do-meeting" documentation="Entita jednani - datum, ucast, stav, zapis."/>
      <element xsi:type="archimate:DataObject" name="Person" id="do-person" documentation="Entita osoby (interni i externi; AD zdroj)."/>
      <element xsi:type="archimate:DataObject" name="Team Member" id="do-team-member" documentation="Clenstvi osoby v tymu projektu s konkretni roli."/>
      <element xsi:type="archimate:DataObject" name="AuthzRole" id="do-authz-role" documentation="Rolova definice (authz.role) s Kod, Scope discriminator."/>
      <element xsi:type="archimate:DataObject" name="AuthzPermission" id="do-authz-permission" documentation="Permission key + role mapping (authz.permission, authz.role_permission)."/>
      <element xsi:type="archimate:DataObject" name="Ciselnik (lookup)" id="do-ciselnik" documentation="Referencni data - ciselnik_roli_*, stavy, kategorie."/>
      <element xsi:type="archimate:DataObject" name="Vyzva (Tender)" id="do-vyzva" documentation="Entita vyzvy - typ, stav, datum, vazba na projekt."/>
      <element xsi:type="archimate:DataObject" name="AuditLog" id="do-audit-log" documentation="Auditni log zmen (kdo, kdy, co)."/>
    </folder>
  </folder>
  <folder name="Technology &amp; Physical" id="folder-technology" type="technology">
    <folder name="Nodes" id="folder-tech-nodes">
      <element xsi:type="archimate:Node" name="IIS Web Server" id="tn-web-server" documentation="Windows Server + IIS hostujici PmTracker.Web (.NET 8)."/>
      <element xsi:type="archimate:Node" name="SQL Server (PmTracker DB)" id="tn-db-server" documentation="Hlavni databaze PM Tracker - projekty, zaznamy, jednani, authz."/>
      <element xsi:type="archimate:Node" name="SQL Server (ServiceDesk DB) - read-only" id="tn-sd-db" documentation="Externi SD databaze, PM Tracker cte read-only pro Ticketing integraci."/>
      <element xsi:type="archimate:Node" name="Active Directory Server" id="tn-ad-server" documentation="Domain Controller pro Windows Auth a user lookup."/>
      <element xsi:type="archimate:Node" name="Klientsky prohlizec" id="tn-client" documentation="End-user browser (Chrome/Edge/Firefox) pres Windows Auth + gov-design-system web components."/>
    </folder>
    <folder name="System Software" id="folder-tech-sw">
      <element xsi:type="archimate:SystemSoftware" name="IIS" id="ss-iis" documentation="Internet Information Services - hosting webove aplikace."/>
      <element xsi:type="archimate:SystemSoftware" name=".NET 8 Runtime" id="ss-dotnet" documentation="ASP.NET Core 8 runtime."/>
      <element xsi:type="archimate:SystemSoftware" name="SQL Server 2019+" id="ss-sqlserver" documentation="Microsoft SQL Server - persistence."/>
      <element xsi:type="archimate:SystemSoftware" name="Windows Authentication" id="ss-windows-auth" documentation="Kerberos/NTLM autentizace pres IIS."/>
      <element xsi:type="archimate:SystemSoftware" name="Active Directory" id="ss-ad" documentation="Domain Services - uzivatele, skupiny."/>
      <element xsi:type="archimate:SystemSoftware" name="EF Core 8" id="ss-efcore" documentation="Entity Framework Core - ORM pro SQL Server."/>
    </folder>
    <folder name="Services" id="folder-tech-services">
      <element xsi:type="archimate:TechnologyService" name="Web Hosting (HTTPS)" id="tsvc-web-hosting" documentation="HTTPS hosting sluzba na IIS."/>
      <element xsi:type="archimate:TechnologyService" name="SQL Database Service" id="tsvc-sql-db" documentation="SQL Server databazova sluzba."/>
      <element xsi:type="archimate:TechnologyService" name="AD Authentication Service" id="tsvc-ad-auth" documentation="Active Directory authentication a directory lookup."/>
      <element xsi:type="archimate:TechnologyService" name="ServiceDesk Read-Only DB" id="tsvc-sd-readonly" documentation="Read-only pristup k ServiceDesk databazi."/>
    </folder>
  </folder>
