{
  "ConnectionStrings": {
    "PmTrackerDb": "Server=SQLSERVER01;Database=PmTracker;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True",
    "TicketingReadOnly": "Server=<SD_SQL_HOST>\\<INSTANCE>;Database=intranetNEW;User Id=<READONLY_USER>;Password=<PASSWORD>;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;ApplicationIntent=ReadOnly"
  },
  "Ticketing": {
    "Enabled": false,
    "ConnectionStringName": "TicketingReadOnly",
    "CommandTimeoutSeconds": 30,
    "_comment": "Enabled=false → DI vrací Disabled*QueryService fallbacky (prázdné výsledky, null). Pro zapnutí SD integrace: naplň ConnectionStrings.TicketingReadOnly MS SQL connection stringem k intranetNEW (db_datareader grant stačí) a přepni Enabled na true. ApplicationIntent=ReadOnly je měkký guard — tvrdý guard je v TicketingReadOnlyDbContext.SaveChanges() který hází InvalidOperationException."
  },
  "PmTracker": {
    "Data": {
      "Provider": "SqlServer",
      "SqlServer": {
        "ConnectionStringName": "PmTrackerDb",
        "CommandTimeoutSeconds": 60
      }
    },
    "ActiveDirectory": {
      "Domain": "acr",
      "MaxResults": 15,
      "QueryTimeoutSeconds": 8
    },
    "DashboardPriority": {
      "PriorityHorizonDays": 30,
      "PriorityOverdueCapDays": 30,
      "PriorityNightlyRebuildTime": "02:00",
      "BootstrapFullRebuildOnStartup": true
    },
    "Search": {
      "Enabled": true,
      "Provider": "SqlServer",
      "Uri": "http://localhost:9200",
      "Username": "",
      "Password": "",
      "IndexName": "pmtracker-search-v1",
      "ReindexIntervalSeconds": 30,
      "PostFilterCandidateMultiplier": 3,
      "Embeddings": {
        "Enabled": false,
        "Provider": "None",
        "Endpoint": "",
        "ApiKey": "",
        "Model": "text-embedding-3-small",
        "Dimensions": 384
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
