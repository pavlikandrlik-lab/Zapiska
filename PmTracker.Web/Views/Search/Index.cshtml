@model PmTracker.Web.Models.ViewModels.Search.SearchPageViewModel
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Query)
        ? "Vyhledávání"
        : $"Vyhledávání: {Model.Query}";
    ViewData["BodyClass"] = "dashboard-page";
}

@* Prozatímní stránka výsledků. Task 8 ji nahradí šablonou podle gov Design systému. *@
<gov-container id="main">
    <h1>Výsledky vyhledávání</h1>

    @if (string.IsNullOrWhiteSpace(Model.Query))
    {
        <gov-message color="primary"><p>Zadejte hledaný výraz.</p></gov-message>
    }
    else if (Model.Result.TotalCount == 0)
    {
        <gov-message color="primary"><p>Pro „@Model.Query" se nic nenašlo.</p></gov-message>
    }
    else
    {
        @foreach (var category in Model.Result.Categories)
        {
            <section>
                <h2>@category.Nazev</h2>
                <ul>
                    @foreach (var item in category.Items)
                    {
                        <li>
                            <a href="@item.DetailUrl">@item.Nazev</a>
                            @if (!string.IsNullOrEmpty(item.SubsystemKod))
                            {
                                <span>@item.SubsystemKod</span>
                            }
                        </li>
                    }
                </ul>
            </section>
        }
    }
</gov-container>
