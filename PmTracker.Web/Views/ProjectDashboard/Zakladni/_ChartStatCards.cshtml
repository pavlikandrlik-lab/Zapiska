@model PmTracker.Web.Services.ProjectDashboard.Zakladni.ChartData
@* Malé karty uvnitř karty grafu — stejné dlaždice jako KPI řada, jen bez stavu a trendu. *@
<div class="pd-kpis pd-kpis--inner">
    @foreach (var s in Model.Stats)
    {
        <div class="pd-kpi">
            <div class="pd-kpi__label">@s.Label</div>
            <div class="pd-kpi__value"><span>@s.Value</span></div>
            @if (!string.IsNullOrWhiteSpace(s.Note))
            {
                <div class="pd-kpi__note">@s.Note</div>
            }
        </div>
    }
</div>
