@model ProjectDashboardPageViewModel
@{
    ViewData["Title"] = $"Dashboard – {Model.Projekt.Zkratka}";
    ViewData["BodyClass"] = "dashboard-page";

    var user = Model.CurrentUserContext;
    var projektId = Model.Projekt.Id;

    // Záložky jen podle oprávnění — panel bez práva by skončil chybou 403 (spec 2026-10-15 §14).
    var tabs = new List<(string Key, string Label, string Panel, string Url)>();
    if (user.HasPermission(PermissionKeys.DashboardRecordsView, projektId)) tabs.Add(("zaznamy", "Záznamy", "records", Model.RecordsPanelUrl));
    if (user.HasPermission(PermissionKeys.DashboardNesView, projektId)) tabs.Add(("nes", "NES v prodlení", "nes", Model.NesPanelUrl));
    if (user.HasPermission(PermissionKeys.DashboardStatisticsView, projektId)) tabs.Add(("statistiky", "Statistiky", "statistics", Model.StatisticsPanelUrl));

    // ?dashTab= přebije uložený stav pm-tabs — JS ho po inicializaci nastaví (pm-tabs dává storage přednost před initial).
    var forceTab = tabs.Any(t => t.Key == Model.ActiveTab) ? Model.ActiveTab : null;
    var initialTab = forceTab ?? tabs.FirstOrDefault().Key;

    string TabTagFor(int index, int total) =>
        total == 1 ? "pm-tab-left"
        : index == 0 ? "pm-tab-left"
        : index == total - 1 ? "pm-tab-right"
        : "pm-tab";
}

<section class="pd-shell" data-project-dashboard-shell data-project-id="@projektId" data-dashboard-force-tab="@forceTab">
    <header class="pd-header">
        <div class="pd-header__main">
            <h1 class="pd-header__title">Dashboard – @Model.Projekt.Nazev</h1>
            <div class="pd-header__meta">
                <gov-tag size="s" color="neutral">@Model.Projekt.Stav</gov-tag>
                @if (!string.IsNullOrWhiteSpace(Model.IsZkratka))
                {
                    <span class="pd-chip" data-dashboard-is-chip>IS @Model.IsZkratka</span>
                }
                else
                {
                    <a class="pd-chip pd-chip--muted" href="@Model.NastaveniIsUrl" data-dashboard-is-chip>Bez napojení na IS</a>
                }
            </div>
        </div>
        <pm-button variant="Ghost" size="Small" href="@Model.BackUrl">Zpět na projekt</pm-button>
    </header>

    <div class="pd-souhrn" data-dashboard-souhrn data-url="@Model.SouhrnUrl" aria-live="polite">
        @for (var i = 0; i < 4; i++)
        {
            <div class="pd-tile pd-tile--skeleton" aria-hidden="true">
                <span class="pd-tile__skeleton-number"></span>
                <span class="pd-tile__skeleton-label"></span>
            </div>
        }
    </div>

    @if (tabs.Count == 0)
    {
        <p class="pd-empty-note">Pro tento projekt nemáte přístup k žádné záložce dashboardu.</p>
    }
    else
    {
        <pm-tabs persist="storage" persist-key="dashboard-@projektId" initial="@initialTab" data-dashboard-tabs>
            <pm-tab-list>
                @for (var i = 0; i < tabs.Count; i++)
                {
                    var tagName = TabTagFor(i, tabs.Count);
                    @Html.Raw($"<{tagName} key=\"{tabs[i].Key}\">{System.Net.WebUtility.HtmlEncode(tabs[i].Label)}</{tagName}>")
                }
            </pm-tab-list>

            @foreach (var tab in tabs)
            {
                <pm-tab-panel key="@tab.Key" class="pd-panel" data-dashboard-panel="@tab.Panel" data-dashboard-panel-url="@tab.Url">
                    <div class="pd-panel__placeholder" data-dashboard-panel-placeholder aria-hidden="true">
                        <div class="record-loading-line"></div>
                        <div class="record-loading-line short"></div>
                        <div class="record-loading-line"></div>
                    </div>
                    <div data-dashboard-panel-content></div>
                </pm-tab-panel>
            }
        </pm-tabs>
    }
</section>
