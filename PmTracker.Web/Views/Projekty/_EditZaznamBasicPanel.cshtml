@using System.Globalization
@model ZaznamEditViewModel
@inject PmTracker.Web.Services.Common.IRichTextContentService RichTextContentService
@{
    var selectedOwnerLabel = Model.Vlastnici
        .FirstOrDefault(x => string.Equals(x.Value, Model.VlastnikId.ToString(), StringComparison.Ordinal))?.Label ?? string.Empty;
    var metadataLocked = !Model.AllowBasicMetadataEdit;
    var datumZalozeniLocked = metadataLocked || Model.IsSchedulePlanProposalEditor;
    var terminUkonceniIso = Model.TerminUkonceni?.ToString("yyyy-MM-dd") ?? string.Empty;
    var terminUkonceniDisplay = Model.TerminUkonceni?.ToString("dd.MM.yyyy") ?? string.Empty;
    var terminUkonceniLocked = !Model.AllowTermDeadlineEdit || (Model.HasPendingScheduleProposalLock && Model.PendingScheduleProposalLocksTermDeadline);
    var terminUkonceniChanged = Model.IsProposalFieldChanged("TerminUkonceni");
    var terminUkonceniTooltip = Model.GetProposalFieldTooltip("TerminUkonceni");
    var showTaskType = !string.IsNullOrWhiteSpace(Model.Kategorie)
        && (Model.Kategorie.Contains("úkol", StringComparison.OrdinalIgnoreCase)
            || Model.Kategorie.Contains("ukol", StringComparison.OrdinalIgnoreCase));
    var safeDescriptionHtml = RichTextContentService.ToSafeHtml(Model.Popis);

    // Hodnota, kterou by odeslal <select name="Subsystem"> (value = Kod, jinak Nazev) —
    // přesně podle option-value logiky níže. Použito pro hidden carrier při zámku metadat.
    var subsystemSelectedOption = Model.Subsystemy.FirstOrDefault(s =>
        string.Equals(s.Kod, Model.Subsystem, StringComparison.Ordinal)
        || string.Equals(s.Nazev, Model.Subsystem, StringComparison.Ordinal));
    var subsystemSubmitValue = subsystemSelectedOption is null
        ? Model.Subsystem
        : (string.IsNullOrWhiteSpace(subsystemSelectedOption.Kod) ? subsystemSelectedOption.Nazev : subsystemSelectedOption.Kod);
}

<pm-tab-panel key="basic" class="record-modal-panel" data-record-modal-panel="basic">
    <div class="record-form-row record-form-row-top" data-record-row-top data-has-type="@(showTaskType ? "true" : "false")">
        <label for="kategorie">
            Kategorie záznamu
            <select id="kategorie" name="Kategorie" data-kategorie-select @(metadataLocked ? "disabled=\"disabled\"" : null)>
                @foreach (var kategorie in Model.KategorieZaznamu)
                {
                    if (kategorie == Model.Kategorie)
                    {
                        <option selected="selected">@kategorie</option>
                    }
                    else
                    {
                        <option>@kategorie</option>
                    }
                }
            </select>
        </label>
        @*
            7d (2026-06-17): Typ úkolu je editovatelný i v NÁVRHU ZALOŽENÍ (a klasickém editoru),
            pokud je kategorie úkol — reverze rozhodnutí z 2026-04-19. Zamčení řídí jen
            `metadataLocked` (= !AllowBasicMetadataEdit): návrh ZMĚNY harmonogramu má basic pole
            zamčená (metadataLocked=true → typ zamčený), návrh založení/klasik nikoli.
            JS (recordEditor/form.js) drží stejnou logiku při změně kategorie.
        *@
        <label class="record-form-type-row" for="typ-ukolu" data-typ-ukolu-row>
            Typ úkolu
            <select id="typ-ukolu" name="TypUkolu" @(metadataLocked ? "disabled=\"disabled\"" : null)>
                <option value="">-</option>
                @foreach (var typ in Model.TypyUkolu)
                {
                    if (typ == Model.TypUkolu)
                    {
                        <option selected="selected">@typ</option>
                    }
                    else
                    {
                        <option>@typ</option>
                    }
                }
            </select>
        </label>
        <label for="stav">
            Stav úkolu
            <select id="stav" name="Stav" @(metadataLocked ? "disabled=\"disabled\"" : null)>
                @foreach (var stav in Model.StavyUkolu)
                {
                    if (stav == Model.Stav)
                    {
                        <option selected="selected">@stav</option>
                    }
                    else
                    {
                        <option>@stav</option>
                    }
                }
            </select>
        </label>
        <label class="record-form-number" for="cislo">
            Číslo
            <input id="cislo" type="text" value="@Model.CisloViditelne" disabled="disabled" />
        </label>
    </div>

    @if (Model.IsCreate && Model.PouzivatIdentJednani)
    {
        <div class="record-form-row">
            <label for="jednani-id-pro-cislo">
                Jednání pro identifikátor
                <select id="jednani-id-pro-cislo" name="JednaniIdProCislo"
                        data-record-meeting-number-select="true"
                        required="required"
                        @((Model.MaDostupneJednaniProCislo && !metadataLocked) ? null : "disabled=\"disabled\"")>
                    <option value="">Vyberte jednání</option>
                    @foreach (var meeting in Model.JednaniProCisloOptions)
                    {
                        var selected = Model.JednaniIdProCislo.HasValue && Model.JednaniIdProCislo.Value == meeting.Id;
                        <option value="@meeting.Id"
                                data-record-meeting-date="@meeting.Datum.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                                selected="@selected">
                            @meeting.Label
                        </option>
                    }
                </select>
            </label>
        </div>
        @if (!Model.MaDostupneJednaniProCislo)
        {
            <gov-message color="error">
                Není dostupné žádné neuzavřené jednání. Založení záznamu je zablokováno.
            </gov-message>
        }
    }
    else if (!Model.IsCreate && Model.MuzeDoplnitIdentifikatorJednani)
    {
        <div class="record-form-row">
            <div class="record-identifier-assign">
                <span class="muted">Tento záznam má ještě původní inkrementální číslo. Identifikátor z jednání lze doplnit jednorázově.</span>
                <pm-button variant="Secondary"
                           size="Small"
                           data-modal-url="@Url.Action("AssignMeetingIdentifierModal", "Zaznamy", new { projektId = Model.ProjektId, zaznamId = Model.Id })">
                    Doplnit identifikátor z jednání
                </pm-button>
            </div>
        </div>
    }

    <div class="record-form-row record-form-row-title">
        <label for="nazev">
            Název
            <input id="nazev" type="text" name="Nazev" value="@Model.Nazev" @(metadataLocked ? "disabled=\"disabled\"" : null) />
        </label>
    </div>

    <div class="record-form-row record-form-row-title">
        <label for="cil">
            Cíl (volitelné)
            <textarea id="cil"
                      class="record-goal-textarea"
                      rows="1"
                      name="Cil"
                      maxlength="500"
                      data-record-goal-autogrow="true"
                      @(metadataLocked ? "disabled=\"disabled\"" : null)>@Model.Cil</textarea>
        </label>
    </div>

    <div class="record-form-row">
        <label for="popis">
            Popis (volitelné)
            <textarea id="popis"
                      class="record-description-textarea"
                      rows="3"
                      name="Popis"
                      data-rich-text="true"
                      data-rich-text-min-height="96"
                      @(metadataLocked ? "disabled=\"disabled\"" : null)>@safeDescriptionHtml</textarea>
        </label>
    </div>

    <div class="record-form-row record-form-row-dates">
        <label>
            Datum založení
            @await Html.PartialAsync(
                "_AppDateField",
                new AppDateFieldViewModel
                {
                    Name = "DatumZalozeni",
                    IsoValue = Model.DatumZalozeni.ToString("yyyy-MM-dd"),
                    DisplayValue = Model.DatumZalozeni.ToString("dd.MM.yyyy"),
                    Locked = datumZalozeniLocked,
                    AriaLabel = "Otevřít kalendář"
                })
        </label>
        @{
            var terminUkonceniEditableHighlight = Model.IsSchedulePlanProposalEditor && !terminUkonceniLocked;
            var terminUkonceniClasses = string.Join(' ', new[]
            {
                terminUkonceniChanged ? "proposal-field-changed" : null,
                terminUkonceniEditableHighlight ? "proposal-field-editable" : null
            }.Where(c => !string.IsNullOrEmpty(c)));
        }
        <label class="@terminUkonceniClasses"
               title="@terminUkonceniTooltip">
            Termín ukončení
            @await Html.PartialAsync(
                "_AppDateField",
                new AppDateFieldViewModel
                {
                    Name = "TerminUkonceni",
                    IsoValue = terminUkonceniIso,
                    DisplayValue = terminUkonceniDisplay,
                    Locked = terminUkonceniLocked,
                    AriaLabel = "Otevřít kalendář",
                    ContainerCssClass = string.Join(' ', new[]
                    {
                        terminUkonceniChanged ? "proposal-field-changed" : null,
                        terminUkonceniEditableHighlight ? "proposal-field-editable" : null
                    }.Where(c => !string.IsNullOrEmpty(c)))
                })
        </label>
    </div>

    <div class="record-form-row record-form-row-owner">
        <label for="subsystem">
            Subsystém
            <select id="subsystem" name="Subsystem" data-record-subsystem-select @(metadataLocked ? "disabled=\"disabled\"" : null)>
                @foreach (var subsystem in Model.Subsystemy)
                {
                    var subsystemValue = string.IsNullOrWhiteSpace(subsystem.Kod)
                        ? subsystem.Nazev
                        : subsystem.Kod;
                    var optionLabel = string.IsNullOrWhiteSpace(subsystem.Kod)
                        ? subsystem.Nazev
                        : $"{subsystem.Kod} - {subsystem.Nazev}";
                    var defaultOwnerIdAttribute = subsystem.DefaultOwnerOsobaId > 0
                        ? subsystem.DefaultOwnerOsobaId.ToString(CultureInfo.InvariantCulture)
                        : string.Empty;
                    var isSelected = string.Equals(subsystem.Nazev, Model.Subsystem, StringComparison.Ordinal)
                        || string.Equals(subsystem.Kod, Model.Subsystem, StringComparison.Ordinal);
                    if (isSelected)
                    {
                        <option value="@subsystemValue" data-owner-id="@defaultOwnerIdAttribute" selected="selected">@optionLabel</option>
                    }
                    else
                    {
                        <option value="@subsystemValue" data-owner-id="@defaultOwnerIdAttribute">@optionLabel</option>
                    }
                }
            </select>
        </label>
        <label>
            Vlastník
            <div class="office-picker"
                 data-person-picker="single"
                 data-record-owner-picker
                 data-person-picker-placeholder="Vyhledejte vlastníka podle jména nebo emailu..."
                 data-picker-locked="@(metadataLocked ? "true" : "false")"
                 data-person-picker-empty="Nenalezeny odpovídající osoby.">
                <input type="hidden" name="VlastnikId" value="@Model.VlastnikId" data-person-picker-hidden required />
                <div class="office-searchbox" data-floating-anchor>
                    <input type="search" value="@selectedOwnerLabel" autocomplete="off" data-person-picker-input required @(metadataLocked ? "disabled=\"disabled\"" : null) />
                    <div class="office-search-panel" data-person-picker-panel hidden>
                        <div class="office-search-results" data-person-picker-results role="listbox" aria-label="Výsledky osob"></div>
                    </div>
                </div>
                <div class="person-picker-source" data-person-picker-source hidden>
                    @foreach (var osoba in Model.DostupniVlastnici)
                    {
                        <div data-id="@osoba.OsobaId"
                             data-label="@osoba.Osoba"
                             data-email="@(osoba.Email ?? string.Empty)"
                             data-org="@(osoba.Organizace ?? string.Empty)"
                             data-unit="@(osoba.OrganizacniCelek ?? string.Empty)"></div>
                    }
                </div>
            </div>
        </label>
    </div>

    @if (metadataLocked)
    {
        @* Zamčená metadata (návrh ZMĚNY termínu a harmonogramu): disabled <select>/<input> se
           s formulářem NEodesílají, ale SaveRecordCommand má Kategorie/Stav/Nazev/Subsystem
           [Required]. Bez hidden carrierů spadne POST /Navrhy/SubmitScheduleProposal na
           REQUEST_VALIDATION_FAILED. Hodnoty server u návrhu harmonogramu ignoruje (načítá
           záznam z DB), ale sdílený příkaz musí projít model validací. Stejný princip jako
           hidden VlastnikId a _AppDateField locked. Regrese opravena 2026-06-29. *@
        <input type="hidden" name="Kategorie" value="@Model.Kategorie" data-locked-metadata-hidden />
        <input type="hidden" name="Stav" value="@Model.Stav" data-locked-metadata-hidden />
        <input type="hidden" name="Nazev" value="@Model.Nazev" data-locked-metadata-hidden />
        <input type="hidden" name="Subsystem" value="@subsystemSubmitValue" data-locked-metadata-hidden />
    }
</pm-tab-panel>
