@model ProjektHarmonogramTabViewModel
@{
    var isActive = ViewData["IsActive"] as bool? ?? false;
}

<section class="tab-panel @(isActive ? "active" : null)" data-tab-panel="harmonogram">
    <div class="filter-shell"
         data-project-filter-scope="schedule"
         data-project-id="@Model.ProjektId"
         data-current-user-id="@Model.CurrentUserOsobaId">
        <button class="filter-toggle" type="button" data-schedule-filter-toggle>
            Filtry
            <span class="filter-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 5h18l-7 8v5l-4 2v-7L3 5z"></path>
                </svg>
            </span>
        </button>
        <div class="active-filter-row" data-filter-chip-row="schedule" hidden="hidden"></div>
        <div class="filter-panel collapsed" data-schedule-filter-panel>
            <div class="filter-grid">
                <label>
                    Subsystém
                    <select data-schedule-filter-key="subsystem">
                        <option value="">Vše</option>
                        @foreach (var item in Model.SubsystemyMoznosti)
                        {
                            <option value="@item.Value">@item.Label</option>
                        }
                    </select>
                </label>
                <label>
                    Řadit podle
                    <select data-schedule-filter-key="sortBy">
                        <option value="project-asc" selected="selected">podle pořadí projektu vzestupně</option>
                        <option value="project-desc">podle pořadí projektu sestupně</option>
                        <option value="alpha-asc">abecedně vzestupně (A-Z)</option>
                        <option value="alpha-desc">abecedně sestupně (Z-A)</option>
                    </select>
                </label>
            </div>
            <div class="filter-actions">
                <button class="btn small ghost" type="button" data-filter-save-defaults="schedule">Uložit jako výchozí</button>
                <span class="filter-save-status" data-filter-save-status="schedule" aria-live="polite"></span>
            </div>
        </div>
    </div>

    <div class="schedule-project-list" data-project-schedule-list data-subsystem-grouped-shell>
        @if (Model.HarmonogramUkoly.Count == 0)
        {
            <p class="muted">V projektu zatím nejsou záznamy s harmonogramem.</p>
        }
        else
        {
            @foreach (var skupina in Model.HarmonogramUkoly
                .GroupBy(item => new { item.SubsystemKod, item.Subsystem })
                .OrderByDescending(group => group.First().SubsystemHasProjectOrder)
                .ThenBy(group => group.First().SubsystemPoradi)
                .ThenBy(group => group.Key.Subsystem))
            {
                var firstItem = skupina.First();
                <section class="schedule-subsystem-group"
                         data-subsystem-group
                         data-subsystem-name="@skupina.Key.Subsystem"
                         data-subsystem-kod="@skupina.Key.SubsystemKod"
                         data-subsystem-order="@firstItem.SubsystemPoradi"
                         data-subsystem-order-active="@firstItem.SubsystemHasProjectOrder.ToString().ToLowerInvariant()">
                    <h3 class="schedule-subsystem-heading">@skupina.Key.Subsystem</h3>
                    <div class="schedule-group-list">
                        @foreach (var item in skupina)
                        {
                            <article class="schedule-card"
                                     data-schedule-item
                                     data-schedule-filter-subsystem="@item.Subsystem"
                                     data-schedule-filter-subsystem-kod="@item.SubsystemKod"
                                     data-schedule-subsystem-order="@item.SubsystemPoradi"
                                     data-schedule-subsystem-order-active="@item.SubsystemHasProjectOrder.ToString().ToLowerInvariant()">
                                <div class="schedule-card-header">
                                    <div>
                                        <div class="record-title">#@item.CisloViditelne - @item.Nazev</div>
                                        <div class="record-summary-meta">
                                            <span><span class="label">Stav úkolu:</span> @item.Stav</span>
                                            <span><span class="label">Typ:</span> @(string.IsNullOrWhiteSpace(item.TypUkolu) ? "-" : item.TypUkolu)</span>
                                            <span><span class="label">Subsystém:</span> @item.Subsystem</span>
                                            <span><span class="label">Vlastník:</span> @item.Vlastnik</span>
                                        </div>
                                    </div>
                                    <div class="schedule-card-actions">
                                        <span class="badge @(item.Stihame ? "schedule-badge-ok" : "schedule-badge-late")">@(item.Stihame ? "Stíháme" : "Nestíháme")</span>
                                        <button class="btn small ghost"
                                                type="button"
                                                data-schedule-expand-toggle
                                                data-schedule-record-id="@item.ZaznamId"
                                                aria-expanded="false">Rozpad</button>
                                        @if (item.CanManageSchedule)
                                        {
                                            <button class="btn small"
                                                    type="button"
                                                    data-record-editor-url="@item.ScheduleEditUrl"
                                                    data-record-editor-project-id="@Model.ProjektId"
                                                    data-record-editor-label="@($"Upravit záznam #{item.CisloViditelne}")">
                                                Upravit
                                            </button>
                                        }
                                    </div>
                                </div>

                                @await Html.PartialAsync("_ScheduleBlock", item.HarmonogramBlok)

                                @* F-05: Placeholder pro záznamy bez zadaného harmonogramu *@
                                @if (item.HarmonogramBlok.Souhrn.CelkoveTrvaniDni == 0)
                                {
                                    <p class="muted" style="font-size:12px;margin:4px 0 0;">Záznam zatím nemá zadány kroky harmonogramu. Upravte harmonogram v detailu záznamu.</p>
                                }
                            </article>
                        }
                    </div>
                </section>
            }
        }
    </div>
</section>
