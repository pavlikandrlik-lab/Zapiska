@model ZaznamCommentsPanelViewModel
@inject PmTracker.Web.Services.Common.IRichTextContentService RichTextContentService

<div class="record-comments"
     data-record-comments-panel
     data-record-comments-scope="@Model.ZaznamId"
     data-record-comments-loaded-count="@Model.LoadedCount"
     data-record-comments-total-count="@Model.TotalCount"
     data-record-comments-load-step="@Model.LoadStep"
     data-record-comments-is-fully-loaded="@Model.IsFullyLoaded.ToString().ToLowerInvariant()"
     data-comment-sort-section
     data-comment-sort-direction="asc">
    <div class="record-comments-header">
        <h4>Vyjádření</h4>
        @if (Model.Vyjadreni.Count > 1)
        {
            <pm-button variant="Secondary" size="Small" class="comment-sort-toggle" data-comment-sort-toggle="true">
                <span data-comment-sort-label="asc">Řazení: jednání vzestupně</span>
                <span data-comment-sort-label="desc" hidden>Řazení: jednání sestupně</span>
            </pm-button>
        }
    </div>
    @if (Model.Vyjadreni.Count == 0)
    {
        <p class="muted">Zatím bez vyjádření.</p>
    }
    else
    {
        <div class="comment-list" data-comment-list>
            @foreach (var vyjadreni in Model.Vyjadreni)
            {
                var canEditThisComment = vyjadreni.LzeUpravit
                    && (Model.CanEditRecord
                        || (vyjadreni.CanEditOwnAsSubsystemLeader && vyjadreni.AutorOsobaId == Model.CurrentUserOsobaId));
                <div class="comment"
                     data-comment-item
                     data-comment-meeting="@(vyjadreni.JednaniCislo ?? 0)"
                     data-comment-date="@vyjadreni.Datum.ToString("O")"
                     data-comment-id="@vyjadreni.Id">
                    @*
                        Layout 2026-04-19 večer (redesign):
                        - .comment-meta = horní řádek, meta-info zarovnaný VPRAVO (user preference)
                        - .comment-text = uprostřed, full-width
                        - .comment-edit-form = skrytý form pod textem, plná šířka pro Quill
                        - .comment-actions = spodní řádek, Upravit + Smazat stejná velikost (oba Secondary/Destructive pm-button)
                        Žádná horizontální dashed čára — meta není border-separated, user: "vypadá to hrozně".
                    *@
                    <div class="comment-meta">
                        <div class="comment-meta-info">
                            <span class="comment-author">@vyjadreni.Autor</span>
                            <span class="comment-sep" aria-hidden="true">·</span>
                            <time class="comment-date" datetime="@vyjadreni.Datum.ToString("O")">@vyjadreni.Datum.ToString("dd.MM.yyyy")</time>
                            @if (vyjadreni.JednaniDatum.HasValue)
                            {
                                <span class="comment-sep" aria-hidden="true">·</span>
                                <span class="comment-meeting-chip">
                                    @if (vyjadreni.JednaniCislo.HasValue)
                                    {
                                        @:Jednání č. @vyjadreni.JednaniCislo (@vyjadreni.JednaniDatum.Value.ToString("dd.MM.yyyy"))
                                    }
                                    else
                                    {
                                        @:Jednání @vyjadreni.JednaniDatum.Value.ToString("dd.MM.yyyy")
                                    }
                                </span>
                            }
                        </div>
                    </div>
                    <div class="comment-text richtext-render" data-comment-text>@Html.Raw(RichTextContentService.ToSafeHtml(vyjadreni.Text))</div>
                    @if (canEditThisComment)
                    {
                        <form class="comment-edit-form" asp-controller="Zaznamy" asp-action="UpdateComment" method="post" data-ajax-submit="true" data-comment-edit-form hidden>
                            <input type="hidden" name="projektId" value="@Model.ProjektId" />
                            <input type="hidden" name="uiContext" value="project" />
                            <input type="hidden" name="zaznamId" value="@Model.ZaznamId" />
                            <input type="hidden" name="Id" value="@vyjadreni.Id" />
                            <textarea rows="3"
                                      name="Text"
                                      required
                                      data-rich-text="true"
                                      data-rich-text-min-height="92">@RichTextContentService.ToSafeHtml(vyjadreni.Text)</textarea>
                            <div class="comment-edit-actions">
                                <pm-button variant="Secondary" size="Small" data-comment-edit-cancel="true">Zrušit úpravu</pm-button>
                                <pm-button variant="Primary" size="Small" native-type="submit">Uložit změnu</pm-button>
                            </div>
                        </form>
                        <div class="comment-actions">
                            <pm-button variant="Secondary" size="Small" data-comment-edit-toggle="true" aria-label="Upravit vyjádření">Upravit</pm-button>
                            <form class="comment-delete-form comment-delete-form-inline" asp-controller="Zaznamy" asp-action="DeleteComment" method="post" data-ajax-submit="true" onsubmit="return confirm('Opravdu smazat vyjádření?');">
                                <input type="hidden" name="projektId" value="@Model.ProjektId" />
                                <input type="hidden" name="uiContext" value="project" />
                                <input type="hidden" name="zaznamId" value="@Model.ZaznamId" />
                                <input type="hidden" name="Id" value="@vyjadreni.Id" />
                                <pm-button variant="Destructive" size="Small" native-type="submit" aria-label="Smazat vyjádření">Smazat</pm-button>
                            </form>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (Model.CanLoadMore || Model.CanLoadAll)
    {
        <div class="comment-pagination-actions">
            @if (Model.CanLoadMore)
            {
                <pm-button variant="Ghost"
                           size="Small"
                           data-record-comments-load-more="true"
                           data-label-desc="Další (@Model.LoadStep)"
                           data-label-asc="Zobrazit předchozí (@Model.LoadStep)"
                           title="Zobrazit dalších @Model.LoadStep vyjádření">
                    Další (@Model.LoadStep)
                </pm-button>
            }
            @if (Model.CanLoadAll)
            {
                <pm-button variant="Ghost"
                           size="Small"
                           data-record-comments-load-all="true"
                           data-label-desc="Zobrazit vše"
                           data-label-asc="Zobrazit vše"
                           title="Zobrazit všechna vyjádření">
                    Zobrazit vše
                </pm-button>
            }
        </div>
    }

    @if (Model.CanAddComment)
    {
        <form class="comment-form" asp-controller="Zaznamy" asp-action="AddComment" method="post" data-ajax-submit="true">
            <input type="hidden" name="projektId" value="@Model.ProjektId" />
            <input type="hidden" name="uiContext" value="project" />
            <input type="hidden" name="ZaznamId" value="@Model.ZaznamId" />
            <textarea rows="4"
                      name="Text"
                      placeholder="Přidat vyjádření..."
                      data-rich-text="true"
                      data-rich-text-min-height="132"></textarea>
            <div class="comment-actions">
                <select class="wide-select" name="JednaniId" required>
                    <option value="">Vazba na jednání</option>
                    @foreach (var jednani in Model.OtevrenaJednani)
                    {
                        <option value="@jednani.Id">@jednani.Label</option>
                    }
                </select>
                <pm-button variant="Primary" size="Small" native-type="submit">Uložit</pm-button>
            </div>
        </form>
    }
</div>
