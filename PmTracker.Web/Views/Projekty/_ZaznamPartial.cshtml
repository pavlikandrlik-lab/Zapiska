@model ProjektZaznamCardShellViewModel
@{
    var summary = Model.Summary;
    var colorClass = "category-" + summary.KategorieKod.ToLowerInvariant();
    var projektId = summary.ProjektId;
    var taskPrintPdfUrl = Url.Action("UkolTisk", "Export", new { zaznamId = summary.Id, projektId, autoPrint = true }) ?? $"/Export/Ukol/{summary.Id}/Tisk?projektId={projektId}&autoPrint=true";
    var taskPrintWordUrl = Url.Action("UkolWord", "Export", new { zaznamId = summary.Id, projektId }) ?? $"/Export/Ukol/{summary.Id}/Word?projektId={projektId}";
    var editRecordUrl = Url.Action("Edit", "Zaznamy", new { id = summary.Id, projektId }) ?? $"/Zaznamy/Edit/{summary.Id}";
}

<article class="record-card collapsed @colorClass"
         data-record-id="@summary.Id"
         data-record-detail-url="@Model.DetailUrl"
         data-record-comments-url="@Model.CommentsUrl"
         data-record-comments-base-url="@Model.CommentsUrl"
         data-record-detail-loaded="@(Model.DetailLoaded ? "true" : "false")"
         data-record-comments-loaded="@(Model.CommentsLoaded ? "true" : "false")"
         data-filter-subsystem="@summary.AktualniSubsystem"
         data-filter-subsystem-kod="@summary.AktualniSubsystemKod"
         data-filter-subsystem-order="@summary.AktualniSubsystemPoradi"
         data-filter-subsystem-order-active="@summary.AktualniSubsystemHasProjectOrder.ToString().ToLowerInvariant()"
         data-filter-kategorie="@summary.KategorieNazev"
         data-filter-kategorie-kod="@summary.KategorieKod"
         data-filter-stav="@summary.Stav"
         data-filter-stav-kod="@summary.StavKod"
         data-filter-typ="@(summary.TypUkolu ?? string.Empty)"
         data-filter-typ-kod="@(summary.TypUkoluKod ?? string.Empty)"
         data-filter-vlastnik="@summary.AktualniVlastnik"
         data-filter-vlastnik-id="@summary.AktualniVlastnikId"
         data-filter-aktivni="@summary.IsAktivniStav.ToString().ToLowerInvariant()"
         data-filter-je-ukol="@summary.JeUkol.ToString().ToLowerInvariant()"
         data-filter-vyjadreni-jednani-stavy="@(string.Join("|", summary.VyjadreniJednaniStavyKody))">
    <div class="record-bar" aria-hidden="true"></div>
    <div class="record-content">
        <header class="record-header" data-record-toggle aria-expanded="false">
            <div class="record-title-wrap">
                <div class="record-meta">
                    <span class="pill">@summary.KategorieNazev</span>
                    @if (!string.IsNullOrWhiteSpace(summary.TypUkolu))
                    {
                        <span class="pill ghost">@summary.TypUkolu</span>
                    }
                </div>
                <div class="record-title">#@summary.CisloViditelne - @summary.Nazev</div>
                @if (!string.IsNullOrWhiteSpace(summary.Cil))
                {
                    <div class="record-subtitle record-goal-subtitle">@summary.Cil</div>
                }
                <div class="record-summary-meta">
                    <span><span class="label">Termín:</span> @(summary.AktualniTermin?.ToString("dd.MM.yyyy") ?? "-")</span>
                    <span><span class="label">Založeno:</span> @summary.DatumZalozeni.ToString("dd.MM.yyyy")</span>
                </div>
            </div>
            <div class="record-actions">
                <span class="badge">@summary.Stav</span>
                <a class="icon-btn"
                   href="@taskPrintPdfUrl"
                   target="_blank"
                   rel="noopener"
                   aria-label="Tisk záznamu #@summary.CisloViditelne"
                   data-stop-propagation="true"
                   data-print-trigger="true"
                   data-print-pdf-url="@taskPrintPdfUrl"
                   data-print-word-url="@taskPrintWordUrl"
                   data-print-label="Tisk záznamu #@summary.CisloViditelne">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="6 9 6 2 18 2 18 9"></polyline>
                        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                        <rect x="6" y="14" width="12" height="8"></rect>
                    </svg>
                </a>
                @if (summary.CanEditRecord || summary.CanManageSchedule)
                {
                    <pm-button variant="Secondary"
                               size="Small"
                               data-record-editor-url="@editRecordUrl"
                               data-record-editor-project-id="@projektId"
                               data-record-editor-label="@($"{summary.EditButtonLabel} záznam #{summary.CisloViditelne}")"
                               data-stop-propagation="true"
                               aria-label="@summary.EditButtonLabel"
                               title="@summary.EditButtonLabel">
                        <gov-icon name="pencil" type="basic" aria-hidden="true"></gov-icon>
                    </pm-button>
                }
                @if (summary.CanCreateScheduleProposal && !string.IsNullOrWhiteSpace(summary.ScheduleProposalUrl))
                {
                    <pm-button variant="Secondary"
                               size="Small"
                               data-record-editor-url="@summary.ScheduleProposalUrl"
                               data-record-editor-project-id="@projektId"
                               data-record-editor-label="@($"Navrhnout změnu termínu a harmonogramu záznamu #{summary.CisloViditelne}")"
                               data-stop-propagation="true"
                               aria-label="Navrhnout termín a harmonogram"
                               title="Navrhnout termín a harmonogram">
                        <gov-icon name="calendar-clock" type="basic" aria-hidden="true"></gov-icon>
                    </pm-button>
                }
                <span class="record-toggle-indicator" aria-hidden="true">›</span>
            </div>
        </header>

        <div class="record-body">
            <div class="record-detail-shell" data-record-detail-shell>
                @if (Model.DetailLoaded && Model.Detail is not null)
                {
                    @await Html.PartialAsync("_ZaznamDetailPartial", Model.Detail)
                }
                else
                {
                    <div class="record-loading-placeholder" data-record-detail-placeholder hidden>
                        <div class="record-loading-line"></div>
                        <div class="record-loading-line short"></div>
                        <div class="record-loading-line"></div>
                    </div>
                    <div class="record-loading-error" data-record-detail-error hidden></div>
                }
            </div>

            <div class="record-comments-lazy"
                 data-record-comments-shell
                 data-record-comments-scope="@summary.Id"
                 data-record-comments-url="@Model.CommentsUrl"
                 data-record-comments-base-url="@Model.CommentsUrl"
                 data-record-comments-loaded="@(Model.CommentsLoaded ? "true" : "false")">
                @if (Model.CommentsLoaded && Model.Comments is not null)
                {
                    @await Html.PartialAsync("_ZaznamCommentsPartial", Model.Comments)
                }
                else
                {
                    <div class="record-comments-header compact">
                        <h4>Vyjádření</h4>
                    </div>
                    <div class="record-loading-placeholder" data-record-comments-placeholder hidden>
                        <div class="record-loading-line"></div>
                        <div class="record-loading-line short"></div>
                    </div>
                    <div class="record-loading-error" data-record-comments-error hidden></div>
                    <div data-record-comments-content></div>
                }
            </div>
        </div>
    </div>
</article>
