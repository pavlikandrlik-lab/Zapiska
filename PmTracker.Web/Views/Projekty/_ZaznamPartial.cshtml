@using System.Globalization
@model ZaznamCardViewModel
@{
    var otevrenaJednani = ViewData["OtevrenaJednani"] as IReadOnlyList<JednaniOptionViewModel> ?? Array.Empty<JednaniOptionViewModel>();
    var colorClass = "category-" + Model.KategorieKod.ToLowerInvariant();
    var userContext = ViewBag.CurrentUserContext as CurrentUserContextViewModel;
    var projektId = ViewData["ProjektId"] as int? ?? 0;
    var canEditRecord = userContext?.HasPermission(PermissionKeys.RecordsEdit, projektId) ?? false;
    var canEditSchedule = Model.JeUkol && (userContext?.HasPermission(PermissionKeys.RecordsScheduleEdit, projektId) ?? false);
    var canAddSchedule = Model.JeUkol && (userContext?.HasPermission(PermissionKeys.RecordsScheduleAdd, projektId) ?? false);
    var canManageSchedule = canEditSchedule || canAddSchedule;
    var editButtonLabel = canEditRecord ? "Upravit" : "GANTT";
    var userOsobaId = userContext?.OsobaId ?? 0;
    var hasSubsystemLeadPermission = userContext?.HasPermission(PermissionKeys.RecordsCommentSubsystemLead, projektId) ?? false;
    var isLeaderForRecord = userOsobaId > 0 && Model.AktualniSubsystemLeadEquivalentOsobaIds.Contains(userOsobaId);
    var canCommentAsSubsystemLeader = hasSubsystemLeadPermission && isLeaderForRecord;
    var canAddComment = canEditRecord || canCommentAsSubsystemLeader;
    var taskPrintPdfUrl = Url.Action("UkolTisk", "Export", new { zaznamId = Model.Id, projektId, autoPrint = true }) ?? $"/Export/Ukol/{Model.Id}/Tisk?projektId={projektId}&autoPrint=true";
    var taskPrintWordUrl = Url.Action("UkolWord", "Export", new { zaznamId = Model.Id, projektId }) ?? $"/Export/Ukol/{Model.Id}/Word?projektId={projektId}";
    var editRecordUrl = Url.Action("Edit", "Zaznamy", new { id = Model.Id, projektId }) ?? $"/Zaznamy/Edit/{Model.Id}";
}

<article class="record-card collapsed @colorClass"
         data-record-id="@Model.Id"
         data-filter-subsystem="@Model.AktualniSubsystem"
         data-filter-subsystem-kod="@Model.AktualniSubsystemKod"
         data-filter-kategorie="@Model.KategorieNazev"
         data-filter-kategorie-kod="@Model.KategorieKod"
         data-filter-stav="@Model.Stav"
         data-filter-stav-kod="@Model.StavKod"
         data-filter-typ="@(Model.TypUkolu ?? string.Empty)"
         data-filter-typ-kod="@(Model.TypUkoluKod ?? string.Empty)"
         data-filter-vlastnik="@Model.AktualniVlastnik"
         data-filter-vlastnik-id="@Model.AktualniVlastnikId"
         data-filter-aktivni="@Model.IsAktivniStav.ToString().ToLowerInvariant()"
         data-filter-je-ukol="@Model.JeUkol.ToString().ToLowerInvariant()"
         data-filter-vyjadreni-jednani-stavy="@(string.Join("|", Model.VyjadreniJednaniStavyKody))">
    <div class="record-bar" aria-hidden="true"></div>
    <div class="record-content">
        <header class="record-header" data-record-toggle aria-expanded="false">
            <div class="record-title-wrap">
                <div class="record-meta">
                    <span class="pill">@Model.KategorieNazev</span>
                    @if (!string.IsNullOrWhiteSpace(Model.TypUkolu))
                    {
                        <span class="pill ghost">@Model.TypUkolu</span>
                    }
                </div>
                <div class="record-title">#@Model.CisloViditelne - @Model.Nazev</div>
                <div class="record-subtitle">@Model.Popis</div>
                <div class="record-summary-meta">
                    <span><span class="label">Termín:</span> @(Model.AktualniTermin?.ToString("dd.MM.yyyy") ?? "-")</span>
                    <span><span class="label">Založeno:</span> @Model.DatumZalozeni.ToString("dd.MM.yyyy")</span>
                </div>
                @if (Model.Spoluprace.Count > 0)
                {
                    <div class="record-collab-inline">
                        <span class="label">Spolupráce:</span>
                        <div class="record-collab-chips">
                            @foreach (var spolupracovnik in Model.Spoluprace)
                            {
                                <span class="chip chip-collab"
                                      title="@(string.IsNullOrWhiteSpace(spolupracovnik.Email) ? "-" : spolupracovnik.Email) | @(spolupracovnik.Organizace ?? "-") / @(spolupracovnik.OrganizacniCelek ?? "-")">
                                    @spolupracovnik.Osoba
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="record-actions">
                <span class="badge">@Model.Stav</span>
                <a class="icon-btn"
                   href="@taskPrintPdfUrl"
                   target="_blank"
                   rel="noopener"
                   aria-label="Tisk úkolu #@Model.CisloViditelne"
                   data-stop-propagation="true"
                   data-print-trigger="true"
                   data-print-pdf-url="@taskPrintPdfUrl"
                   data-print-word-url="@taskPrintWordUrl"
                   data-print-label="Tisk úkolu #@Model.CisloViditelne">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="6 9 6 2 18 2 18 9"></polyline>
                        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                        <rect x="6" y="14" width="12" height="8"></rect>
                    </svg>
                </a>
                @if (canEditRecord || canManageSchedule)
                {
                    <button class="btn small"
                            type="button"
                            data-record-editor-url="@editRecordUrl"
                            data-record-editor-project-id="@projektId"
                            data-record-editor-label="@($"{editButtonLabel} záznam #{Model.CisloViditelne}")"
                            data-stop-propagation="true">
                        @editButtonLabel
                    </button>
                }
                <span class="record-toggle-indicator" aria-hidden="true">›</span>
            </div>
        </header>

        <div class="record-body">
            <div class="record-history">
                <div>
                    <span class="label">Vlastník:</span>
                    @foreach (var jmeno in Model.HistorieVlastniku)
                    {
                        <span class="history"><s>@jmeno</s></span>
                    }
                    <strong>@Model.AktualniVlastnik</strong>
                </div>
                <div>
                    <span class="label">Termín:</span>
                    @foreach (var termin in Model.HistorieTerminu)
                    {
                        <span class="history"><s>@termin.ToString("dd.MM.yyyy")</s></span>
                    }
                    <strong>@(Model.AktualniTermin?.ToString("dd.MM.yyyy") ?? "-")</strong>
                </div>
                <div>
                    <span class="label">Subsystém:</span>
                    @foreach (var subsystem in Model.HistorieSubsystemu)
                    {
                        <span class="history"><s>@subsystem</s></span>
                    }
                    <strong>@Model.AktualniSubsystem</strong>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.TypUkolu))
                {
                    <div>
                        <span class="label">Typ úkolu:</span>
                        @foreach (var typ in Model.HistorieTypuUkolu)
                        {
                            <span class="history"><s>@typ</s></span>
                        }
                        <strong>@Model.TypUkolu</strong>
                    </div>
                }
            </div>

            @if (Model.ExterniOdkazy.Count > 0)
            {
                <div class="record-chips">
                    @for (var i = 0; i < Model.ExterniOdkazy.Count; i++)
                    {
                        var odkaz = Model.ExterniOdkazy[i];
                        var tooltipId = $"chip-tooltip-{Model.Id}-{i}";
                        var estimatedPriceLabel = odkaz.PredpokladanaCena.HasValue
                            ? $"{odkaz.PredpokladanaCena.Value.ToString("N2", CultureInfo.GetCultureInfo("cs-CZ"))} Kč"
                            : null;
                        <span class="chip-wrap">
                            @if (!string.IsNullOrWhiteSpace(odkaz.ServiceDeskUrl))
                            {
                                <a class="chip chip-interactive chip-link"
                                   href="@odkaz.ServiceDeskUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   aria-describedby="@tooltipId"
                                   title="Otevřít detail v ServiceDesk">
                                    <span class="chip-label">@odkaz.Typ</span>
                                    <span class="chip-value">@odkaz.Cislo</span>
                                    @if (!string.IsNullOrWhiteSpace(odkaz.Vyzva))
                                    {
                                        <span class="chip-sub">@odkaz.Vyzva</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(estimatedPriceLabel))
                                    {
                                        <span class="chip-sub">@estimatedPriceLabel</span>
                                    }
                                </a>
                            }
                            else
                            {
                                <span class="chip chip-interactive" tabindex="0" aria-describedby="@tooltipId">
                                    <span class="chip-label">@odkaz.Typ</span>
                                    <span class="chip-value">@odkaz.Cislo</span>
                                    @if (!string.IsNullOrWhiteSpace(odkaz.Vyzva))
                                    {
                                        <span class="chip-sub">@odkaz.Vyzva</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(estimatedPriceLabel))
                                    {
                                        <span class="chip-sub">@estimatedPriceLabel</span>
                                    }
                                </span>
                            }
                            <span id="@tooltipId" class="chip-tooltip" role="tooltip">
                                <span class="chip-tooltip-title">@odkaz.Typ @odkaz.Cislo</span>
                                <span class="chip-tooltip-row">
                                    <span>Typ:</span>
                                    <strong>@(odkaz.TypNazev ?? "-")</strong>
                                </span>
                                <span class="chip-tooltip-row">
                                    <span>Výzva:</span>
                                    <strong>@(string.IsNullOrWhiteSpace(odkaz.Vyzva) ? "-" : odkaz.Vyzva)</strong>
                                </span>
                                <span class="chip-tooltip-row">
                                    <span>Předpokl. cena:</span>
                                    <strong>@(string.IsNullOrWhiteSpace(estimatedPriceLabel) ? "-" : estimatedPriceLabel)</strong>
                                </span>
                                <span class="chip-tooltip-row">
                                    <span>Objednáno:</span>
                                    <strong>@FormatDate(odkaz.DatumObjednani)</strong>
                                </span>
                                <span class="chip-tooltip-row">
                                    <span>Plán dodání:</span>
                                    <strong>@FormatDate(odkaz.DatumPlanDodani)</strong>
                                </span>
                                <span class="chip-tooltip-row">
                                    <span>Datum dodání:</span>
                                    <strong>@FormatDate(odkaz.DatumDodani)</strong>
                                </span>
                                <span class="chip-tooltip-row">
                                    <span>Datum převzetí:</span>
                                    <strong>@FormatDate(odkaz.DatumPrevzeti)</strong>
                                </span>
                            </span>
                        </span>
                    }
                </div>
            }

            <div class="record-comments" data-comment-sort-section data-comment-sort-direction="asc">
                <div class="record-comments-header">
                    <h4>Vyjádření</h4>
                    @if (Model.Vyjadreni.Count > 1)
                    {
                        <button type="button" class="btn small ghost comment-sort-toggle" data-comment-sort-toggle>
                            Řazení: jednání vzestupně
                        </button>
                    }
                </div>
                @if (Model.Vyjadreni.Count == 0)
                {
                    <p class="muted">Zatím bez vyjádření.</p>
                }
                else
                {
                    <div class="comment-list" data-comment-list>
                        @foreach (var vyjadreni in Model.Vyjadreni)
                        {
                            <div class="comment" data-comment-item data-comment-meeting="@(vyjadreni.JednaniCislo ?? 0)" data-comment-id="@vyjadreni.Id">
                                <div class="comment-header">
                                    <strong>@vyjadreni.Autor</strong>
                                    <span class="muted">@vyjadreni.Datum.ToString("dd.MM.yyyy")</span>
                                </div>
                                <p class="comment-text">@vyjadreni.Text</p>
                                @if (canAddComment)
                                {
                                    <div class="comment-toolbar">
                                        @{
                                            var canEditThisComment = vyjadreni.LzeUpravit &&
                                                (canEditRecord || (canCommentAsSubsystemLeader && vyjadreni.AutorOsobaId == userOsobaId));
                                        }
                                        @if (canEditThisComment)
                                        {
                                            <div class="comment-toolbar-actions">
                                                <details class="comment-edit-details">
                                                    <summary class="comment-action-chip">Upravit</summary>
                                                    <form class="comment-edit-form" asp-controller="Zaznamy" asp-action="UpdateComment" method="post" data-ajax-submit="true">
                                                        <input type="hidden" name="projektId" value="@projektId" />
                                                        <input type="hidden" name="uiContext" value="project" />
                                                        <input type="hidden" name="zaznamId" value="@Model.Id" />
                                                        <input type="hidden" name="Id" value="@vyjadreni.Id" />
                                                        <textarea rows="3" name="Text" required>@vyjadreni.Text</textarea>
                                                        <button class="btn small" type="submit">Uložit změnu</button>
                                                    </form>
                                                </details>
                                                <form class="comment-delete-form comment-delete-form-inline" asp-controller="Zaznamy" asp-action="DeleteComment" method="post" data-ajax-submit="true" onsubmit="return confirm('Opravdu smazat vyjádření?');">
                                                    <input type="hidden" name="projektId" value="@projektId" />
                                                    <input type="hidden" name="uiContext" value="project" />
                                                    <input type="hidden" name="zaznamId" value="@Model.Id" />
                                                    <input type="hidden" name="Id" value="@vyjadreni.Id" />
                                                    <button class="btn small ghost" type="submit">Smazat</button>
                                                </form>
                                            </div>
                                        }
                                        else if (!vyjadreni.LzeUpravit)
                                        {
                                            <span class="muted">Jednání je uzavřené, vyjádření je jen pro čtení.</span>
                                        }
                                    </div>
                                }
                                @if (vyjadreni.JednaniDatum.HasValue)
                                {
                                    @if (vyjadreni.JednaniCislo.HasValue)
                                    {
                                        <span class="tag">Zapsáno na jednání č. @vyjadreni.JednaniCislo (@vyjadreni.JednaniDatum.Value.ToString("dd.MM.yyyy"))</span>
                                    }
                                    else
                                    {
                                        <span class="tag">Zapsáno na jednání @vyjadreni.JednaniDatum.Value.ToString("dd.MM.yyyy")</span>
                                    }
                                }
                            </div>
                        }
                    </div>
                }

                <form class="comment-form" asp-controller="Zaznamy" asp-action="AddComment" method="post" data-ajax-submit="true">
                    <input type="hidden" name="projektId" value="@projektId" />
                    <input type="hidden" name="uiContext" value="project" />
                    <input type="hidden" name="ZaznamId" value="@Model.Id" />
                    <textarea rows="4" name="Text" placeholder="Přidat vyjádření..." disabled="@(!canAddComment)"></textarea>
                    <div class="comment-actions">
                        <select class="wide-select" name="JednaniId" disabled="@(!canAddComment)" required="@(canAddComment ? "required" : null)">
                            <option value="">Vazba na jednání</option>
                            @foreach (var jednani in otevrenaJednani)
                            {
                                <option value="@jednani.Id">@jednani.Label</option>
                            }
                        </select>
                        @if (canAddComment)
                        {
                            <button class="btn small primary" type="submit">Uložit</button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</article>

@functions {
    private static string FormatDate(DateTime? value)
    {
        return value?.ToString("dd.MM.yyyy") ?? "-";
    }
}
