@model ZaznamEditViewModel
@{
    ViewData["Title"] = Model.IsCreate ? "Nový projektový záznam" : $"Upravit záznam {Model.CisloViditelne}";
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Title = Model.PageTitle,
    Subtitle = "Po uložení se vrátíte zpět do projektu do stejného pracovního kontextu.",
    BackUrl = Model.BackUrl,
    BackLabel = Model.BackLabel,
    UseRecordEditorBackNavigation = true
})

<section class="card record-editor-page-card record-editor-page-shell">
    @await Html.PartialAsync("~/Views/Projekty/_EditZaznamForm.cshtml", Model)
</section>
