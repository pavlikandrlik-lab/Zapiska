@model ZaznamEditViewModel
@{
    ViewData["Title"] = !string.IsNullOrWhiteSpace(Model.PageTitle)
        ? Model.PageTitle
        : (Model.IsCreate ? "Nový projektový záznam" : $"Upravit záznam {Model.CisloViditelne}");
}

@* Navigaci „zpět" nese drobečková lišta (frame bar pod menu) — chráněná stejným
   dirty-check guardem (maybeGuardOutboundNavigation) jako dřívější _PageHeader tlačítko.
   Zrušit/Uložit lišta editoru zůstává ve formuláři níže (2026-07-04). *@
<section class="card record-editor-page-card record-editor-page-shell">
    @await Html.PartialAsync("~/Views/Projekty/_EditZaznamForm.cshtml", Model)
</section>
