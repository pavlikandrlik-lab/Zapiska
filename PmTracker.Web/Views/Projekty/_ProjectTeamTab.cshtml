@model ProjektTymTabViewModel
@{
    var isActive = ViewData["IsActive"] as bool? ?? false;
}

<section class="tab-panel @(isActive ? "active" : null)" data-tab-panel="tym" data-table-tools-root>
    <div class="table-tools-toolbar">
        <label class="table-tools-search">
            <span>Hledat v týmu</span>
            <input type="search"
                   placeholder="Osoba, role, subsystém, organizace..."
                   data-table-tools-search-input />
        </label>
    </div>
    <div class="stack-lg">
        <section class="card">
            <div class="panel-header">
                <h3>Projektové role</h3>
                @if (Model.CanManageTeam)
                {
                    <div class="header-actions">
                        <button class="btn primary" type="button" data-modal-url="@Url.Action("AssignProjectRoleModal", "Projekty", new { projektId = Model.ProjektId })">Přidat projektovou roli</button>
                        <button class="btn" type="button" data-modal-url="@Url.Action("AssignProjectSubsystemRoleModal", "Projekty", new { projektId = Model.ProjektId })">Přidat roli v subsystému</button>
                    </div>
                }
            </div>
            <table class="table" data-table-tools-table data-table-empty-message="Žádná projektová role neodpovídá zadanému filtru.">
                <thead>
                    <tr>
                        <th>
                            <button class="table-sort-button" type="button" data-table-sort-button data-table-sort-index="0" data-table-sort-type="text" data-table-sort-default="true">Osoba</button>
                        </th>
                        <th>
                            <button class="table-sort-button" type="button" data-table-sort-button data-table-sort-index="1" data-table-sort-type="text">Email</button>
                        </th>
                        <th>
                            <button class="table-sort-button" type="button" data-table-sort-button data-table-sort-index="2" data-table-sort-type="text">Typ role</button>
                        </th>
                        <th>
                            <button class="table-sort-button" type="button" data-table-sort-button data-table-sort-index="3" data-table-sort-type="text">Role</button>
                        </th>
                        <th>
                            <button class="table-sort-button" type="button" data-table-sort-button data-table-sort-index="4" data-table-sort-type="text">Subsystém</button>
                        </th>
                        <th>
                            <button class="table-sort-button" type="button" data-table-sort-button data-table-sort-index="5" data-table-sort-type="text">Organizace</button>
                        </th>
                        <th>
                            <button class="table-sort-button" type="button" data-table-sort-button data-table-sort-index="6" data-table-sort-type="text">Organizační celek</button>
                        </th>
                        <th>
                            <button class="table-sort-button" type="button" data-table-sort-button data-table-sort-index="7" data-table-sort-type="datetime">Přiřazeno</button>
                        </th>
                        <th class="table-actions">Akce</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var role in Model.AktivniRole)
                {
                    <tr data-table-row>
                        <td>@role.Osoba</td>
                        <td>@(string.IsNullOrWhiteSpace(role.Email) ? "-" : role.Email)</td>
                        <td>@role.RoleTypeLabel</td>
                        <td>@role.RoleNazev</td>
                        <td>@(string.IsNullOrWhiteSpace(role.SubsystemNazev) ? "-" : role.SubsystemNazev)</td>
                        <td>@(role.Organizace ?? "-")</td>
                        <td>@(role.OrganizacniCelek ?? "-")</td>
                        <td data-table-sort-value="@role.DatumPrirazeni.ToString("O")">@role.DatumPrirazeni.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="table-actions">
                            @if (Model.CanManageTeam)
                            {
                                @if (string.Equals(role.AssignmentKind, "PROJECT", StringComparison.OrdinalIgnoreCase))
                                {
                                    <form asp-controller="Projekty"
                                          asp-action="DeactivateProjectRole"
                                          method="post"
                                          data-ajax-submit="true"
                                          onsubmit="return confirm('Opravdu deaktivovat projektovou roli?');">
                                        <input type="hidden" name="projektId" value="@Model.ProjektId" />
                                        <input type="hidden" name="ProjektRoleId" value="@role.AssignmentId" />
                                        <button class="btn small ghost" type="submit">Deaktivovat</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="Projekty"
                                          asp-action="DeactivateProjectSubsystemRole"
                                          method="post"
                                          data-ajax-submit="true"
                                          onsubmit="return confirm('Opravdu deaktivovat roli v subsystému?');">
                                        <input type="hidden" name="projektId" value="@Model.ProjektId" />
                                        <input type="hidden" name="ProjektSubsystemRoleId" value="@role.AssignmentId" />
                                        <button class="btn small ghost" type="submit">Deaktivovat</button>
                                    </form>
                                }
                            }
                            else
                            {
                                <span class="muted">Pouze čtení</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </section>

        <section class="card">
            <div class="panel-header">
                <h3>Subsystémy projektu</h3>
                @if (Model.CanManageTeam)
                {
                    <button class="btn primary" type="button" data-modal-url="@Url.Action("AssignProjectSubsystemModal", "Projekty", new { projektId = Model.ProjektId })">Přiřadit subsystém</button>
                }
            </div>
            <table class="table" data-table-tools-table data-table-empty-message="Žádný subsystém neodpovídá zadanému filtru.">
                <thead>
                    <tr>
                        <th>
                            <button class="table-sort-button" type="button" data-table-sort-button data-table-sort-index="0" data-table-sort-type="text" data-table-sort-default="true">Kód</button>
                        </th>
                        <th>
                            <button class="table-sort-button" type="button" data-table-sort-button data-table-sort-index="1" data-table-sort-type="text">Subsystém</button>
                        </th>
                        <th>
                            <button class="table-sort-button" type="button" data-table-sort-button data-table-sort-index="2" data-table-sort-type="datetime">Přiřazeno</button>
                        </th>
                        <th class="table-actions">Akce</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var subsystem in Model.AktivniSubsystemyProjektu)
                {
                    <tr data-table-row>
                        <td>@subsystem.Kod</td>
                        <td>@subsystem.Nazev</td>
                        <td data-table-sort-value="@subsystem.DatumPrirazeni.ToString("O")">@subsystem.DatumPrirazeni.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="table-actions">
                            @if (Model.CanManageTeam)
                            {
                                <form asp-controller="Projekty"
                                      asp-action="DeactivateProjectSubsystem"
                                      method="post"
                                      data-ajax-submit="true"
                                      onsubmit="return confirm('Opravdu deaktivovat subsystém projektu?');">
                                    <input type="hidden" name="projektId" value="@Model.ProjektId" />
                                    <input type="hidden" name="ProjektSubsystemId" value="@subsystem.ProjektSubsystemId" />
                                    <button class="btn small ghost" type="submit">Deaktivovat</button>
                                </form>
                            }
                            else
                            {
                                <span class="muted">Pouze čtení</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </section>

        <section class="card">
            <div class="panel-header">
                <h3>Historie rolí</h3>
            </div>
            <table class="table" data-table-tools-table data-table-empty-message="Žádná historická role neodpovídá zadanému filtru.">
                <thead>
                    <tr>
                        <th>
                            <button class="table-sort-button" type="button" data-table-sort-button data-table-sort-index="0" data-table-sort-type="text" data-table-sort-default="true">Osoba</button>
                        </th>
                        <th>
                            <button class="table-sort-button" type="button" data-table-sort-button data-table-sort-index="1" data-table-sort-type="text">Typ role</button>
                        </th>
                        <th>
                            <button class="table-sort-button" type="button" data-table-sort-button data-table-sort-index="2" data-table-sort-type="text">Role</button>
                        </th>
                        <th>
                            <button class="table-sort-button" type="button" data-table-sort-button data-table-sort-index="3" data-table-sort-type="text">Subsystém</button>
                        </th>
                        <th>
                            <button class="table-sort-button" type="button" data-table-sort-button data-table-sort-index="4" data-table-sort-type="datetime">Přiřazeno</button>
                        </th>
                        <th>
                            <button class="table-sort-button" type="button" data-table-sort-button data-table-sort-index="5" data-table-sort-type="datetime">Odebráno</button>
                        </th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var role in Model.HistorieRoli)
                {
                    <tr data-table-row>
                        <td>@role.Osoba</td>
                        <td>@role.RoleTypeLabel</td>
                        <td>@role.RoleNazev</td>
                        <td>@(string.IsNullOrWhiteSpace(role.SubsystemNazev) ? "-" : role.SubsystemNazev)</td>
                        <td data-table-sort-value="@role.DatumPrirazeni.ToString("O")">@role.DatumPrirazeni.ToString("dd.MM.yyyy HH:mm")</td>
                        <td data-table-sort-value="@(role.DatumOdebrani?.ToString("O") ?? string.Empty)">@(role.DatumOdebrani?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                    </tr>
                }
                </tbody>
            </table>
        </section>
    </div>
</section>
