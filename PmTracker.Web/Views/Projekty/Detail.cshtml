@model ProjektDetailViewModel
@{
    ViewData["Title"] = $"Projekt {Model.Projekt.Zkratka}";
    ViewData["BodyClass"] = "dashboard-page";
    var asUser = Context.Request.Query["asUser"].ToString();
    var recordsTabUrl = Url.Action("Detail", "Projekty", new
    {
        id = Model.Projekt.Id,
        tab = "zaznamy",
        asUser,
        recordId = Model.TargetRecordId,
        openComments = Model.TargetRecordOpenComments
    }) ?? $"/Projekty/Detail/{Model.Projekt.Id}?tab=zaznamy";
    var scheduleTabUrl = Url.Action("Detail", "Projekty", new { id = Model.Projekt.Id, tab = "harmonogram", asUser }) ?? $"/Projekty/Detail/{Model.Projekt.Id}?tab=harmonogram";
    var meetingsTabUrl = Url.Action("Detail", "Projekty", new { id = Model.Projekt.Id, tab = "jednani", asUser }) ?? $"/Projekty/Detail/{Model.Projekt.Id}?tab=jednani";
    var teamTabUrl = Url.Action("Detail", "Projekty", new { id = Model.Projekt.Id, tab = "tym", asUser }) ?? $"/Projekty/Detail/{Model.Projekt.Id}?tab=tym";
    var proposalsTabUrl = Url.Action("Detail", "Projekty", new { id = Model.Projekt.Id, tab = "navrhy", asUser }) ?? $"/Projekty/Detail/{Model.Projekt.Id}?tab=navrhy";
    var vyzvyTabUrl = Url.Action("Detail", "Projekty", new { id = Model.Projekt.Id, tab = "vyzvy", asUser }) ?? $"/Projekty/Detail/{Model.Projekt.Id}?tab=vyzvy";
}

<div class="tabs" role="tablist">
    @* project-status-inline ZÁMĚRNĚ vynecháno: jeho jediný efekt je margin-left:auto z page-headeru,
       který v řádku tabů (spolu s auto-marginem akcí) centroval menu. .tabs-status drží zarovnání vlevo. *@
    @if (!string.IsNullOrWhiteSpace(Model.Projekt.Stav))
    {
        <span class="badge tabs-status">@Model.Projekt.Stav</span>
    }
    <a class="tab @(Model.ActiveTab == "zaznamy" ? "active" : null)"
       id="tab-zaznamy"
       href="@recordsTabUrl"
       role="tab"
       aria-selected="@(Model.ActiveTab == "zaznamy" ? "true" : "false")"
       aria-controls="panel-zaznamy"
       data-tab="zaznamy">
        Záznamy
    </a>
    <a class="tab @(Model.ActiveTab == "harmonogram" ? "active" : null)"
       id="tab-harmonogram"
       href="@scheduleTabUrl"
       role="tab"
       aria-selected="@(Model.ActiveTab == "harmonogram" ? "true" : "false")"
       aria-controls="panel-harmonogram"
       data-tab="harmonogram">
        Harmonogram
    </a>
    <a class="tab @(Model.ActiveTab == "jednani" ? "active" : null)"
       id="tab-jednani"
       href="@meetingsTabUrl"
       role="tab"
       aria-selected="@(Model.ActiveTab == "jednani" ? "true" : "false")"
       aria-controls="panel-jednani"
       data-tab="jednani">
        Jednání
    </a>
    @* Sekundární záložky (Option 2, 2026-07-07): aktivní sekundární tab je VŽDY inline
       (podtržení viditelné i ve sbaleném stavu), „+" jednosměrně odkryje neaktivní inline
       „do boku", po rozbalení se vpravo dole u posledního tabu objeví zámeček (trvalé
       rozbalení = roční cookie). Zamčeno serverově = skupina rovnou rozbalená.
       Sbalení/expand řídí třída .is-expanded (JS pro „+"), aktivní tab se nikdy neschová. *@
    <div class="tab-secondary-group @(Model.ProjectMenuLocked ? "is-expanded" : null)" data-project-menu-group>
        <a class="tab tab-secondary @(Model.ActiveTab == "tym" ? "active" : null)"
           id="tab-tym" href="@teamTabUrl" role="tab"
           aria-selected="@(Model.ActiveTab == "tym" ? "true" : "false")"
           aria-controls="panel-tym" data-tab="tym">Osoby (tým)</a>
        @if (Model.CanViewProposals)
        {
            <a class="tab tab-secondary @(Model.ActiveTab == "navrhy" ? "active" : null)"
               id="tab-navrhy" href="@proposalsTabUrl" role="tab"
               aria-selected="@(Model.ActiveTab == "navrhy" ? "true" : "false")"
               aria-controls="panel-navrhy" data-tab="navrhy">Návrhy</a>
        }
        @* Výzvy — bez permission gate: vidí je každý, kdo vidí projekt (spec 2026-09-07 §4.1). *@
        <a class="tab tab-secondary @(Model.ActiveTab == "vyzvy" ? "active" : null)"
           id="tab-vyzvy" href="@vyzvyTabUrl" role="tab"
           aria-selected="@(Model.ActiveTab == "vyzvy" ? "true" : "false")"
           aria-controls="panel-vyzvy" data-tab="vyzvy">Výzvy</a>
        @if (Model.CanViewDashboard)
        {
            <a class="tab tab-secondary" role="tab" aria-selected="false"
               href="@Url.Action("Index", "ProjectDashboard", new { projektId = Model.Projekt.Id })">Dashboard</a>
        }

        @* „+" — odkryje neaktivní sekundární inline. Jen v odemčeném stavu (zamčeno = server už
           rozbalil). Ve sbaleném stavu viditelný, po klientském rozbalení CSS skryje. *@
        @if (!Model.ProjectMenuLocked)
        {
            <button type="button" class="tab tab-overflow-toggle"
                    data-project-menu-toggle aria-label="Zobrazit další záložky">
                <gov-icon size="s" name="plus" type="components" aria-hidden="true"></gov-icon>
            </button>
        }

        @* Zámeček — spodní index vpravo dole u posledního tabu; viditelný jen po rozbalení (CSS). *@
        <button type="button"
                class="project-menu-lock @(Model.ProjectMenuLocked ? "is-locked" : null)"
                data-project-menu-lock-toggle
                data-locked="@(Model.ProjectMenuLocked ? "1" : "0")"
                title="@(Model.ProjectMenuLocked ? "Odemknout — sbalit menu (jde i v Nastavení ▸ Předvolby)" : "Zamknout rozbalené menu natrvalo")"
                aria-label="@(Model.ProjectMenuLocked ? "Odemknout projektové menu" : "Zamknout rozbalené projektové menu")">
            <gov-icon class="project-menu-lock-icon icon-lock" size="s" name="lock" type="components" aria-hidden="true"></gov-icon>
            <gov-icon class="project-menu-lock-icon icon-unlock" size="s" name="unlock" type="components" aria-hidden="true"></gov-icon>
        </button>
    </div>

    @* Akce přesunuty z .panel-header do tab stripu (vpravo) kvůli úspoře místa
       (user 2026-06-10). Data z Model.ZaznamyTab (records panel se renderuje vždy). *@
    <div class="tabs-actions">
        @* „Nový návrh záznamu" jako první (vlevo) — jediné místo akce, gateované
           autoritativní branou CanCreateRecordProposalAsync (user 2026-06-22). *@
        @if (Model.ZaznamyTab.CanCreateRecordProposal && !string.IsNullOrWhiteSpace(Model.ZaznamyTab.CreateRecordProposalUrl))
        {
            <pm-button variant="Secondary" size="Small" href="@Model.ZaznamyTab.CreateRecordProposalUrl">
                Nový návrh záznamu
            </pm-button>
        }
        @* A6 (2026-07-08): BEZ href — gov-button s href otevírá interní anchor dřív, než
           uživatel zvolí formát v chooseru. URL nese data-print-pdf/word-url (resolvePrintUrl). *@
        <pm-button variant="Ghost"
                   size="Small"
                   data-print-trigger="true"
                   data-project-print-trigger="true"
                   data-print-pdf-url="@Model.ZaznamyTab.ProjectPrintUrl"
                   data-print-word-url="@Model.ZaznamyTab.ProjectWordUrl"
                   data-print-label="Tisk projektu">
            Tisk projektu
        </pm-button>
        @if (Model.ZaznamyTab.CanManageRecords)
        {
            <pm-button variant="Primary" size="Small" href="@Model.ZaznamyTab.CreateRecordEditorUrl">
                Nový záznam
            </pm-button>
        }
        @* „Nové jednání" přesunuto z panel-headeru záložky Jednání do tab stripu vpravo
           (user 2026-06-16) — konzistentní s ostatními projektovými akcemi, šetří svislé místo.
           Model.CanCreateMeetings je projektová úroveň (vždy dostupná; jednání tab je lazy). *@
        @if (Model.CanCreateMeetings)
        {
            <pm-button variant="Primary" size="Small" data-modal-url="@Url.Action("NewMeetingModal", "Jednani", new { projektId = Model.Projekt.Id })">
                Nové jednání
            </pm-button>
        }
    </div>
</div>

@await Html.PartialAsync(
    "_ProjectRecordsTab",
    Model.ZaznamyTab,
    new ViewDataDictionary(ViewData)
    {
        ["IsActive"] = Model.ActiveTab == "zaznamy",
        ["TargetRecordId"] = Model.TargetRecordId,
        ["TargetRecordOpenComments"] = Model.TargetRecordOpenComments
    })

@if (Model.LoadedHarmonogramTab is not null)
{
    @await Html.PartialAsync(
        "_ProjectScheduleTab",
        Model.LoadedHarmonogramTab,
        new ViewDataDictionary(ViewData)
        {
            ["IsActive"] = Model.ActiveTab == "harmonogram"
        })
}
else
{
    <section id="panel-harmonogram"
             class="tab-panel @(Model.ActiveTab == "harmonogram" ? "active" : null)"
             role="tabpanel"
             aria-labelledby="tab-harmonogram"
             data-tab-panel="harmonogram"
             data-project-tab-lazy-url="@Model.HarmonogramTab.LoadUrl"
             data-project-tab-loaded="false">
        <div class="lazy-tab-placeholder" data-project-tab-placeholder>
            <div class="record-loading-placeholder">
                <div class="record-loading-line"></div>
                <div class="record-loading-line short"></div>
                <div class="record-loading-line"></div>
            </div>
            <p class="muted">@Model.HarmonogramTab.LoadingText</p>
        </div>
        <div class="record-loading-error" data-project-tab-error hidden></div>
    </section>
}

@if (Model.CanViewProposals)
{
    if (Model.LoadedNavrhyTab is not null)
    {
        @await Html.PartialAsync(
            "_ProjectProposalsTab",
            Model.LoadedNavrhyTab,
            new ViewDataDictionary(ViewData)
            {
                ["IsActive"] = Model.ActiveTab == "navrhy"
            })
    }
    else
    {
        <section id="panel-navrhy"
                 class="tab-panel @(Model.ActiveTab == "navrhy" ? "active" : null)"
                 role="tabpanel"
                 aria-labelledby="tab-navrhy"
                 data-tab-panel="navrhy"
                 data-project-tab-lazy-url="@Model.NavrhyTab.LoadUrl"
                 data-project-tab-loaded="false">
            <div class="lazy-tab-placeholder" data-project-tab-placeholder>
                <div class="record-loading-placeholder">
                    <div class="record-loading-line"></div>
                    <div class="record-loading-line short"></div>
                    <div class="record-loading-line"></div>
                </div>
                <p class="muted">@Model.NavrhyTab.LoadingText</p>
            </div>
            <div class="record-loading-error" data-project-tab-error hidden></div>
        </section>
    }
}

