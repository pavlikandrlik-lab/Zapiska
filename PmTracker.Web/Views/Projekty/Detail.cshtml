            </div>
            <div class="filter-actions">
                <button class="btn small ghost" type="button" data-filter-save-defaults="gantt">Uložit jako výchozí</button>
                <span class="filter-save-status" data-filter-save-status="gantt" aria-live="polite"></span>
            </div>
        </div>
    </div>

    <div class="gantt-layout">
        <aside class="gantt-picker" data-gantt-picker>
            <h3>Zobrazené úkoly</h3>
            @if (harmonogramUkoly.Count == 0)
            {
                <p class="muted">V projektu zatím nejsou úkoly s harmonogramem.</p>
            }
            else
            {
                @foreach (var item in harmonogramUkoly)
                {
                    <label class="gantt-picker-item"
                           data-gantt-picker-item
                           data-gantt-record-id="@item.ZaznamId"
                           data-gantt-filter-subsystem="@item.Subsystem"
                           data-gantt-filter-subsystem-kod="@item.SubsystemKod"
                           data-gantt-filter-kategorie="@item.KategorieNazev"
                           data-gantt-filter-kategorie-kod="@item.KategorieKod"
                           data-gantt-filter-stav="@item.Stav"
                           data-gantt-filter-stav-kod="@item.StavKod"
                           data-gantt-filter-typ="@(item.TypUkolu ?? string.Empty)"
                           data-gantt-filter-typ-kod="@(item.TypUkoluKod ?? string.Empty)"
                           data-gantt-filter-vlastnik="@item.Vlastnik"
                           data-gantt-filter-vlastnik-id="@item.VlastnikId"
                           data-gantt-filter-aktivni="@item.IsAktivniStav.ToString().ToLowerInvariant()"
                           data-gantt-filter-stihani="@(item.Stihame ? "stihame" : "nestihame")">
                        <input type="checkbox" checked="checked" data-gantt-pin-input data-gantt-record-id="@item.ZaznamId" />
                        <span>#@item.CisloViditelne - @item.Nazev</span>
                    </label>
                }
            }
        </aside>

        <div class="gantt-board" data-gantt-board>
            @if (harmonogramUkoly.Count == 0)
            {
                <p class="muted">V projektu zatím nejsou úkoly s harmonogramem.</p>
            }
            else
            {
                @foreach (var item in harmonogramUkoly)
                {
                    var axisStart = item.DatumZalozeni.Date;
                    var realEnd = item.Kroky.Count > 0 ? item.Kroky[^1].RealEnd.Date : axisStart;
                    var axisEnd = new[] { item.TerminUkonceni.Date, realEnd, axisStart }.Max();
                    var axisDays = Math.Max(1, (axisEnd - axisStart).Days);
                    Func<DateTime, double> toPercent = value => Math.Clamp(((value.Date - axisStart).Days * 100d) / axisDays, 0d, 100d);
                    Func<double, string> formatPercent = value => value.ToString("0.####", CultureInfo.InvariantCulture);
                    var deadlinePercent = toPercent(item.TerminUkonceni.Date);
                    <article class="gantt-task"
                             data-gantt-item
                             data-gantt-record-id="@item.ZaznamId"
                             data-gantt-filter-subsystem="@item.Subsystem"
                             data-gantt-filter-subsystem-kod="@item.SubsystemKod"
                             data-gantt-filter-kategorie="@item.KategorieNazev"
                             data-gantt-filter-kategorie-kod="@item.KategorieKod"
                             data-gantt-filter-stav="@item.Stav"
                             data-gantt-filter-stav-kod="@item.StavKod"
                             data-gantt-filter-typ="@(item.TypUkolu ?? string.Empty)"
                             data-gantt-filter-typ-kod="@(item.TypUkoluKod ?? string.Empty)"
                             data-gantt-filter-vlastnik="@item.Vlastnik"
                             data-gantt-filter-vlastnik-id="@item.VlastnikId"
                             data-gantt-filter-aktivni="@item.IsAktivniStav.ToString().ToLowerInvariant()"
                             data-gantt-filter-stihani="@(item.Stihame ? "stihame" : "nestihame")">
                        <div class="gantt-task-header">
                            <div>
                                <div class="record-title">#@item.CisloViditelne - @item.Nazev</div>
                                <div class="record-summary-meta">
                                    <span><span class="label">Stav:</span> @item.Stav</span>
                                    <span><span class="label">Typ:</span> @(string.IsNullOrWhiteSpace(item.TypUkolu) ? "-" : item.TypUkolu)</span>
                                    <span><span class="label">Subsystém:</span> @item.Subsystem</span>
                                    <span><span class="label">Vlastník:</span> @item.Vlastnik</span>
                                </div>
                            </div>
                            <div class="gantt-task-actions">
                                <span class="badge @(item.Stihame ? "schedule-badge-ok" : "schedule-badge-late")">@(item.Stihame ? "Stíháme" : "Nestíháme")</span>
                                <button class="btn small ghost" type="button" data-gantt-expand-toggle data-gantt-record-id="@item.ZaznamId">Rozpad</button>
                                @if (canManageSchedules)
                                {
                                    var ganttEditUrl = Url.Action("Edit", "Zaznamy", new { id = item.ZaznamId, projektId = Model.Projekt.Id }) ?? $"/Zaznamy/Edit/{item.ZaznamId}";
                                    <div class="record-editor-split">
                                        <button class="btn small"
                                                type="button"
                                                data-record-editor-url="@ganttEditUrl"
                                                data-record-editor-project-id="@Model.Projekt.Id"
                                                data-record-editor-label="@($"Upravit záznam #{item.CisloViditelne}")">
                                            Upravit
                                        </button>
                                        <button class="btn small record-editor-split-choice"
                                                type="button"
                                                data-record-editor-url="@ganttEditUrl"
                                                data-record-editor-project-id="@Model.Projekt.Id"
                                                data-record-editor-label="@($"Upravit záznam #{item.CisloViditelne}")"
                                                data-record-editor-choice="true"
                                                aria-label="Vybrat způsob otevření editoru záznamu #@item.CisloViditelne">
                                            <span aria-hidden="true">▾</span>
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="schedule-card-timeline">
                            <div class="schedule-rainbow-row">
                                <span class="schedule-rainbow-label">Plán</span>
                                <div class="schedule-rainbow-track">
                                    <div class="schedule-rainbow-marker deadline" style="left:@formatPercent(deadlinePercent)%;"></div>
                                    @{
                                        var previousPlanRight = 0d;
                                    }
                                    @foreach (var krok in item.Kroky)
                                    {
                                        var rawLeft = toPercent(krok.PlanStart);
                                        var rawRight = toPercent(krok.PlanEnd);
                                        var left = Math.Max(previousPlanRight, rawLeft);
                                        var right = Math.Max(left, rawRight);
                                        var width = Math.Max(0d, right - left);
                                        var widthStyle = width > 0d
                                            ? $"calc({formatPercent(width)}% + 1px)"
                                            : "0%";
                                        previousPlanRight = right;
                                        <span class="schedule-rainbow-segment"
                                              data-rainbow-segment-label-full="@krok.Nazev"
                                              data-rainbow-segment-label-short="@krok.KrokIndex"
                                              style="left:@formatPercent(left)%; width:@widthStyle; background:@krok.BarvaHex;"></span>
                                    }
                                </div>
                            </div>
                            <div class="schedule-rainbow-row">
                                <span class="schedule-rainbow-label">Posun</span>
                                <div class="schedule-rainbow-track">
                                    <div class="schedule-rainbow-marker deadline" style="left:@formatPercent(deadlinePercent)%;"></div>
                                    @{
                                        var previousRealRight = 0d;
                                    }
                                    @foreach (var krok in item.Kroky)
                                    {
                                        var rawLeft = toPercent(krok.RealStart);
                                        var rawRight = toPercent(krok.RealEnd);
                                        var left = Math.Max(previousRealRight, rawLeft);
                                        var right = Math.Max(left, rawRight);
                                        var width = Math.Max(0d, right - left);
                                        var widthStyle = width > 0d
                                            ? $"calc({formatPercent(width)}% + 1px)"
                                            : "0%";
                                        previousRealRight = right;
                                        <span class="schedule-rainbow-segment"
                                              data-rainbow-segment-label-full="@krok.Nazev"
                                              data-rainbow-segment-label-short="@krok.KrokIndex"
                                              style="left:@formatPercent(left)%; width:@widthStyle; background:@krok.BarvaHex;"></span>
                                    }
                                </div>
                            </div>
                            <div class="schedule-rainbow-legend">
                                <span>Termín úkolu: @item.TerminUkonceni.ToString("dd.MM.yyyy")</span>
                                <span>Posun dokončení: @item.PosunuteDokonceni.ToString("dd.MM.yyyy")</span>
                                <span>Překročení: @(item.PrekroceniDni > 0 ? $"{item.PrekroceniDni} dnů" : "0 dnů")</span>
                            </div>
                        </div>

                        <div class="gantt-steps" data-gantt-steps data-gantt-record-id="@item.ZaznamId" hidden="hidden">
                            @foreach (var krok in item.Kroky)
                            {
                                var stepLeft = toPercent(krok.PlanStart);
                                var stepRight = toPercent(krok.PlanEnd);
                                var stepWidth = Math.Max(0d, stepRight - stepLeft);
                                var delayLeft = toPercent(krok.PlanEnd);
                                var delayRight = toPercent(krok.RealEnd);
                                var delayWidth = Math.Max(0d, delayRight - delayLeft);
                                <div class="gantt-step-row">
                                    <div class="gantt-step-name">@krok.Nazev</div>
                                    <div class="gantt-step-track">
                                        <div class="schedule-rainbow-marker deadline" style="left:@formatPercent(deadlinePercent)%;"></div>
                                        <span class="gantt-step-segment" style="left:@formatPercent(stepLeft)%; width:@formatPercent(stepWidth)%; background:@krok.BarvaHex;"></span>
                                    </div>
                                </div>
                                <div class="gantt-step-row delay">
                                    <div class="gantt-step-name">zpoždění</div>
                                    <div class="gantt-step-track">
                                        <div class="schedule-rainbow-marker deadline" style="left:@formatPercent(deadlinePercent)%;"></div>
                                        <span class="gantt-step-delay" style="left:@formatPercent(delayLeft)%; width:@formatPercent(delayWidth)%; background:@item.DelayBarvaHex;"></span>
                                    </div>
                                </div>
                            }
                        </div>
                    </article>
                }
            }
        </div>
    </div>
</section>

<section class="tab-panel" data-tab-panel="jednani">
    @if (canCreateMeetings)
    {
        <div class="panel-header">
            <button class="btn primary" type="button" data-modal-url="@Url.Action("NewMeetingModal", "Projekty", new { projektId = Model.Projekt.Id })">Nová porada</button>
        </div>
    }

    <div class="meeting-grid">
        @foreach (var jednani in Model.Jednani)
        {
            var detailUrl = Url.Action("Detail", "Jednani", new { id = jednani.Id, returnUrl = returnToProjectUrl }) ?? $"/Jednani/Detail/{jednani.Id}";
            var meetingPdfUrl = Url.Action("JednaniTisk", "Export", new { jednaniId = jednani.Id, autoPrint = true }) ?? $"/Export/Jednani/{jednani.Id}/Tisk?autoPrint=true";
            var meetingWordUrl = Url.Action("JednaniWord", "Export", new { jednaniId = jednani.Id }) ?? $"/Export/Jednani/{jednani.Id}/Word";
            @await Html.PartialAsync("_MeetingCard", new MeetingCardViewModel
            {
                ProjektId = Model.Projekt.Id,
                CanDelete = canDeleteMeetings,
                UseAjaxDelete = true,
                DetailUrl = detailUrl,
                PrintPdfUrl = meetingPdfUrl,
                PrintWordUrl = meetingWordUrl,
                Jednani = jednani
            })
        }
    </div>
</section>

<section class="tab-panel" data-tab-panel="tym">
    <div class="stack-lg">
        <section class="card">
            <div class="panel-header">
                <h3>Projektové role</h3>
                @if (canManageTeam)
                {
                    <button class="btn primary" type="button" data-modal-url="@Url.Action("AssignProjectRoleModal", "Projekty", new { projektId = Model.Projekt.Id })">Přidat projektovou roli</button>
                }
            </div>
            <table class="table">
                <thead>
                    <tr>
                        <th>Osoba</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Organizace</th>
                        <th>Organizační celek</th>
                        <th>Přiřazeno</th>
                        <th class="table-actions">Akce</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var role in Model.AktivniProjektoveRole)
                {
                    <tr>
                        <td>@role.Osoba</td>
                        <td>@(string.IsNullOrWhiteSpace(role.Email) ? "-" : role.Email)</td>
                        <td>@role.RoleNazev</td>
                        <td>@(role.Organizace ?? "-")</td>
                        <td>@(role.OrganizacniCelek ?? "-")</td>
                        <td>@role.DatumPrirazeni.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="table-actions">
                            @if (canManageTeam)
                            {
                                <form asp-controller="Projekty"
                                      asp-action="DeactivateProjectRole"
                                      method="post"
                                      data-ajax-submit="true"
                                      onsubmit="return confirm('Opravdu deaktivovat projektovou roli?');">
                                    <input type="hidden" name="projektId" value="@Model.Projekt.Id" />
                                    <input type="hidden" name="ProjektRoleId" value="@role.ProjektRoleId" />
                                    <button class="btn small ghost" type="submit">Deaktivovat</button>
                                </form>
                            }
                            else
                            {
                                <span class="muted">Pouze čtení</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </section>

        <section class="card">
            <div class="panel-header">
                <h3>Subsystémy projektu</h3>
                @if (canManageTeam)
                {
                    <button class="btn primary" type="button" data-modal-url="@Url.Action("AssignProjectSubsystemModal", "Projekty", new { projektId = Model.Projekt.Id })">Přiřadit subsystém</button>
                }
            </div>
            <table class="table">
                <thead>
                    <tr>
                        <th>Kód</th>
                        <th>Subsystém</th>
                        <th>Přiřazeno</th>
                        <th class="table-actions">Akce</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var subsystem in Model.AktivniSubsystemyProjektu)
                {
                    <tr>
                        <td>@subsystem.Kod</td>
                        <td>@subsystem.Nazev</td>
                        <td>@subsystem.DatumPrirazeni.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="table-actions">
                            @if (canManageTeam)
                            {
                                <form asp-controller="Projekty"
                                      asp-action="DeactivateProjectSubsystem"
                                      method="post"
                                      data-ajax-submit="true"
                                      onsubmit="return confirm('Opravdu deaktivovat subsystém projektu?');">
                                    <input type="hidden" name="projektId" value="@Model.Projekt.Id" />
                                    <input type="hidden" name="ProjektSubsystemId" value="@subsystem.ProjektSubsystemId" />
                                    <button class="btn small ghost" type="submit">Deaktivovat</button>
                                </form>
                            }
                            else
                            {
                                <span class="muted">Pouze čtení</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </section>

        <section class="card">
            <div class="panel-header">
                <h3>Role v subsystémech</h3>
                @if (canManageTeam)
                {
                    <button class="btn primary" type="button" data-modal-url="@Url.Action("AssignProjectSubsystemRoleModal", "Projekty", new { projektId = Model.Projekt.Id })">Přidat roli v subsystému</button>
                }
            </div>
            <table class="table">
                <thead>
                    <tr>
                        <th>Subsystém</th>
                        <th>Osoba</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Přiřazeno</th>
                        <th class="table-actions">Akce</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var role in Model.AktivniSubsystemoveRole)
                {
                    <tr>
                        <td>@role.SubsystemNazev</td>
                        <td>@role.Osoba</td>
                        <td>@(string.IsNullOrWhiteSpace(role.Email) ? "-" : role.Email)</td>
                        <td>@role.RoleNazev</td>
                        <td>@role.DatumPrirazeni.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="table-actions">
                            @if (canManageTeam)
                            {
                                <form asp-controller="Projekty"
                                      asp-action="DeactivateProjectSubsystemRole"
                                      method="post"
                                      data-ajax-submit="true"
                                      onsubmit="return confirm('Opravdu deaktivovat roli v subsystému?');">
                                    <input type="hidden" name="projektId" value="@Model.Projekt.Id" />
                                    <input type="hidden" name="ProjektSubsystemRoleId" value="@role.ProjektSubsystemRoleId" />
                                    <button class="btn small ghost" type="submit">Deaktivovat</button>
                                </form>
                            }
                            else
                            {
                                <span class="muted">Pouze čtení</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </section>

        <section class="card">
            <div class="panel-header">
                <h3>Historie rolí</h3>
            </div>

            <h4>Projektové role</h4>
            <table class="table">
                <thead>
                    <tr>
                        <th>Osoba</th>
                        <th>Role</th>
                        <th>Přiřazeno</th>
                        <th>Odebráno</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var role in Model.HistorieProjektovychRoli)
                {
                    <tr>
                        <td>@role.Osoba</td>
                        <td>@role.RoleNazev</td>
                        <td>@role.DatumPrirazeni.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@(role.DatumOdebrani?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                    </tr>
                }
                </tbody>
            </table>

            <h4>Subsystemové role</h4>
            <table class="table">
                <thead>
                    <tr>
                        <th>Subsystém</th>
                        <th>Osoba</th>
                        <th>Role</th>
                        <th>Přiřazeno</th>
                        <th>Odebráno</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var role in Model.HistorieSubsystemovychRoli)
                {
                    <tr>
                        <td>@role.SubsystemNazev</td>
                        <td>@role.Osoba</td>
                        <td>@role.RoleNazev</td>
                        <td>@role.DatumPrirazeni.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@(role.DatumOdebrani?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                    </tr>
                }
                </tbody>
            </table>
        </section>
    </div>
</section>
