@model ProjektDetailViewModel
@{
    ViewData["Title"] = $"Projekt {Model.Projekt.Zkratka}";
    var asUser = Context.Request.Query["asUser"].ToString();
    var recordsTabUrl = Url.Action("Detail", "Projekty", new
    {
        id = Model.Projekt.Id,
        tab = "zaznamy",
        asUser,
        recordId = Model.TargetRecordId,
        openComments = Model.TargetRecordOpenComments
    }) ?? $"/Projekty/Detail/{Model.Projekt.Id}?tab=zaznamy";
    var scheduleTabUrl = Url.Action("Detail", "Projekty", new { id = Model.Projekt.Id, tab = "harmonogram", asUser }) ?? $"/Projekty/Detail/{Model.Projekt.Id}?tab=harmonogram";
    var meetingsTabUrl = Url.Action("Detail", "Projekty", new { id = Model.Projekt.Id, tab = "jednani", asUser }) ?? $"/Projekty/Detail/{Model.Projekt.Id}?tab=jednani";
    var teamTabUrl = Url.Action("Detail", "Projekty", new { id = Model.Projekt.Id, tab = "tym", asUser }) ?? $"/Projekty/Detail/{Model.Projekt.Id}?tab=tym";
    var proposalsTabUrl = Url.Action("Detail", "Projekty", new { id = Model.Projekt.Id, tab = "navrhy", asUser }) ?? $"/Projekty/Detail/{Model.Projekt.Id}?tab=navrhy";
}

<section class="page-header page-header-compact">
    <div class="project-header-row">
        @if (!string.IsNullOrWhiteSpace(Model.BackUrl))
        {
            <a class="btn small ghost" href="@Model.BackUrl">@(Model.BackLabel ?? "Zpět")</a>
            <span class="project-header-divider">|</span>
        }
        <h1 class="project-title-inline">@Model.PageTitle</h1>
        <span class="pill">Zkratka: @Model.Projekt.Zkratka</span>
        @if (!string.IsNullOrWhiteSpace(Model.Projekt.Stav))
        {
            <span class="badge project-status-inline">@Model.Projekt.Stav</span>
        }
    </div>
</section>

<div class="tabs" role="tablist">
    <a class="tab @(Model.ActiveTab == "zaznamy" ? "active" : null)"
       href="@recordsTabUrl"
       data-tab="zaznamy">
        Záznamy
    </a>
    <a class="tab @(Model.ActiveTab == "harmonogram" ? "active" : null)"
       href="@scheduleTabUrl"
       data-tab="harmonogram">
        Harmonogram
    </a>
    <a class="tab @(Model.ActiveTab == "jednani" ? "active" : null)"
       href="@meetingsTabUrl"
       data-tab="jednani">
        Jednání
    </a>
    <a class="tab @(Model.ActiveTab == "tym" ? "active" : null)"
       href="@teamTabUrl"
       data-tab="tym">
        Osoby (tým)
    </a>
    @if (Model.CanViewProposals)
    {
        <a class="tab @(Model.ActiveTab == "navrhy" ? "active" : null)"
           href="@proposalsTabUrl"
           data-tab="navrhy">
            Návrhy
        </a>
    }
</div>

@await Html.PartialAsync(
    "_ProjectRecordsTab",
    Model.ZaznamyTab,
    new ViewDataDictionary(ViewData)
    {
        ["IsActive"] = Model.ActiveTab == "zaznamy",
        ["TargetRecordId"] = Model.TargetRecordId,
        ["TargetRecordOpenComments"] = Model.TargetRecordOpenComments
    })

@if (Model.LoadedHarmonogramTab is not null)
{
    @await Html.PartialAsync(
        "_ProjectScheduleTab",
        Model.LoadedHarmonogramTab,
        new ViewDataDictionary(ViewData)
        {
            ["IsActive"] = Model.ActiveTab == "harmonogram"
        })
}
else
{
    <section class="tab-panel @(Model.ActiveTab == "harmonogram" ? "active" : null)"
             data-tab-panel="harmonogram"
             data-project-tab-lazy-url="@Model.HarmonogramTab.LoadUrl"
             data-project-tab-loaded="false">
        <div class="lazy-tab-placeholder" data-project-tab-placeholder>
            <div class="record-loading-placeholder">
                <div class="record-loading-line"></div>
                <div class="record-loading-line short"></div>
                <div class="record-loading-line"></div>
            </div>
            <p class="muted">@Model.HarmonogramTab.LoadingText</p>
        </div>
        <div class="record-loading-error" data-project-tab-error hidden></div>
    </section>
}

@if (Model.CanViewProposals)
{
    if (Model.LoadedNavrhyTab is not null)
    {
        @await Html.PartialAsync(
            "_ProjectProposalsTab",
            Model.LoadedNavrhyTab,
            new ViewDataDictionary(ViewData)
            {
                ["IsActive"] = Model.ActiveTab == "navrhy"
            })
    }
    else
    {
        <section class="tab-panel @(Model.ActiveTab == "navrhy" ? "active" : null)"
                 data-tab-panel="navrhy"
                 data-project-tab-lazy-url="@Model.NavrhyTab.LoadUrl"
                 data-project-tab-loaded="false">
            <div class="lazy-tab-placeholder" data-project-tab-placeholder>
                <div class="record-loading-placeholder">
                    <div class="record-loading-line"></div>
                    <div class="record-loading-line short"></div>
                    <div class="record-loading-line"></div>
                </div>
                <p class="muted">@Model.NavrhyTab.LoadingText</p>
            </div>
            <div class="record-loading-error" data-project-tab-error hidden></div>
        </section>
    }
}

@if (Model.LoadedJednaniTab is not null)
{
    @await Html.PartialAsync(
        "_ProjectMeetingsTab",
        Model.LoadedJednaniTab,
        new ViewDataDictionary(ViewData)
        {
            ["IsActive"] = Model.ActiveTab == "jednani"
        })
}
else
{
    <section class="tab-panel @(Model.ActiveTab == "jednani" ? "active" : null)"
             data-tab-panel="jednani"
             data-project-tab-lazy-url="@Model.JednaniTab.LoadUrl"
             data-project-tab-loaded="false">
        <div class="lazy-tab-placeholder" data-project-tab-placeholder>
            <div class="record-loading-placeholder">
                <div class="record-loading-line"></div>
                <div class="record-loading-line short"></div>
            </div>
            <p class="muted">@Model.JednaniTab.LoadingText</p>
        </div>
        <div class="record-loading-error" data-project-tab-error hidden></div>
    </section>
}

@if (Model.LoadedTymTab is not null)
{
    @await Html.PartialAsync(
        "_ProjectTeamTab",
        Model.LoadedTymTab,
        new ViewDataDictionary(ViewData)
        {
            ["IsActive"] = Model.ActiveTab == "tym"
        })
}
else
{
    <section class="tab-panel @(Model.ActiveTab == "tym" ? "active" : null)"
             data-tab-panel="tym"
             data-project-tab-lazy-url="@Model.TymTab.LoadUrl"
             data-project-tab-loaded="false">
        <div class="lazy-tab-placeholder" data-project-tab-placeholder>
            <div class="record-loading-placeholder">
                <div class="record-loading-line"></div>
                <div class="record-loading-line short"></div>
                <div class="record-loading-line"></div>
            </div>
            <p class="muted">@Model.TymTab.LoadingText</p>
        </div>
        <div class="record-loading-error" data-project-tab-error hidden></div>
    </section>
}
