@using System.Globalization
@model ZaznamEditViewModel
<pm-tab-panel key="external" class="record-modal-panel" data-record-modal-panel="external">
    <div class="section-divider">Externí vazby</div>
    <div data-external-links-editor>
        <div class="external-links" data-external-links>
            @for (var i = 0; i < Model.ExterniVazby.Count; i++)
            {
                var vazba = Model.ExterniVazby[i];
                var isPnf = string.Equals(vazba.Typ, "PNF", StringComparison.OrdinalIgnoreCase);
                var showEstimatedPrice = isPnf
                    || string.Equals(vazba.Typ, "PMP", StringComparison.OrdinalIgnoreCase);
                var estimatedPriceValue = vazba.PredpokladanaCena?.ToString("0.##", CultureInfo.InvariantCulture) ?? string.Empty;
                var statusText = vazba.VyzvaKod is not null
                    ? $"Zařazeno do výzvy {vazba.VyzvaKod}"
                    : vazba.ZaradidDoVyzvy ? "Čeká se (buffer projektu)" : null;
                var datumObjednani = vazba.DatumObjednani?.ToString("dd.MM.yyyy");
                var planDodani = vazba.PlanDodani?.ToString("dd.MM.yyyy");
                var datumDodani = vazba.DatumDodani?.ToString("dd.MM.yyyy");
                var datumPrevzeti = vazba.DatumPrevzeti?.ToString("dd.MM.yyyy");
                // ticketResolved = ticket byl už dohledán v SD při dřívější editaci
                // (Typ v DB je naplněn). Pokud ano, datumy zobrazíme vždy — i prázdné
                // s placeholder ikonou kalendáře. Pokud Typ není naplněn, datumy se
                // odhalí až po pozitivní sync odpovědi (sync.js setDatesVisible).
                var ticketResolved = !string.IsNullOrWhiteSpace(vazba.Typ);
                var chatEnabled = ticketResolved;
                var typTagColor = vazba.Typ?.ToUpperInvariant() switch
                {
                    "NES" => "warning",
                    "PMP" => "primary",
                    "PNF" => "success",
                    _ => "neutral"
                };

                <div class="external-row" data-external-row>
                    <input type="hidden" name="ExterniVazby[@i].Id" value="@vazba.Id" />
                    <input type="hidden" name="ExterniVazby[@i].Typ" value="@vazba.Typ" data-external-type-hidden />

                    <label class="external-field-cislo">
                        <span class="external-field-label">Číslo</span>
                        <gov-form-input size="m"
                                        name="ExterniVazby[@i].Cislo"
                                        value="@vazba.Cislo"
                                        maxlength="6"
                                        pattern="[0-9]{6}"
                                        inputmode="numeric"
                                        data-external-cislo
                                        data-external-odkaz-id="@vazba.Id"></gov-form-input>
                    </label>

                    <div class="external-field-typ">
                        <span class="external-field-label">Typ</span>
                        <gov-tag size="s" type="subtle" color="@typTagColor" data-external-type-display>@(vazba.Typ ?? "—")</gov-tag>
                    </div>

                    <label class="external-field-cena" data-external-price-field @(showEstimatedPrice ? null : "hidden=\"hidden\"")>
                        <span class="external-field-label">Předpokládaná cena</span>
                        <gov-form-input size="m"
                                        input-type="number"
                                        name="ExterniVazby[@i].PredpokladanaCena"
                                        value="@estimatedPriceValue"
                                        step="0.01"
                                        min="0"
                                        inputmode="decimal"
                                        data-external-price-input
                                        @(showEstimatedPrice ? null : "disabled")></gov-form-input>
                    </label>

                    <div class="external-field-vyzva" data-external-vyzvy-switch-wrap
                         @(isPnf ? null : "hidden=\"hidden\"")>
                        <span class="external-field-label">Výzva</span>
                        <input type="hidden" name="ExterniVazby[@i].VyzvaId" value="@vazba.VyzvaId" />
                        <input type="hidden" name="ExterniVazby[@i].ZaradidDoVyzvy" value="@(vazba.ZaradidDoVyzvy ? "true" : "false")" data-external-vyzvy-switch-state />
                        <gov-form-switch size="m"
                                         data-vyzvy-switch
                                         data-externi-odkaz-id="@vazba.Id"
                                         @(vazba.ZaradidDoVyzvy ? "checked" : null)>
                            <span slot="label"><label>Zařadit</label></span>
                        </gov-form-switch>
                        <span class="vyzvy-switch-status" data-vyzvy-switch-status>@statusText</span>
                    </div>

                    @* 7c: harvest UI (chat + 4 datumy) skryté v návrhu založení — skutečnost až po založení. *@
                    @if (!Model.HideExternalHarvestUi)
                    {
                    <div class="external-action-chat">
                        <pm-button variant="Secondary" size="Small" data-external-chat-open="true"
                                   data-external-odkaz-id="@vazba.Id"
                                   data-external-zaznam-id="@Model.Id"
                                   title="Vyjádření a termíny"
                                   aria-label="Vyjádření a termíny"
                                   disabled="@(!chatEnabled)">
                            <gov-icon size="s" name="chat-left-text" type="components" aria-hidden="true"></gov-icon>
                        </pm-button>
                    </div>
                    }

                    @* FIX 2026-05-05 (revert 2026-05-04): 4 datumy jsou READ-ONLY display.
                       User je needituje — auto-fill harvest (PerTicketMetadataSyncService) je
                       jediný zdroj pravdy. Save flow nesmí 4 datumy přepsat z form (žádný hidden
                       input → form binder posílá null → SaveRecord respektuje pattern "preserve
                       existing values, pokud nic ze SD harvestu, zůstává null").
                       sync.js po user zadání čísla tiketu fetchne preview 4 datumů z HOT_ZAZNAMY
                       a updatuje text těchto spanů (ne form input).
                       Prázdné datumy ukazují ikonu kalendáře (placeholder, user požadavek 2026-04-27). *@
                    @if (!Model.HideExternalHarvestUi)
                    {
                    <div class="external-dates external-dates-readonly" data-external-dates @(ticketResolved ? null : "hidden=\"hidden\"")>
                        <div class="external-date-item">
                            <span class="label">Datum objednání</span>
                            @if (datumObjednani is not null)
                            {
                                <span class="value" data-external-datum-objednani>@datumObjednani</span>
                            }
                            else
                            {
                                <span class="value placeholder" data-external-datum-objednani>
                                    <gov-icon size="s" name="calendar3" type="components" aria-hidden="true"></gov-icon>
                                </span>
                            }
                        </div>
                        <div class="external-date-item">
                            <span class="label">Plán dodání</span>
                            @if (planDodani is not null)
                            {
                                <span class="value" data-external-datum-plan-dodani>@planDodani</span>
                            }
                            else
                            {
                                <span class="value placeholder" data-external-datum-plan-dodani>
                                    <gov-icon size="s" name="calendar3" type="components" aria-hidden="true"></gov-icon>
                                </span>
                            }
                        </div>
                        <div class="external-date-item">
                            <span class="label">Datum dodání</span>
                            @if (datumDodani is not null)
                            {
                                <span class="value" data-external-datum-dodani>@datumDodani</span>
                            }
                            else
                            {
                                <span class="value placeholder" data-external-datum-dodani>
                                    <gov-icon size="s" name="calendar3" type="components" aria-hidden="true"></gov-icon>
                                </span>
                            }
                        </div>
                        <div class="external-date-item">
                            <span class="label">Datum převzetí</span>
                            @if (datumPrevzeti is not null)
                            {
                                <span class="value" data-external-datum-prevzeti>@datumPrevzeti</span>
                            }
                            else
                            {
                                <span class="value placeholder" data-external-datum-prevzeti>
                                    <gov-icon size="s" name="calendar3" type="components" aria-hidden="true"></gov-icon>
                                </span>
                            }
                        </div>
                    </div>
                    }

                    <div class="external-action-trash">
                        <pm-button variant="Secondary" size="Small" data-external-remove="true"
                                   title="Odebrat vazbu"
                                   aria-label="Odebrat vazbu">
                            <gov-icon size="s" name="trash3" type="components" aria-hidden="true"></gov-icon>
                        </pm-button>
                    </div>
                </div>
            }
        </div>

        <template data-external-template>
            <div class="external-row" data-external-row>
                <input type="hidden" name="ExterniVazby[__index__].Id" value="0" />
                <input type="hidden" name="ExterniVazby[__index__].Typ" value="" data-external-type-hidden />

                <label class="external-field-cislo">
                    <span class="external-field-label">Číslo</span>
                    <gov-form-input size="m"
                                    name="ExterniVazby[__index__].Cislo"
                                    value=""
                                    maxlength="6"
                                    pattern="[0-9]{6}"
                                    inputmode="numeric"
                                    data-external-cislo
                                    data-external-odkaz-id="0"></gov-form-input>
                </label>

                <div class="external-field-typ">
                    <span class="external-field-label">Typ</span>
                    <gov-tag size="s" type="subtle" color="neutral" data-external-type-display>—</gov-tag>
                </div>

                <label class="external-field-cena" data-external-price-field hidden="hidden">
                    <span class="external-field-label">Předpokládaná cena</span>
                    <gov-form-input size="m"
                                    input-type="number"
                                    name="ExterniVazby[__index__].PredpokladanaCena"
                                    value=""
                                    step="0.01"
                                    min="0"
                                    inputmode="decimal"
                                    data-external-price-input
                                    disabled></gov-form-input>
                </label>

                <div class="external-field-vyzva" data-external-vyzvy-switch-wrap hidden="hidden">
                    <span class="external-field-label">Výzva</span>
                    <input type="hidden" name="ExterniVazby[__index__].VyzvaId" value="" />
                    <input type="hidden" name="ExterniVazby[__index__].ZaradidDoVyzvy" value="false" data-external-vyzvy-switch-state />
                    <gov-form-switch size="m" data-vyzvy-switch data-externi-odkaz-id="">
                        <span slot="label"><label>Zařadit</label></span>
                    </gov-form-switch>
                    <span class="vyzvy-switch-status" data-vyzvy-switch-status></span>
                </div>

                @* 7c: harvest UI skryté v návrhu založení (nové řádky šablony). *@
                @if (!Model.HideExternalHarvestUi)
                {
                <div class="external-action-chat">
                    <pm-button variant="Secondary" size="Small" data-external-chat-open="true"
                               data-external-odkaz-id="0"
                               data-external-zaznam-id="@Model.Id"
                               title="Vyjádření a termíny"
                               aria-label="Vyjádření a termíny"
                               disabled="true">
                        <gov-icon size="s" name="chat-left-text" type="components" aria-hidden="true"></gov-icon>
                    </pm-button>
                </div>

                @* FIX 2026-05-05: read-only 4 datumy. Klient template; sync.js po sync response
                   nahradí placeholder span s ikonou za span s textem datumu (přes setDateFieldValue). *@
                <div class="external-dates external-dates-readonly" data-external-dates hidden="hidden">
                    <div class="external-date-item">
                        <span class="label">Datum objednání</span>
                        <span class="value placeholder" data-external-datum-objednani>
                            <gov-icon size="s" name="calendar3" type="components" aria-hidden="true"></gov-icon>
                        </span>
                    </div>
                    <div class="external-date-item">
                        <span class="label">Plán dodání</span>
                        <span class="value placeholder" data-external-datum-plan-dodani>
                            <gov-icon size="s" name="calendar3" type="components" aria-hidden="true"></gov-icon>
                        </span>
                    </div>
                    <div class="external-date-item">
                        <span class="label">Datum dodání</span>
                        <span class="value placeholder" data-external-datum-dodani>
                            <gov-icon size="s" name="calendar3" type="components" aria-hidden="true"></gov-icon>
                        </span>
                    </div>
                    <div class="external-date-item">
                        <span class="label">Datum převzetí</span>
                        <span class="value placeholder" data-external-datum-prevzeti>
                            <gov-icon size="s" name="calendar3" type="components" aria-hidden="true"></gov-icon>
                        </span>
                    </div>
                </div>
                }

                <div class="external-action-trash">
                    <pm-button variant="Secondary" size="Small" data-external-remove="true"
                               title="Odebrat vazbu"
                               aria-label="Odebrat vazbu">
                        <gov-icon size="s" name="trash3" type="components" aria-hidden="true"></gov-icon>
                    </pm-button>
                </div>
            </div>
        </template>

        <pm-button variant="Secondary" data-external-add="true">Přidat externí vazbu</pm-button>
    </div>
</pm-tab-panel>
