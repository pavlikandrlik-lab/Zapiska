@model ProjectModalViewModel
@{
    Layout = "_ModalLayout";
    ViewData["ModalTitleId"] = "project-modal-title";
}

<h2 id="project-modal-title">@Model.Title</h2>

<form class="form-grid"
      asp-controller="Projekty"
      asp-action="SaveProject"
      method="post"
      data-ajax-submit="true">
    @if (Model.Command.Id.HasValue)
    {
        <input type="hidden" name="Id" value="@Model.Command.Id.Value" />
    }
    <label>
        Název (celý)
        <input type="text" name="Nazev" value="@Model.Command.Nazev" required />
    </label>
    <label>
        Zkratka
        <input type="text" name="Zkratka" value="@Model.Command.Zkratka" required />
    </label>
    <label>
        Stav
        <select name="Stav" required>
            @foreach (var stav in Model.StavyProjektu)
            {
                var selected = string.Equals(stav.Value, Model.Command.Stav, StringComparison.OrdinalIgnoreCase);
                <option value="@stav.Value" selected="@selected">@stav.Label</option>
            }
        </select>
    </label>
    <label class="gov-switch">
        <input type="checkbox" name="PouzivatIdentJednani" value="true" @((Model.Command.PouzivatIdentJednani) ? "checked=\"checked\"" : null) />
        <span class="gov-switch-track" aria-hidden="true">
            <span class="gov-switch-thumb"></span>
        </span>
        <span class="gov-switch-label">Používat identifikátor záznamů podle jednání (808-1)</span>
    </label>
    <label>
        Místo plnění (pro generování výzev)
        <textarea name="MistoPlneni" rows="2" maxlength="500"
                  placeholder="např. FIS (EIS): VZ 8201, Tychonova 1, 160 01 Praha 6">@Model.Command.MistoPlneni</textarea>
    </label>
    <label>
        Číslo rámcové smlouvy (pro generování výzev)
        <input type="text" name="CisloRamcoveSmlouvy" maxlength="100"
               placeholder="např. 23106000271" value="@Model.Command.CisloRamcoveSmlouvy" />
    </label>

    @await Html.PartialAsync(
        "_ModalFormActions",
        new ModalFormActionsViewModel
        {
            SubmitLabel = Model.IsEdit ? "Uložit změny" : "Uložit"
        })
</form>
