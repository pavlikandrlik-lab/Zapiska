@model ProjektyIndexViewModel
@{
    ViewData["Title"] = "Projekty";
    ViewData["BodyClass"] = "dashboard-page";
    var canHideDone = Model.StavyProjektu.Any(x => string.Equals(x.Value, "DONE", StringComparison.OrdinalIgnoreCase));
    var canHideDeleted = Model.StavyProjektu.Any(x => string.Equals(x.Value, "DELETED", StringComparison.OrdinalIgnoreCase));
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Title = Model.PageTitle,
    Subtitle = "Přehled projektů dostupných pro přihlášeného uživatele.",
    BackUrl = Model.BackUrl,
    BackLabel = Model.BackLabel
})

<div class="projects-header-actions">
    @if (Model.CanCreate)
    {
        <pm-button variant="Primary" data-modal-url="@Url.Action("NewProjectModal", "Projekty")">Nový projekt</pm-button>
    }
    @if (canHideDone || canHideDeleted)
    {
        <button class="filter-toggle project-filter-toggle"
                type="button"
                data-project-status-filter-toggle
                aria-expanded="false"
                aria-controls="project-status-filter-panel">
            <span>Filtry</span>
            <span class="filter-icon" aria-hidden="true">
                <gov-icon size="s" name="funnel" type="components" aria-hidden="true"></gov-icon>
            </span>
        </button>
        <div class="projects-status-filters-panel" id="project-status-filter-panel" data-project-status-filter-panel hidden>
            @if (canHideDone)
            {
                <gov-form-switch size="m" data-project-status-hide="DONE">
                    <span slot="label"><label>Skrýt hotové</label></span>
                </gov-form-switch>
            }
            @if (canHideDeleted)
            {
                <gov-form-switch size="m" data-project-status-hide="DELETED">
                    <span slot="label"><label>Skrýt smazané</label></span>
                </gov-form-switch>
            }
        </div>
    }
</div>

<section class="project-list-shell" data-project-list-shell>
    <section class="project-grid" data-project-grid>
        @foreach (var projekt in Model.Projekty)
        {
            <article class="project-card"
                     data-project-list-row
                     data-href="@Url.Action("Detail", new { id = projekt.Id })"
                     data-project-status="@projekt.StavKod"
                     data-project-status-code="@projekt.StavKod"
                     role="link"
                     tabindex="0">
                <div class="project-card-header">
                    <div>
                        <div class="project-code">@projekt.Zkratka</div>
                        <h2>@projekt.Nazev</h2>
                    </div>
                    <span class="badge">@projekt.Stav</span>
                </div>
                <div class="project-card-actions" data-stop-propagation="true">
                    @if (projekt.CanEdit)
                    {
                        <pm-button variant="Secondary" size="Small" data-modal-url="@Url.Action("EditProjectModal", "Projekty", new { id = projekt.Id })">Upravit</pm-button>
                    }
                    @if (projekt.CanDelete)
                    {
                        <pm-button variant="Ghost" size="Small" data-modal-url="@Url.Action("DeleteProjectModal", "Projekty", new { id = projekt.Id })">Smazat</pm-button>
                    }
                </div>
            </article>
        }
    </section>

    <p class="muted projects-status-empty" data-project-grid-empty hidden>Žádné projekty neodpovídají zvolenému filtru.</p>
</section>
