@using System.Globalization
@model ZaznamEditViewModel
@{
    var schedulePermissionMode = Model.CanEditScheduleFull
        ? "full"
        : (Model.CanEditScheduleAddOnly ? "add" : "none");
    var canUseBasicTabs = Model.CanEditRecord || Model.IsProposalEditor || Model.IsProposalDecisionDetail;
    var defaultEditorTab = string.Equals(Model.ActiveEditorTab, "schedule", StringComparison.OrdinalIgnoreCase) && Model.JeUkolKategorie
        ? "schedule"
        : "basic";
    var requiresMeetingForNumber = Model.IsCreate && Model.PouzivatIdentJednani;
    var createBlockedByMissingMeeting = requiresMeetingForNumber && !Model.MaDostupneJednaniProCislo;
    var deleteFallbackTab = string.Equals(defaultEditorTab, "schedule", StringComparison.OrdinalIgnoreCase)
        ? "harmonogram"
        : "zaznamy";
    var deleteRecordModalUrl = !Model.IsCreate && Model.CanEditRecord
        ? Url.Action("DeleteRecordModal", "Zaznamy", new
        {
            projektId = Model.ProjektId,
            zaznamId = Model.Id,
            returnUrl = Model.ReturnUrl,
            tab = deleteFallbackTab,
            uiContext = "page"
        })
        : null;

    // Task 6 (2026-10-12): rezim master switch — podbarvení na detailu návrhu (ProposalChangesHarmonogramRezim)
    // a původní stav v editoru návrhu (data-record-rezim-original pro rezim-master-switch.js). Razor
    // nevynechá data-* s null hodnotou → atribut se skládá ručně (global-constraints.md).
    var rezimSwitchClass = "record-editor-tabs-rezim-switch"
        + (Model.IsProposalDecisionDetail && Model.ProposalChangesHarmonogramRezim ? " proposal-field-changed" : "");
    var rezimOriginalAttr = Model.IsSchedulePlanProposalEditor
        ? $"data-record-rezim-original=\"{(Model.HarmonogramAutoFillSwitchOn ? "Auto" : "Manual")}\""
        : "";

    // Lego pm-tabs architecture: filtrujeme jen viditelné taby a per-pozice volíme tag
    // (pm-tab-left | pm-tab | pm-tab-right). Skryté taby v markupu vůbec nejsou —
    // disabled/hidden tab znemožňoval správné vykreslení outer rohů sousedů.
    var editorTabs = new List<(string Key, string Label, string DataAttrs)>();
    if (canUseBasicTabs)
    {
        editorTabs.Add(("basic", "Základní údaje", "data-record-modal-tab=\"basic\""));
        if (Model.ShowExternalTab)
        {
            editorTabs.Add(("external", "Externí vazby", "data-record-modal-tab=\"external\""));
        }
        if (Model.ShowCollaborationTab)
        {
            editorTabs.Add(("collaboration", "Spolupráce", "data-record-modal-tab=\"collaboration\""));
        }
    }
    // 7d (2026-06-17): v CREATE editoru (klasik i návrh založení) renderujeme harmonogram tab
    // VŽDY (kategorie se vybírá; tab nelze do markupu dynamicky vkládat kvůli rohům pm-tabs).
    // Panel sám zobrazí pro ne-úkol poznámku „dostupné jen pro úkol"; JS odhalí vstupy po výběru úkol.
    if (Model.JeUkolKategorie || Model.IsCreate)
    {
        editorTabs.Add(("schedule", "Harmonogram", "data-record-modal-tab=\"schedule\" data-record-schedule-tab"));
    }

    string EditorTabTagFor(int index, int total) =>
        total == 1 ? "pm-tab-left"
        : index == 0 ? "pm-tab-left"
        : index == total - 1 ? "pm-tab-right"
        : "pm-tab";
}

@* A8 (2026-07-09): data-record-editor-presentation="page" — editor je výhradně stránkový
   (jediný konzument = EditZaznamPage). Atribut je podmínkou outbound-guardu
   (bootstrap.maybeGuardOutboundNavigation) i history trapu (historyTrap.js) — bez něj
   byly OBA mrtvé (selektor nematchoval). Pozn.: Razor komentář NESMÍ být uvnitř tagu
   s TagHelpery — spolkl by následující atribut.
   B3 (2026-07-09): data-record-editor-guard="off" na detailu návrhu (IsProposalDecisionDetail)
   — rozhodovací stránka nemá koncept rozpracovanosti; historyTrap se nearmuje a
   promptRecordEditorDiscard propouští bez dialogu. *@
<form class="form-grid record-editor-form"
      asp-controller="@Model.FormController"
      asp-action="@Model.FormAction"
      method="post"
      data-ajax-submit="@(Model.UseAjaxSubmit ? "true" : "false")"
      data-record-editor-form="true"
      data-record-editor-presentation="page"
      data-record-editor-guard="@(Model.IsProposalDecisionDetail ? "off" : "on")"
      data-record-editor-back-url="@Model.BackUrl"
      data-record-editor-project-id="@Model.ProjektId"
      data-record-owner-autofill="true"
      data-record-form-tabs="true"
      data-record-schedule-form="true"
      data-schedule-permission-mode="@schedulePermissionMode"
      data-metadata-locked="@(Model.AllowBasicMetadataEdit ? "false" : "true")"
      data-is-proposal-editor="@(Model.IsProposalEditor ? "true" : "false")"
      data-is-create="@(Model.IsCreate ? "true" : "false")">
    <input type="hidden" name="Id" value="@(Model.IsCreate ? null : Model.Id)" />
    <input type="hidden" name="ProjektId" value="@Model.ProjektId" />
    <input type="hidden" name="CisloZaznamu" value="@Model.CisloZaznamu" />
    <input type="hidden" name="RecordVersion" value="@Model.RecordVersion" />
    <input type="hidden" name="EditorTab" value="@defaultEditorTab" data-record-active-tab-input />
    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
    <input type="hidden" name="UiContext" value="@Model.UiContext" />
    <input type="hidden" name="MeetingId" value="@(Model.MeetingId?.ToString(CultureInfo.InvariantCulture))" />
    @if (Model.ProposalId.HasValue)
    {
        <input type="hidden" name="ProposalId" value="@Model.ProposalId.Value" />
    }

    @* pm-tabs Web Component — system-wide tabs (defined in /js/components/pmTabs.js).
       Aktivní tab je inicializován z defaultEditorTab (server-side); JS následně
       respektuje URL hash (#pmtab-record-edit=schedule) pro persistenci přes reload.
       sync-input="EditorTab" zrcadlí active key do skrytého inputu pro form binding.
       Schedule-specific behaviors (planner recalc) jsou navázané na pm-tab-change event
       v recordEditor/form.js.

       Backward-compat data atributy (data-record-modal-tab, data-record-modal-panel)
       zůstávají zachované pro JS, který panely vyhledává přímo (např. schedule planner). *@
    @* FIX 2026-05-03: master switch "Automatické vyplňování harmonogramu" napravo v tab řádku.
       ON = všechny kroky harmonogramu v Auto rezimu (sync ze ServiceDesk).
       OFF = všechny kroky v Manual rezimu (uživatel vyplňuje datumy ručně).
       JS (rezim-master-switch.js) nastaví hidden input HarmonogramRezim; rezim se
       persistuje při Save (SaveRecord ho aplikuje na krok řádky), ne přes zvláštní endpoint. *@
    @* Form-level notice — zámek harmonogramu kvůli čekajícímu návrhu. Na vrchu formuláře
       (nad záložkami), viditelný bez ohledu na aktivní záložku — ne pohřbený uprostřed
       basic panelu pod popisem (2026-06-29). *@
    @if (Model.HasPendingScheduleProposalLock && !string.IsNullOrWhiteSpace(Model.PendingScheduleProposalMessage))
    {
        <gov-message color="warning">
            @Model.PendingScheduleProposalMessage
        </gov-message>
    }

    @* Task 4 (2026-10-12): sdělení autora návrhu na detailu schvalování — nad záložkami, vždy
       viditelné. ProposalAuthorMessage null = starší návrh bez pole i návrh beze sdělení. *@
    @if (Model.IsProposalDecisionDetail && Model.ShowProposalAuthorMessage)
    {
        <section class="record-proposal-author-message" data-proposal-author-message aria-labelledby="proposal-author-message-title">
            <h3 id="proposal-author-message-title">Sdělení autora návrhu</h3>
            <p class="muted">@Model.ProposalAuthorName@(Model.ProposalCreatedAtLocal is DateTime vytvoreno ? $" · {vytvoreno:dd.MM.yyyy HH:mm}" : "")</p>
            @if (!string.IsNullOrWhiteSpace(Model.ProposalAuthorMessage))
            {
                <p class="record-proposal-author-message-text" data-proposal-author-message-text>@Model.ProposalAuthorMessage</p>
            }
            else
            {
                <p class="muted" data-proposal-author-message-empty>Autor důvod změny neuvedl.</p>
            }
        </section>
    }

    @* Task 6 (2026-10-12): upozornění, že návrh mění přepínač „Automatické vyplňování
       harmonogramu" proti aktuálnímu stavu záznamu. Atributy infobaru rozhodnuté uživatelem
       (global-constraints.md): color="error" type="bold" closable="false" +
       components/exclamation-triangle-fill.
       Review fix M3 (2026-10-12): gate na ProposalRezimChangeMessage, ne na
       ProposalChangesHarmonogramRezim — starší čekající návrhy (bez ChangesHarmonogramRezim)
       mohou nést ruční data pro auto-eligible kroky a infobar se musí zobrazit i beze změny
       přepínače (BuildProposalDetailAsync nastaví zprávu, ale ne ProposalChangesHarmonogramRezim). *@
    @if (Model.IsProposalDecisionDetail && !string.IsNullOrWhiteSpace(Model.ProposalRezimChangeMessage))
    {
        <gov-infobar color="error" type="bold" closable="false" data-proposal-rezim-infobar>
            <gov-icon slot="icon" type="components" name="exclamation-triangle-fill"></gov-icon>
            @Model.ProposalRezimChangeMessage
        </gov-infobar>
    }

    <div class="record-editor-tabs-row" data-record-editor-tabs-row>
    <pm-tabs persist="hash"
             persist-key="record-edit"
             sync-input="EditorTab"
             initial="@defaultEditorTab">
        <pm-tab-list data-record-modal-tabs>
            @for (int i = 0; i < editorTabs.Count; i++)
            {
                var et = editorTabs[i];
                var tagName = EditorTabTagFor(i, editorTabs.Count);
                @Html.Raw($"<{tagName} key=\"{et.Key}\" {et.DataAttrs}>{et.Label}</{tagName}>")
            }
        </pm-tab-list>

        @await Html.PartialAsync("~/Views/Projekty/_EditZaznamBasicPanel.cshtml", Model)

        @if (Model.ShowExternalTab)
        {
            @await Html.PartialAsync("~/Views/Projekty/_EditZaznamExternalPanel.cshtml", Model)
        }

        @if (Model.ShowCollaborationTab)
        {
            @await Html.PartialAsync("~/Views/Projekty/_EditZaznamCollaborationPanel.cshtml", Model)
        }

        @if (Model.JeUkolKategorie || Model.IsCreate)
        {
            @await Html.PartialAsync("~/Views/Projekty/_EditZaznamSchedulePanel.cshtml", Model)
        }
    </pm-tabs>
    @if ((Model.JeUkolKategorie || Model.IsCreate) && !Model.HarmonogramBlok.HideActual)
    {
        @* Master switch — automatické vs ruční vyplňování harmonogramu pro celý záznam.
           Initial state: ON pokud existují krok řádky a všechny v Auto rezimu, OFF jinak.
           Pro nový záznam (IsCreate) defaultně ON (auto-fill je standardní flow).
           FIX 2026-05-04: switch je čistě klient-side. Server-side persistence přes hidden
           input HarmonogramRezim při Save form submitu (transactional s datumy v jednom POST). *@
        @* C3 (2026-07-10): na schvalování návrhu (IsProposalDecisionDetail) je switch
           read-only — pravidlo „vše read-only, žádný editovatelný prvek". Stav zůstává
           viditelný (schvalovatel má vidět Auto/Manual režim).
           Task 6 (2026-10-12): v editoru návrhu nese data-record-rezim-original (původní stav
           na záznamu) — rezim-master-switch.js ho porovná s aktuálním přepnutím a podbarví
           přepínač stejně jako ostatní změněná pole návrhu; na detailu je podbarvený rovnou,
           když návrh režim mění (ProposalChangesHarmonogramRezim). Razor nevynechá data-*
           s null hodnotou — atribut se skládá ručně (global-constraints.md). *@
        <gov-form-switch size="m"
                         class="@rezimSwitchClass"
                         data-record-rezim-switch
                         data-record-zaznam-id="@Model.Id"
                         data-record-projekt-id="@Model.ProjektId"
                         @Html.Raw(rezimOriginalAttr)
                         disabled="@(Model.IsProposalDecisionDetail ? "disabled" : null)"
                         @(Model.HarmonogramAutoFillSwitchOn ? "checked" : null)>
            <span slot="label"><label>Automatické vyplňování harmonogramu</label></span>
        </gov-form-switch>
        <input type="hidden"
               name="HarmonogramRezim"
               value="@(Model.HarmonogramAutoFillSwitchOn ? "Auto" : "Manual")"
               data-record-rezim-form />
    }
    </div>

    @* Task 3 (2026-10-12): nepovinné sdělení autora návrhu schvalovateli. Jen v editoru návrhu
       změny termínu a harmonogramu; mimo záložky, aby bylo vidět na Základní i Harmonogram. *@
    @if (Model.IsSchedulePlanProposalEditor)
    {
        <div class="record-form-row record-proposal-reason" data-record-proposal-reason>
            <label for="duvodZmeny">
                Důvod změny (volitelné)
                <textarea id="duvodZmeny"
                          name="DuvodZmeny"
                          rows="3"
                          maxlength="@SaveRecordCommand.DuvodZmenyMaxLength"></textarea>
            </label>
            <p class="muted record-proposal-reason-hint">Uvidí ho schvalovatel návrhu. Po schválení se uloží do historie termínu.</p>
        </div>
    }

    @* 7e (2026-06-17): akční tlačítka jsou v jednom řádku u sebe („Zrušit a vrátit se" +
       primární/rozhodovací tlačítka). Vysvětlující texty (SecondaryNote / ProposalSummaryNote)
       jsou pod tlačítky jako poznámka pod čarou, ne mezi tlačítky. *@
    <div class="record-editor-actions">
        <div class="record-editor-actions-buttons">
            @if (!Model.IsProposalEditor && !Model.IsProposalDecisionDetail && !Model.IsCreate && !string.IsNullOrWhiteSpace(deleteRecordModalUrl))
            {
                <pm-button variant="Destructive"
                           data-modal-url="@deleteRecordModalUrl">
                    Smazat natrvalo
                </pm-button>
            }
            <pm-button variant="Secondary"
                       native-type="button"
                       data-record-editor-cancel="true"
                       data-record-editor-back-url="@Model.BackUrl">
                Zrušit a vrátit se
            </pm-button>
            @if (Model.IsProposalDecisionDetail)
            {
                @if (Model.CanApproveProposal)
                {
                    <pm-button variant="Primary"
                               native-type="submit"
                               formaction="@Url.Action("ApproveProposal", "Navrhy")"
                               formmethod="post">
                        Schválit
                    </pm-button>
                }
                @if (Model.CanRejectProposal)
                {
                    <pm-button variant="Secondary"
                               native-type="submit"
                               formaction="@Url.Action("RejectProposal", "Navrhy")"
                               formmethod="post">
                        Zamítnout
                    </pm-button>
                }
                @if (Model.CanRejectAndTakeOverProposal)
                {
                    <pm-button variant="Secondary"
                               native-type="submit"
                               formaction="@Url.Action("RejectAndTakeOverCreateProposal", "Navrhy")"
                               formmethod="post">
                        Zamítnout a převzít data
                    </pm-button>
                }
                @if (Model.CanRejectAndEditProposal)
                {
                    <pm-button variant="Secondary"
                               native-type="submit"
                               formaction="@Url.Action("RejectAndEditProposal", "Navrhy")"
                               formmethod="post">
                        Zamítnout a upravit
                    </pm-button>
                }
                @* Tlačítko „Předvyplnit formulář" (→ EditFromProposal bypass) smazáno 2026-04-23.
                   Admin, který chce „přijmout s úpravou": ApproveProposal + standardní Edit záznamu. *@
            }
            else
            {
                <pm-button variant="Primary"
                           native-type="submit"
                           disabled="@createBlockedByMissingMeeting">
                    @(!string.IsNullOrWhiteSpace(Model.PrimaryActionLabel)
                        ? Model.PrimaryActionLabel
                        : (Model.IsCreate ? "Založit a vrátit se do projektu" : "Uložit a vrátit se do projektu"))
                </pm-button>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.SecondaryNote))
        {
            <p class="muted record-editor-footnote">@Model.SecondaryNote</p>
        }
        @if (Model.IsProposalDecisionDetail && !string.IsNullOrWhiteSpace(Model.ProposalSummaryNote))
        {
            <p class="muted record-editor-footnote">@Model.ProposalSummaryNote</p>
        }
    </div>
</form>
