@using System.Globalization
@model ProjektNavrhyTabViewModel
@{
    var isActive = ViewData["IsActive"] as bool? ?? false;
}

<section class="tab-panel @(isActive ? "active" : null)" data-tab-panel="navrhy">
    <div class="panel-header">
        <div class="panel-header-actions">
            @if (Model.CanCreateRecordProposal && !string.IsNullOrWhiteSpace(Model.CreateRecordProposalUrl))
            {
                <pm-button variant="Primary"
                           data-record-editor-url="@Model.CreateRecordProposalUrl"
                           data-record-editor-project-id="@Model.ProjektId"
                           data-record-editor-label="Nový návrh založení záznamu">
                    Nový návrh záznamu
                </pm-button>
            }
        </div>
    </div>

    <div class="proposal-section-grid">
        <section class="card">
            <h3>Návrhy založení záznamu</h3>
            @if (Model.NavrhyZalozeni.Count == 0)
            {
                <p class="muted">V této části zatím nejsou žádné návrhy.</p>
            }
            else
            {
                <div class="proposal-list">
                    @foreach (var item in Model.NavrhyZalozeni)
                    {
                        <article class="proposal-card">
                            <div class="proposal-card-header">
                                <div>
                                    <div class="record-title">@(string.IsNullOrWhiteSpace(item.Nazev) ? $"Návrh #{item.Id}" : item.Nazev)</div>
                                    @if (!string.IsNullOrWhiteSpace(item.Cil))
                                    {
                                        <div class="record-subtitle record-goal-subtitle">@item.Cil</div>
                                    }
                                </div>
                                <span class="badge">@item.StavLabel</span>
                            </div>
                            <div class="record-summary-meta">
                                <span><span class="label">Autor:</span> @item.Autor</span>
                                <span><span class="label">Subsystém:</span> @item.Subsystem</span>
                                <span><span class="label">Podáno:</span> @item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm", CultureInfo.InvariantCulture)</span>
                                <span><span class="label">Datum založení:</span> @(item.DatumZalozeni?.ToString("dd.MM.yyyy") ?? "-")</span>
                                <span><span class="label">Termín:</span> @(item.TerminUkonceni?.ToString("dd.MM.yyyy") ?? "-")</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.RozhodlUzivatel) || item.DecidedAt.HasValue)
                            {
                                <div class="record-summary-meta">
                                    <span><span class="label">Rozhodl:</span> @(item.RozhodlUzivatel ?? "-")</span>
                                    <span><span class="label">Kdy:</span> @(item.DecidedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm", CultureInfo.InvariantCulture) ?? "-")</span>
                                </div>
                            }
                            <div class="proposal-card-actions">
                                @if (!string.IsNullOrWhiteSpace(item.DetailUrl))
                                {
                                    <pm-button variant="Secondary"
                                               size="Small"
                                               data-record-editor-url="@item.DetailUrl"
                                               data-record-editor-project-id="@item.ProjektId"
                                               data-record-editor-label="@($"Detail návrhu #{item.Id}")">
                                        Detail návrhu
                                    </pm-button>
                                }
                                @if (item.CanApprove)
                                {
                                    <form asp-controller="Navrhy"
                                          asp-action="ApproveProposal"
                                          method="post"
                                          data-ajax-submit="true">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="ProjektId" value="@item.ProjektId" />
                                        <input type="hidden" name="ProposalId" value="@item.Id" />
                                        <pm-button variant="Primary" size="Small" native-type="submit">Schválit</pm-button>
                                    </form>
                                }
                                @if (item.CanReject)
                                {
                                    <form asp-controller="Navrhy"
                                          asp-action="RejectProposal"
                                          method="post"
                                          data-ajax-submit="true">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="ProjektId" value="@item.ProjektId" />
                                        <input type="hidden" name="ProposalId" value="@item.Id" />
                                        <pm-button variant="Ghost" size="Small" native-type="submit">Zamítnout</pm-button>
                                    </form>
                                }
                                @if (item.CanRejectAndTakeOver)
                                {
                                    <form asp-controller="Navrhy"
                                          asp-action="RejectAndTakeOverCreateProposal"
                                          method="post"
                                          data-ajax-submit="true">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="ProjektId" value="@item.ProjektId" />
                                        <input type="hidden" name="ProposalId" value="@item.Id" />
                                        <pm-button variant="Secondary" size="Small" native-type="submit">Zamítnout a převzít data</pm-button>
                                    </form>
                                }
                                @if (item.CanPrefillCreateForm
                                     && !string.Equals(item.Stav, RecordProposalStateCodes.Pending, StringComparison.OrdinalIgnoreCase)
                                     && !string.IsNullOrWhiteSpace(item.PrefillCreateFormUrl))
                                {
                                    <pm-button variant="Secondary"
                                               size="Small"
                                               data-record-editor-url="@item.PrefillCreateFormUrl"
                                               data-record-editor-project-id="@item.ProjektId"
                                               data-record-editor-label="@($"Předvyplnit formulář z návrhu #{item.Id}")">
                                        Předvyplnit formulář
                                    </pm-button>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="card">
            <h3>Návrhy změny termínu a harmonogramu</h3>
            @if (Model.NavrhyHarmonogramu.Count == 0)
            {
                <p class="muted">V této části zatím nejsou žádné návrhy.</p>
            }
            else
            {
                <div class="proposal-list">
                    @foreach (var item in Model.NavrhyHarmonogramu)
                    {
                        <article class="proposal-card">
                            <div class="proposal-card-header">
                                <div>
                                    <div class="record-title">
                                        @if (!string.IsNullOrWhiteSpace(item.CisloViditelne))
                                        {
                                            <text>#@item.CisloViditelne - </text>
                                        }
                                        @(string.IsNullOrWhiteSpace(item.Nazev) ? $"Záznam #{item.ZaznamId}" : item.Nazev)
                                    </div>
                                </div>
                                <span class="badge">@item.StavLabel</span>
                            </div>
                            <div class="record-summary-meta">
                                <span><span class="label">Autor:</span> @item.Autor</span>
                                <span><span class="label">Subsystém:</span> @item.Subsystem</span>
                                <span><span class="label">Podáno:</span> @item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm", CultureInfo.InvariantCulture)</span>
                                <span><span class="label">Nový termín:</span> @(item.TerminUkonceni?.ToString("dd.MM.yyyy") ?? "-")</span>
                                <span><span class="label">Plánované kroky:</span> @item.PlannedStepCount</span>
                                <span><span class="label">Skutečnost:</span> @item.ActualStepCount</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.RozhodlUzivatel) || item.DecidedAt.HasValue)
                            {
                                <div class="record-summary-meta">
                                    <span><span class="label">Rozhodl:</span> @(item.RozhodlUzivatel ?? "-")</span>
                                    <span><span class="label">Kdy:</span> @(item.DecidedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm", CultureInfo.InvariantCulture) ?? "-")</span>
                                </div>
                            }
                            <div class="proposal-card-actions">
                                @if (!string.IsNullOrWhiteSpace(item.DetailUrl))
                                {
                                    <pm-button variant="Secondary"
                                               size="Small"
                                               data-record-editor-url="@item.DetailUrl"
                                               data-record-editor-project-id="@item.ProjektId"
                                               data-record-editor-label="@($"Detail návrhu #{item.Id}")">
                                        Detail návrhu
                                    </pm-button>
                                }
                                @if (item.CanApprove)
                                {
                                    <form asp-controller="Navrhy"
                                          asp-action="ApproveProposal"
                                          method="post"
                                          data-ajax-submit="true">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="ProjektId" value="@item.ProjektId" />
                                        <input type="hidden" name="ProposalId" value="@item.Id" />
                                        <pm-button variant="Primary" size="Small" native-type="submit">Schválit</pm-button>
                                    </form>
                                }
                                @if (item.CanReject)
                                {
                                    <form asp-controller="Navrhy"
                                          asp-action="RejectProposal"
                                          method="post"
                                          data-ajax-submit="true">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="ProjektId" value="@item.ProjektId" />
                                        <input type="hidden" name="ProposalId" value="@item.Id" />
                                        <pm-button variant="Ghost" size="Small" native-type="submit">Zamítnout</pm-button>
                                    </form>
                                }
                                @if (item.CanRejectAndEdit)
                                {
                                    <form asp-controller="Navrhy"
                                          asp-action="RejectAndEditProposal"
                                          method="post"
                                          data-ajax-submit="true">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="ProjektId" value="@item.ProjektId" />
                                        <input type="hidden" name="ProposalId" value="@item.Id" />
                                        <pm-button variant="Secondary" size="Small" native-type="submit">Zamítnout a upravit</pm-button>
                                    </form>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</section>
