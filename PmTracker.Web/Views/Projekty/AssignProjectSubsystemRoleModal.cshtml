@model AssignProjectSubsystemRoleModalViewModel
@{
    Layout = "_ModalLayout";
    ViewData["ModalTitleId"] = "assign-project-subsystem-role-modal-title";
    ViewData["ModalVariant"] = "wide";
    ViewData["ModalOverflowVisible"] = true;
}

<h2 id="assign-project-subsystem-role-modal-title">@Model.Title</h2>

<form class="form-grid"
      asp-controller="Projekty"
      asp-action="AssignProjectSubsystemRole"
      method="post"
      data-ajax-submit="true">
    <input type="hidden" name="ProjektId" value="@Model.Command.ProjektId" />

    <label>
        Subsystém projektu
        <select name="ProjektSubsystemId" required>
            @foreach (var subsystem in Model.ProjektSubsystemy)
            {
                <option value="@subsystem.ProjektSubsystemId">@subsystem.Label</option>
            }
        </select>
    </label>

    <div class="office-picker"
         data-person-picker="single"
         data-person-picker-placeholder="Vyhledejte osobu podle jména nebo emailu..."
         data-person-picker-empty="Nenalezeny žádné odpovídající osoby.">
        <input type="hidden" name="OsobaId" value="" data-person-picker-hidden required />
        <label class="office-search-label">Osoba</label>
        <div class="office-searchbox" data-floating-anchor>
            <input type="search" autocomplete="off" data-person-picker-input required />
            <div class="office-search-panel" data-person-picker-panel data-floating-panel data-floating-kind="person-search" data-floating-match-width="true" hidden>
                <div class="office-search-results" data-person-picker-results role="listbox" aria-label="Výsledky osob"></div>
            </div>
        </div>
        <div class="person-picker-source" data-person-picker-source hidden>
            @foreach (var osoba in Model.DostupneOsoby)
            {
                <div data-id="@osoba.OsobaId"
                     data-label="@osoba.Osoba"
                     data-email="@(osoba.Email ?? string.Empty)"
                     data-org="@(osoba.Organizace ?? string.Empty)"
                     data-unit="@(osoba.OrganizacniCelek ?? string.Empty)"></div>
            }
        </div>
    </div>

    <label>
        Role subsystému
        <select name="RoleKod" required>
            @foreach (var role in Model.RoleSubsystemu)
            {
                <option value="@role.Value">@role.Label</option>
            }
        </select>
    </label>

    @await Html.PartialAsync("_ModalFormActions", new ModalFormActionsViewModel
    {
        SubmitLabel = "Přiřadit roli"
    })
</form>
