@model AuthzPermissionModalViewModel
@{
    Layout = "_ModalLayout";
    ViewData["ModalTitleId"] = "authz-permission-modal-title";
    var catalogByKey = Model.PermissionCatalog.ToDictionary(x => x.Key, StringComparer.OrdinalIgnoreCase);
    var categoryIdByKod = Model.Categories.ToDictionary(x => x.Kod, x => x.Id, StringComparer.OrdinalIgnoreCase);
}

<h2 id="authz-permission-modal-title">@(Model.IsEdit ? "Upravit akci" : "Nová akce")</h2>

<form class="form-grid"
      asp-controller="Nastaveni"
      asp-action="SavePermission"
      method="post"
      data-ajax-submit="true">
    @if (Model.Command.Id.HasValue)
    {
        <input type="hidden" name="Id" value="@Model.Command.Id.Value" />
    }
    @await Html.PartialAsync(
        "_ContextHiddenFields",
        new ContextHiddenFieldsViewModel
        {
            UserId = Model.UserId,
            ProjektId = Model.ProjektId
        })

    <label>
        Klíč
        <select name="Klic" required data-authz-permission-key>
            <option value="">Vyberte klíč</option>
            @foreach (var key in Model.AvailableKeys)
            {
                var selected = string.Equals(key.Value, Model.Command.Klic, StringComparison.OrdinalIgnoreCase);
                var hasCatalog = catalogByKey.TryGetValue(key.Value, out var catalogEntry);
                var categoryId = hasCatalog && categoryIdByKod.TryGetValue(catalogEntry!.CategoryKod, out var mappedCategoryId)
                    ? mappedCategoryId.ToString()
                    : string.Empty;
                <option value="@key.Value"
                        selected="@selected"
                        data-category-id="@categoryId"
                        data-category-kod="@(hasCatalog ? catalogEntry!.CategoryKod : string.Empty)"
                        data-scope-level="@(hasCatalog ? catalogEntry!.ScopeLevel : string.Empty)"
                        data-description="@(hasCatalog ? catalogEntry!.Popis : string.Empty)">
                    @key.Label
                </option>
            }
        </select>
        <span class="muted permission-key-help" data-authz-permission-help></span>
    </label>

    <label>
        Název
        <input type="text" name="Nazev" value="@Model.Command.Nazev" maxlength="255" required />
    </label>

    <label>
        Kategorie
        <select name="CategoryId" required data-authz-permission-category>
            <option value="">Vyberte kategorii</option>
            @foreach (var category in Model.Categories)
            {
                var selected = category.Id == Model.Command.CategoryId;
                <option value="@category.Id" selected="@selected">@category.Nazev</option>
            }
        </select>
    </label>

    <label>
        Rozsah
        <select name="ScopeLevel" required data-authz-permission-scope>
            <option value="GLOBAL" selected="@("GLOBAL".Equals(Model.Command.ScopeLevel, StringComparison.OrdinalIgnoreCase))">GLOBAL</option>
            <option value="PROJECT" selected="@("PROJECT".Equals(Model.Command.ScopeLevel, StringComparison.OrdinalIgnoreCase))">PROJECT</option>
        </select>
    </label>

    @await Html.PartialAsync("_ModalFormActions", new ModalFormActionsViewModel())
</form>
