@model NastaveniDashboardViewModel
@{
    ViewData["Title"] = "Nastavení";
    ViewData["BodyClass"] = "dashboard-page";
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Title = Model.PageTitle,
    Subtitle = "Správa rolí, oprávnění a mapování přístupů.",
    BackUrl = Model.BackUrl,
    BackLabel = Model.BackLabel
})

@{
    var seedOnlySections = new HashSet<string> { "role", "akce", "role-akce", "uzivatele-role", "efektivni-prava" };
    var isSeedOnlySection = seedOnlySections.Contains(Model.AktivniPanel.SectionKey);
}
@if (isSeedOnlySection)
{
    <pm-alert variant="Info" role="status">
        <strong>Read-only pohled.</strong>
        Role a permission keys jsou definovány v kódu aplikace
        (<code>PermissionSeedConfiguration.cs</code>) a aplikují se při nasazení.
        Přidání nebo změna vyžaduje pull request a deploy.
    </pm-alert>
}

<div class="settings-layout" data-settings-shell data-panel-url="@Url.Action("Panel", "Nastaveni")">
    <aside class="settings-sidebar card">
        <h2>Sekce</h2>
        <nav class="settings-nav" aria-label="Sekce nastavení">
            @foreach (var sekce in Model.Sekce)
            {
                var active = sekce.Key == Model.AktivniPanel.SectionKey;
                <a class="settings-link @(active ? "active" : "")"
                   asp-action="Index"
                   asp-route-section="@sekce.Key"
                   asp-route-userId="@Model.SelectedUserId"
                   asp-route-projektId="@Model.SelectedProjektId"
                   data-settings-link
                   data-key="@sekce.Key"
                   aria-current="@(active ? "page" : null)">
                    <span class="settings-link-title">@sekce.Nazev</span>
                    <span class="settings-link-sub">@sekce.Popis</span>
                    <span class="settings-link-count">@sekce.Pocet</span>
                </a>
            }
        </nav>
    </aside>

    <section class="settings-panel" data-settings-panel>
        @await Html.PartialAsync("_DetailPanel", Model.AktivniPanel)
    </section>
</div>
