@model RolePermissionModalViewModel
@{
    Layout = "_ModalLayout";
    ViewData["ModalTitleId"] = "authz-role-permission-modal-title";
    var selectedProjectIds = Model.Command.ProjektIds
        .Select(x => x.ToString())
        .ToHashSet(StringComparer.Ordinal);
}

<h2 id="authz-role-permission-modal-title">@(Model.IsEdit ? "Upravit mapování role -> akce" : "Nové mapování role -> akce")</h2>

<form class="form-grid"
      asp-controller="Nastaveni"
      asp-action="SaveRolePermission"
      method="post"
      data-ajax-submit="true">
    @if (Model.Command.Id.HasValue)
    {
        <input type="hidden" name="Id" value="@Model.Command.Id.Value" />
    }
    @await Html.PartialAsync(
        "_ContextHiddenFields",
        new ContextHiddenFieldsViewModel
        {
            UserId = Model.UserId,
            ProjektId = Model.ProjektId
        })
    <input type="hidden" name="IsAllowed" value="true" />

    <label>
        Role
        <select name="RoleId" required>
            <option value="">Vyberte roli</option>
            @foreach (var option in Model.RoleOptions)
            {
                var selected = option.Value == Model.Command.RoleId.ToString();
                <option value="@option.Value" selected="@selected">@option.Label</option>
            }
        </select>
    </label>

    <label>
        Akce
        <select name="PermissionId" required>
            <option value="">Vyberte akci</option>
            @foreach (var option in Model.PermissionOptions)
            {
                var selected = option.Value == Model.Command.PermissionId.ToString();
                <option value="@option.Value" selected="@selected">@option.Label</option>
            }
        </select>
    </label>

    <label>
        Rozsah
        <select name="ScopeMode" required>
            <option value="ALL" selected="@("ALL".Equals(Model.Command.ScopeMode, StringComparison.OrdinalIgnoreCase))">ALL</option>
            <option value="INCLUDE" selected="@("INCLUDE".Equals(Model.Command.ScopeMode, StringComparison.OrdinalIgnoreCase))">INCLUDE</option>
        </select>
    </label>

    <label>
        Projekty pro INCLUDE
        <select name="ProjektIds" multiple size="8">
            @foreach (var option in Model.ProjectOptions)
            {
                var selected = selectedProjectIds.Contains(option.Value);
                <option value="@option.Value" selected="@selected">@option.Label</option>
            }
        </select>
    </label>
    <p class="muted">Při režimu ALL se výběr projektů ignoruje.</p>

    @await Html.PartialAsync(
        "_ModalFormActions",
        new ModalFormActionsViewModel
        {
            SubmitLabel = "Uložit mapování"
        })
</form>
