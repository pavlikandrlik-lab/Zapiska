@model IReadOnlyList<PmTracker.Web.Models.ViewModels.PdfAttendanceGroupViewModel>
@if (Model.Count > 0)
{
    <div class="attendance">
        @foreach (var attendanceGroup in Model)
        {
            <div class="attendance-row">
                <div class="attendance-label">@attendanceGroup.Stav:</div>
                <div>@string.Join(", ", attendanceGroup.Osoby)</div>
            </div>
        }
    </div>
}
