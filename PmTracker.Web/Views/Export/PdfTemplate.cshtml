@model PdfExportTemplateViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.DocumentTitle</title>
    <link rel="stylesheet" href="~/css/pdf-export.css" />
</head>
<body>
    <div class="print-sheet">
        <header class="sheet-head">
            <h1 class="sheet-head-title">@Model.DocumentTitle</h1>
            <div class="sheet-head-meta">
                <div><strong>Projekt:</strong> @Model.ProjektNazev (@Model.ProjektZkratka)</div>
                @if (Model.IsMeeting)
                {
                    <div><strong>Jednání:</strong> č. @Model.JednaniCislo</div>
                    <div><strong>Datum:</strong> @Model.JednaniDatum?.ToString("dd.MM.yyyy")</div>
                    <div><strong>Stav:</strong> @Model.JednaniStav</div>
                    <div><strong>Místo:</strong> @(string.IsNullOrWhiteSpace(Model.JednaniMisto) ? "-" : Model.JednaniMisto)</div>
                }
                else
                {
                    <div><strong>Typ výstupu:</strong> @Model.ExportTypeLabel</div>
                }
                <div><strong>Generoval:</strong> @Model.Vytvoril</div>
                <div><strong>Vytvořeno:</strong> @Model.VytvorenoDne.ToString("dd.MM.yyyy HH:mm")</div>
            </div>
            @if (Model.IsProjectSummary)
            {
                <div class="export-summary">
                    <p class="export-summary-text"><strong>Souhrn:</strong> @Model.SnapshotSummary</p>
                    @if (Model.AppliedRuleSummary.Count > 0)
                    {
                        <div>
                            <strong>Použitá pravidla:</strong>
                            <ul class="export-summary-rules">
                                @foreach (var item in Model.AppliedRuleSummary)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            }
            @await Html.PartialAsync("_PdfRolesBlock", Model)
            @await Html.PartialAsync("_PdfAttendanceBlock", Model)
        </header>

        <table class="records-table">
            <colgroup>
                <col class="col-comments" />
                <col class="col-people" />
                <col class="col-deadlines" />
            </colgroup>
            <thead>
                <tr>
                    <th>Záznamy a vyjádření</th>
                    <th>Osoby</th>
                    <th>Termín ukončení</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.SubsystemGroups.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="cell-empty">Žádná data k tisku.</td>
                    </tr>
                }
                else
                {
                    @foreach (var subsystemGroup in Model.SubsystemGroups)
                    {
                        <tr class="subsystem-row">
                            <td colspan="3">Subsystém: @subsystemGroup.Subsystem</td>
                        </tr>

                        foreach (var zaznam in subsystemGroup.Records)
                        {
                            @await Html.PartialAsync("_PdfRecordRow", zaznam)
                        }
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.AutoPrint)
    {
        <script>
            window.addEventListener("load", function () {
                window.setTimeout(function () { window.print(); }, 120);
            });
        </script>
    }
</body>
</html>
