@model JednaniTaskItemPartialViewModel
@inject PmTracker.Web.Services.Common.IRichTextContentService RichTextContentService
@{
    var ukol = Model.Ukol;
    var canAddComment = Model.CanEditRecordNotes || Model.CanCommentAsSubsystemLeader;
}

<div class="task-item" data-task-record-id="@ukol.ZaznamId" data-comment-sort-section data-comment-sort-direction="asc">
    <div class="task-title">#@ukol.CisloViditelne - @ukol.Popis</div>
    @if (ukol.Vyjadreni.Count > 1)
    {
        <div class="record-comments-header compact">
            <pm-button variant="Ghost" size="Small" class="comment-sort-toggle" data-comment-sort-toggle="true">
                Řazení: jednání vzestupně
            </pm-button>
        </div>
    }
    @if (ukol.Vyjadreni.Count == 0)
    {
        <p class="muted">Zatím bez vyjádření k tomuto jednání.</p>
    }
    else
    {
        <div class="comment-list" data-comment-list>
            @foreach (var vyjadreni in ukol.Vyjadreni)
            {
                <div class="comment"
                     data-comment-item
                     data-comment-meeting="@Model.JednaniCislo"
                     data-comment-date="@vyjadreni.Datum.ToString("O")"
                     data-comment-id="@vyjadreni.Id">
                    <div class="comment-header">
                        <strong>@vyjadreni.Autor</strong>
                        <span class="muted">@vyjadreni.Datum.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                    <div class="comment-text richtext-render">@Html.Raw(RichTextContentService.ToSafeHtml(vyjadreni.Text))</div>
                    @{
                        var canEditThisComment = vyjadreni.LzeUpravit &&
                            (Model.CanEditRecordNotes || (vyjadreni.CanEditOwnAsSubsystemLeader && vyjadreni.AutorOsobaId == Model.CurrentUserOsobaId));
                    }
                    @if (canEditThisComment)
                    {
                        <div class="comment-toolbar">
                            <div class="comment-toolbar-actions">
                                <details class="comment-edit-details">
                                    <summary class="comment-action-chip">Upravit</summary>
                                    <form class="comment-edit-form" asp-controller="Zaznamy" asp-action="UpdateComment" method="post" data-ajax-submit="true">
                                        <input type="hidden" name="projektId" value="@Model.ProjektId" />
                                        <input type="hidden" name="meetingId" value="@Model.JednaniId" />
                                        <input type="hidden" name="zaznamId" value="@ukol.ZaznamId" />
                                        <input type="hidden" name="uiContext" value="meeting" />
                                        <input type="hidden" name="Id" value="@vyjadreni.Id" />
                                        <textarea rows="3"
                                                  name="Text"
                                                  required
                                                  data-rich-text="true"
                                                  data-rich-text-min-height="92">@RichTextContentService.ToSafeHtml(vyjadreni.Text)</textarea>
                                        <pm-button variant="Secondary" size="Small" native-type="submit">Uložit změnu</pm-button>
                                    </form>
                                </details>
                                <form class="comment-delete-form comment-delete-form-inline" asp-controller="Zaznamy" asp-action="DeleteComment" method="post" data-ajax-submit="true" onsubmit="return confirm('Opravdu smazat vyjádření?');">
                                    <input type="hidden" name="projektId" value="@Model.ProjektId" />
                                    <input type="hidden" name="meetingId" value="@Model.JednaniId" />
                                    <input type="hidden" name="zaznamId" value="@ukol.ZaznamId" />
                                    <input type="hidden" name="uiContext" value="meeting" />
                                    <input type="hidden" name="Id" value="@vyjadreni.Id" />
                                    <pm-button variant="Ghost" size="Small" native-type="submit">Smazat</pm-button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (canAddComment)
    {
        <form asp-controller="Zaznamy" asp-action="AddComment" method="post" class="meeting-note-add-form" data-ajax-submit="true">
            <input type="hidden" name="projektId" value="@Model.ProjektId" />
            <input type="hidden" name="meetingId" value="@Model.JednaniId" />
            <input type="hidden" name="uiContext" value="meeting" />
            <input type="hidden" name="ZaznamId" value="@ukol.ZaznamId" />
            <input type="hidden" name="JednaniId" value="@Model.JednaniId" />
            <textarea class="meeting-note-input"
                      name="Text"
                      rows="4"
                      placeholder="Přidat vyjádření..."
                      required
                      data-rich-text="true"
                      data-rich-text-min-height="132"></textarea>
            <div class="meeting-notes-actions">
                <pm-button variant="Primary" native-type="submit">Uložit vyjádření</pm-button>
            </div>
        </form>
    }
</div>
