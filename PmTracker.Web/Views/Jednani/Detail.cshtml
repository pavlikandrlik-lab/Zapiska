@model JednaniDetailViewModel
@{
    ViewData["Title"] = "Detail jednání";
    ViewData["BodyClass"] = "dashboard-page";
    var uzavrenyStav = Model.StavyJednani.FirstOrDefault(x => string.Equals(x.Value, Model.UzavrenyStavKod, StringComparison.OrdinalIgnoreCase));
    var otevrenyStav = Model.StavyJednani.FirstOrDefault(x => string.Equals(x.Value, Model.OtevrenyStavKod, StringComparison.OrdinalIgnoreCase));
    var isLocked = !string.IsNullOrWhiteSpace(Model.UzavrenyStavKod)
        && string.Equals(Model.Jednani.StavKod, Model.UzavrenyStavKod, StringComparison.OrdinalIgnoreCase);
    var canEditMeetingFields = Model.CanEditMeeting && !isLocked;
    var meetingPrintUrl = Url.Action("JednaniTisk", "Export", new { jednaniId = Model.Jednani.Id, projektId = Model.ProjektId, autoPrint = true }) ?? $"/Export/Jednani/{Model.Jednani.Id}/Tisk?projektId={Model.ProjektId}&autoPrint=true";
    var meetingWordUrl = Url.Action("JednaniWord", "Export", new { jednaniId = Model.Jednani.Id, projektId = Model.ProjektId }) ?? $"/Export/Jednani/{Model.Jednani.Id}/Word?projektId={Model.ProjektId}";
    var attendancePanelId = $"meeting-attendance-panel-{Model.Jednani.Id}";
    var attendanceSummaryItems = Model.Ucast
        .GroupBy(x => string.IsNullOrWhiteSpace(x.StavUcasti) ? "Bez stavu" : x.StavUcasti)
        .OrderBy(x => x.Key, StringComparer.CurrentCultureIgnoreCase)
        .Select(x => $"{x.Key}: {x.Count()}")
        .ToList();
    var attendanceSummaryText = Model.Ucast.Count == 0
        ? "Bez účastníků."
        : $"Celkem {Model.Ucast.Count} osob · {string.Join(" · ", attendanceSummaryItems)}";
}

@* Navigaci „zpět" a titulek jednání nese drobečková lišta (frame bar pod menu);
   samostatný _PageHeader odstraněn (2026-07-04). *@
<section class="meeting-detail-header">
    <p class="muted">@Model.Jednani.Datum.ToString("dd.MM.yyyy") v @Model.Jednani.CasZacatek.ToString("HH\\:mm")</p>
    <p class="muted">Místo: @Model.Jednani.Misto</p>
    @if (isLocked)
    {
        <p class="muted">Uzamkl: @(string.IsNullOrWhiteSpace(Model.Jednani.UzamklOsoba) ? "-" : Model.Jednani.UzamklOsoba)</p>
    }
    <div class="header-actions meeting-detail-actions">
        @* A6 (2026-07-08): BEZ href — viz Projekty/Detail.cshtml, stejný fix. *@
        <pm-button variant="Ghost"
                   data-print-trigger="true"
                   data-print-pdf-url="@meetingPrintUrl"
                   data-print-word-url="@meetingWordUrl"
                   data-print-label="Tisk jednání č. @Model.Jednani.CisloJednani">
            Tisk
        </pm-button>
        @if (canEditMeetingFields)
        {
            <pm-button variant="Secondary"
                       data-modal-url="@Url.Action("EditMeetingModal", "Jednani", new { projektId = Model.ProjektId, meetingId = Model.Jednani.Id })">
                Upravit jednání
            </pm-button>
        }
        @if (Model.CanEditMeeting)
        {
            <form asp-controller="Jednani" asp-action="Delete" method="post" data-ajax-submit="true" onsubmit="return confirm('Opravdu smazat jednání č. @Model.Jednani.CisloJednani? Budou smazána i navázaná vyjádření a účast.');">
                <input type="hidden" name="ProjektId" value="@Model.ProjektId" />
                <input type="hidden" name="JednaniId" value="@Model.Jednani.Id" />
                <pm-button variant="Ghost" native-type="submit">Smazat</pm-button>
            </form>
        }
    </div>
</section>

<div class="meeting-layout">
    <section class="card meeting-attendance-card" data-meeting-attendance-card>
        <div class="section-header meeting-attendance-header">
            <div class="meeting-attendance-summary">
                <h2>Účast</h2>
                <p class="muted">@attendanceSummaryText</p>
            </div>
            <div class="meeting-attendance-header-actions">
                @if (canEditMeetingFields)
                {
                    <pm-button variant="Secondary"
                               size="Small"
                               data-modal-url="@Url.Action("AddMeetingParticipantModal", "Jednani", new { projektId = Model.ProjektId, jednaniId = Model.Jednani.Id })">
                        Přidat osobu
                    </pm-button>
                }
                <pm-button variant="Ghost"
                           size="Small"
                           data-meeting-attendance-toggle="true"
                           aria-expanded="false"
                           aria-controls="@attendancePanelId">
                    @* Label ve spanu — JS ho přepíná bez zásahu do gov-button hostu (slot relocation). *@
                    <span data-meeting-attendance-label>Zobrazit účast</span>
                </pm-button>
            </div>
        </div>
        <div class="meeting-attendance-panel" id="@attendancePanelId" data-meeting-attendance-panel hidden>
            <form asp-action="SaveAttendance" method="post">
                <input type="hidden" name="projektId" value="@Model.ProjektId" />
                <input type="hidden" name="jednaniId" value="@Model.Jednani.Id" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                @* A1 (2026-07-08): grid řádkových karet místo tabulky. Form kontrakt rows[i] beze změny.
                   D1 (2026-07-10): inline tok jméno → role → e-mail (zalomení až při nedostatku šířky),
                   column-major dvousloupec — --attendance-rows = ⌈počet/2⌉ řídí grid-template-rows,
                   číslo řádku kreslí CSS counter (::before), žádná změna dat. *@
                <div class="meeting-attendance-grid" style="--attendance-rows: @((Model.Ucast.Count + 1) / 2)">
                @for (var i = 0; i < Model.Ucast.Count; i++)
                {
                    var ucast = Model.Ucast[i];
                    <div class="meeting-attendance-row">
                        <div class="meeting-attendance-person">
                            <strong>@ucast.Osoba</strong>
                            @if (ucast.AktivniRole.Count > 0)
                            {
                                <span class="muted meeting-attendance-roles">@string.Join(" · ", ucast.AktivniRole)</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(ucast.Email))
                            {
                                <span class="muted meeting-attendance-email">@ucast.Email</span>
                            }
                            <input type="hidden" name="rows[@i].OsobaId" value="@ucast.OsobaId" />
                        </div>
                        <select class="meeting-attendance-select" name="rows[@i].StavUcasti"
                                aria-label="Stav účasti — @ucast.Osoba" disabled="@(!canEditMeetingFields)">
                            @foreach (var stav in Model.StavyUcasti)
                            {
                                var selected = string.Equals(stav.Value, ucast.StavUcastiKod, StringComparison.OrdinalIgnoreCase)
                                    || string.Equals(stav.Label, ucast.StavUcasti, StringComparison.OrdinalIgnoreCase);
                                if (selected)
                                {
                                    <option value="@stav.Value" selected="selected">@stav.Label</option>
                                }
                                else
                                {
                                    <option value="@stav.Value">@stav.Label</option>
                                }
                            }
                        </select>
                    </div>
                }
                </div>
                @if (canEditMeetingFields)
                {
                    <div class="meeting-notes-actions">
                        <pm-button variant="Secondary" size="Small" native-type="submit">Uložit účast</pm-button>
                    </div>
                }
            </form>
        </div>
    </section>

    <section class="meeting-content">
        <div class="card">
            <div class="meeting-status">
                <div>
                    <h2>Stav jednání</h2>
                    <p class="muted">Upravte stav nebo jednání uzavřete / otevřete.</p>
                    @if (isLocked)
                    {
                        <p class="tag">Jednání je uzamčeno ve stavu @(uzavrenyStav?.Label ?? Model.Jednani.Stav).</p>
                    }
                </div>
                <div class="meeting-status-controls">
                    <form asp-action="SaveStatus" method="post" class="inline-form">
                        <input type="hidden" name="JednaniId" value="@Model.Jednani.Id" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <select class="wide-select" name="Stav" disabled="@(!canEditMeetingFields)">
                            @foreach (var stav in Model.StavyJednani)
                            {
                                var selected = string.Equals(stav.Value, Model.Jednani.StavKod, StringComparison.OrdinalIgnoreCase)
                                    || string.Equals(stav.Label, Model.Jednani.Stav, StringComparison.OrdinalIgnoreCase);
                                if (selected)
                                {
                                    <option value="@stav.Value" selected="selected">@stav.Label</option>
                                }
                                else
                                {
                                    <option value="@stav.Value">@stav.Label</option>
                                }
                            }
                        </select>
                        @if (canEditMeetingFields)
                        {
                            <pm-button variant="Secondary" native-type="submit">Uložit stav</pm-button>
                        }
                    </form>
                    @if (Model.CanEditMeeting)
                    {
                        if (isLocked)
                        {
                            if (otevrenyStav is not null)
                            {
                            <form asp-action="SaveStatus" method="post" class="inline-form">
                                <input type="hidden" name="JednaniId" value="@Model.Jednani.Id" />
                                <input type="hidden" name="Stav" value="@otevrenyStav.Value" />
                                <input type="hidden" name="OtevritJednani" value="true" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <pm-button variant="Secondary" native-type="submit">Otevřít jednání</pm-button>
                            </form>
                            }
                        }
                        else
                        {
                            if (uzavrenyStav is not null)
                            {
                            <form asp-action="SaveStatus" method="post" class="inline-form">
                                <input type="hidden" name="JednaniId" value="@Model.Jednani.Id" />
                                <input type="hidden" name="Stav" value="@uzavrenyStav.Value" />
                                <input type="hidden" name="UzavritJednani" value="true" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <pm-button variant="Ghost" native-type="submit">Uzavřít jednání</pm-button>
                            </form>
                            }
                        }
                    }
                </div>
            </div>
        </div>
        @* Sekce „Zápis úkolů" (záznamy + jejich vyjádření) odstraněna 2026-07-08 — na detailu
           jednání zůstávají jen detaily jednání (účast + stav). Vyjádření se evidují ze záložky
           Záznamy. Server stále počítá Model.Ukoly (integr. test + sdílené helpery), UI ho nerenderuje. *@
    </section>
</div>
