@model DocumentationPageViewModel

<section class="docs-page">
    <nav class="docs-breadcrumb" aria-label="Drobečková navigace">
        <a asp-controller="Dokumentace" asp-action="StromDokumentace">Dokumentace</a>
        <span>/</span>
        <span>@Model.SectionLabel</span>
    </nav>

    <div class="docs-header">
        <h1>@Model.Title</h1>
        <p>@Model.Subtitle</p>
    </div>

    <div class="docs-layout">
        <aside class="docs-sidebar" aria-label="Sekce dokumentace">
            <h2>Technická dokumentace</h2>
            @foreach (var item in Model.TechnicalNavigation)
            {
                <a class="@(item.IsActive ? "docs-nav-link active" : "docs-nav-link")" href="@item.Path">@item.Label</a>
            }

            @if (Model.SupportingNavigation.Count > 0)
            {
                <h2>Uživatelské a provozní</h2>
                @foreach (var item in Model.SupportingNavigation)
                {
                    <a class="@(item.IsActive ? "docs-nav-link active" : "docs-nav-link")" href="@item.Path">@item.Label</a>
                }
            }
        </aside>

        <article class="docs-content wiki-like">
            @Html.Raw(Model.HtmlContent)
        </article>

        <aside class="docs-toc" aria-label="Obsah stránky">
            <h2>Na stránce</h2>
            @if (Model.TocItems.Count == 0)
            {
                <p class="muted">Bez podnadpisů.</p>
            }
            else
            {
                @foreach (var item in Model.TocItems)
                {
                    <a class="@(item.Level == 3 ? "docs-toc-link level-3" : "docs-toc-link")" href="#@item.Id">@item.Label</a>
                }
            }
        </aside>
    </div>
</section>
