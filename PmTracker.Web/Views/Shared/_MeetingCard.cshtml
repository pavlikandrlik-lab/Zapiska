@model MeetingCardViewModel

@* Shared card component used in both project detail and meetings index.
   Keeps layout/actions consistent and removes duplicated markup. *@
<article class="meeting-card" data-href="@Model.DetailUrl" role="link" tabindex="0">
    <div class="meeting-card-top">
        <div class="meeting-number">Jednání č. @Model.Jednani.CisloJednani</div>
        <div class="meeting-card-actions">
            <a class="icon-btn meeting-print-btn"
               href="@Model.PrintPdfUrl"
               target="_blank"
               rel="noopener"
               aria-label="Tisk jednání č. @Model.Jednani.CisloJednani"
               data-stop-propagation="true"
               data-print-trigger="true"
               data-print-pdf-url="@Model.PrintPdfUrl"
               data-print-word-url="@Model.PrintWordUrl"
               data-print-label="Tisk jednání č. @Model.Jednani.CisloJednani">
                <gov-icon size="s" name="printer" type="components" aria-hidden="true"></gov-icon>
            </a>
            @if (Model.CanDelete)
            {
                if (Model.UseAjaxDelete)
                {
                    <form class="table-action-inline-form" asp-controller="Jednani" asp-action="Delete" method="post" data-stop-propagation="true" data-ajax-submit="true" onsubmit="return confirm('Opravdu smazat jednání č. @Model.Jednani.CisloJednani? Budou smazána i navázaná vyjádření a účast.');">
                        <input type="hidden" name="ProjektId" value="@Model.ProjektId" />
                        <input type="hidden" name="JednaniId" value="@Model.Jednani.Id" />
                        <button class="icon-btn meeting-delete-btn" type="submit" aria-label="Smazat jednání č. @Model.Jednani.CisloJednani">
                            <gov-icon size="s" name="trash3" type="components" aria-hidden="true"></gov-icon>
                        </button>
                    </form>
                }
                else
                {
                    <form class="table-action-inline-form" asp-controller="Jednani" asp-action="Delete" method="post" data-stop-propagation="true" onsubmit="return confirm('Opravdu smazat jednání č. @Model.Jednani.CisloJednani? Budou smazána i navázaná vyjádření a účast.');">
                        <input type="hidden" name="ProjektId" value="@Model.ProjektId" />
                        <input type="hidden" name="JednaniId" value="@Model.Jednani.Id" />
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <button class="icon-btn meeting-delete-btn" type="submit" aria-label="Smazat jednání č. @Model.Jednani.CisloJednani">
                            <gov-icon size="s" name="trash3" type="components" aria-hidden="true"></gov-icon>
                        </button>
                    </form>
                }
            }
        </div>
    </div>
    <div class="meeting-date">@Model.Jednani.Datum.ToString("dd.MM.yyyy") v @Model.Jednani.CasZacatek.ToString("HH\\:mm")</div>
    <div class="meeting-card-status">
        <span class="badge meeting-status-badge">@Model.Jednani.Stav</span>
    </div>
</article>
