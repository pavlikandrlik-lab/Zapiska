@model ScheduleBlockManualCellViewModel
@using PmTracker.Web.Models.Entities
@using PmTracker.Web.Models.ViewModels
@{
    var krok = Model.Krok;
    var manualInputIndex = Model.ManualInputIndex;
    var isLocked = Model.IsLocked;
    var canEdit = Model.CanEditManualActual && !isLocked;
    var isManualKrok = krok.IsManualKrok;
    var zdroj = krok.ZdrojSkutecnosti;

    // Plán 4 Feature C Task 6 — audit zdroj badge + toggle switch.
    // Badge mapuje SkutecnostZdroj (enum: Neznamo/Automat/Manual/Historicka) na ikonku + tooltip.
    // Toggle switch je viditelný jen když existuje HS0X_DELAY řádek (DelayHodnotaId > 0)
    // a user má CanToggleRezim (schedule not locked + isTaskCategory).
    var featureCBadgeIcon = krok.SkutecnostZdroj switch
    {
        SkutecnostZdrojEnum.Automat    => "\U0001F916", // 🤖 robot
        SkutecnostZdrojEnum.Manual     => "✍️", // ✍️ writing hand
        SkutecnostZdrojEnum.Historicka => "\U0001F4DC", // 📜 scroll
        _                              => "—"      // — em dash
    };
    var featureCBadgeTooltip = krok.SkutecnostZdroj switch
    {
        SkutecnostZdrojEnum.Automat    => "Skutečnost vyplněná automatem ze ServiceDesk vyjádření.",
        SkutecnostZdrojEnum.Manual     => "Skutečnost vyplněná ručně uživatelem.",
        SkutecnostZdrojEnum.Historicka => "Skutečnost migrovaná před zavedením auto-fill (historická data).",
        _                              => "Skutečnost nebyla vyplněna."
    };
    var featureCShowToggle = krok.CanToggleRezim && krok.DelayHodnotaId.HasValue;
    var featureCRezimLabel = krok.SkutecnostRezim == SkutecnostRezimEnum.Auto ? "Auto" : "Ručně";
    var featureCToggleAriaLabel = krok.SkutecnostRezim == SkutecnostRezimEnum.Auto
        ? $"Přepnout režim skutečnosti kroku {krok.Nazev} z Auto na Ručně"
        : $"Přepnout režim skutečnosti kroku {krok.Nazev} z Ručně na Auto";

    // Plán 4 Feature C Task 6 UI dropdown — chevron ▼ viditelný pro ≥2 kandidáty
    // + user má CanToggleRezim + není Manual režim (v Manual režimu je Preferred ignorován).
    // Create-if-missing (gap #3 2026-04-24): dropdown je viditelný i když DelayHodnotaId ještě
    // neexistuje — endpoint SelectCandidate umí create HS0X_DELAY row na první výběr.
    var featureCShowDropdown = krok.CanToggleRezim
        && krok.SkutecnostRezim == SkutecnostRezimEnum.Auto
        && krok.Kandidati.Count >= 2;
}

@* Plán D Task 8 — render skutečnosti kroku na základě ZdrojSkutecnosti:
   1) FromVyjadreni: read-only odchylka + chat ikona (otevře vyjádření)
   2) Manual / None u manual kroku (2/5/8/9): editovatelný date input nebo read-only span
   3) None u auto kroku (1/3/4/6/7/10): varovná ikona "automat zatím nenašel vyjádření"
   Plán 4 Feature C Task 6 — na všechny varianty navázán wrapper s badge (audit zdroj)
   a volitelným toggle switch (Auto ⇄ Ručně) vpravo nahoře.
*@
<div class="schedule-actual-cell"
     data-schedule-actual-cell
     data-hodnota-id="@(krok.DelayHodnotaId?.ToString() ?? "")"
     data-skutecnost-rezim="@krok.SkutecnostRezim"
     data-skutecnost-zdroj="@krok.SkutecnostZdroj"
     data-krok-poradi="@krok.KrokIndex">
    <div class="schedule-actual-cell__feature-c" aria-hidden="@(featureCShowToggle ? "false" : "true")">
        <span class="schedule-actual-cell__badge"
              data-feature-c-badge
              data-zdroj="@krok.SkutecnostZdroj"
              title="@featureCBadgeTooltip"
              aria-label="@featureCBadgeTooltip">@featureCBadgeIcon</span>
        @if (featureCShowDropdown)
        {
            <details class="schedule-actual-cell__dropdown"
                     data-feature-c-dropdown
                     data-hodnota-id="@(krok.DelayHodnotaId?.ToString() ?? "")"
                     data-zaznam-id="@Model.ZaznamId"
                     data-krok-poradi="@krok.KrokIndex">
                <summary class="schedule-actual-cell__dropdown-summary"
                         title="Zvolit jiný zdrojový ticket (@krok.Kandidati.Count kandidátů)"
                         aria-label="Zvolit jiný zdrojový ticket, @krok.Kandidati.Count kandidátů">
                    <span class="schedule-actual-cell__dropdown-chevron" aria-hidden="true">▼</span>
                </summary>
                <ul class="schedule-actual-cell__dropdown-list" role="menu">
                    @foreach (var kandidat in krok.Kandidati)
                    {
                        <li role="none" class="schedule-actual-cell__dropdown-item@(kandidat.IsSelected ? " schedule-actual-cell__dropdown-item--selected" : string.Empty)">
                            <button type="button"
                                    role="menuitem"
                                    class="schedule-actual-cell__dropdown-btn"
                                    data-feature-c-select-candidate
                                    data-hodnota-id="@(krok.DelayHodnotaId?.ToString() ?? "")"
                                    data-zaznam-id="@Model.ZaznamId"
                                    data-krok-poradi="@krok.KrokIndex"
                                    data-externi-odkaz-id="@kandidat.ExterniOdkazId"
                                    data-is-selected="@(kandidat.IsSelected ? "true" : "false")"
                                    aria-current="@(kandidat.IsSelected ? "true" : "false")">
                                <span class="schedule-actual-cell__dropdown-item-type">@kandidat.TypZaznamu</span>
                                <span class="schedule-actual-cell__dropdown-item-cislo">#@kandidat.Cislo6</span>
                                <span class="schedule-actual-cell__dropdown-item-datum">@kandidat.Datum.ToString("dd.MM.yyyy")</span>
                                @if (kandidat.IsSelected)
                                {
                                    <span class="schedule-actual-cell__dropdown-item-check" aria-hidden="true">✓</span>
                                }
                            </button>
                        </li>
                    }
                </ul>
            </details>
        }
        @* FIX 2026-05-03: per-krok Auto/Manual toggle nahrazen master switchem v tab strip
           ("Automatické vyplňování harmonogramu" — _EditZaznamForm.cshtml). Per-krok toggle
           byl duplicate UX a user explicitně řekl "chci aby se všechny kroky přepínaly buď
           auto nebo všechny kroky manuální". Bulk endpoint /Harmonogram/BulkSetRezim ignoruje
           manuální kroky 2/5/8/9 (= ty nejsou auto-fillable, vyplňují se vždy ručně). *@
    </div>

    <div class="schedule-actual-cell__main">
@*
    FIX 2026-05-04: pro auto-eligible kroky (1/3/4/6/7/10, isManualKrok=false) renderuje cell
    OBĚ varianty (auto bubble + manual editable input). CSS pravidla v site.css na atributu
    data-skutecnost-rezim ovládají počáteční viditelnost. Master switch v JS přepíná atribut
    bez reload — viditelnost se mění CSS-only. Form vždy obsahuje hidden KrokKey + AbsolutniDatum
    inputy (s prázdnou hodnotou pokud Auto), takže Save flow uložím rezim + datumy v jednom POST.
*@
@{
    var renderManualForAutoEligible = !isManualKrok && manualInputIndex >= 0 && canEdit;
}
@if (zdroj == PmTracker.Web.Services.Records.ZdrojSkutecnosti.FromVyjadreni)
{
    var datumLabel = krok.SourceVyjadreniDatum?.ToString("dd.MM.yyyy") ?? string.Empty;
    var tooltip = string.IsNullOrEmpty(datumLabel)
        ? "Skutečnost pochází z navázaného vyjádření."
        : $"Z vyjádření {datumLabel}";
    @* FIX 2026-05-04: visible datum musí odpovídat tooltipu — autoritativní datum je
       SourceVyjadreniDatum (datum konkrétního vyjádření, na které je krok navázán),
       ne computed SkutecneDatum (baseline + odchylka). Computed SkutecneDatum vracelo
       stejný datum pro všechny FromVyjadreni kroky (chybný diff/baseline scenario),
       i když tooltip ukazoval správný per-krok datum. *@
    var visibleDatum = krok.SourceVyjadreniDatum?.ToString("dd.MM.yyyy")
        ?? krok.SkutecneDatum.ToString("dd.MM.yyyy");
    <div class="schedule-actual-from-vyjadreni" data-schedule-actual-source="vyjadreni" data-rezim-show-on="Auto">
        <span class="schedule-actual-datum" data-manual-krok-readonly>@visibleDatum</span>
        @if (krok.SourceExterniOdkazId.HasValue && Model.ZaznamId > 0)
        {
            <pm-button variant="Ghost"
                       size="Small"
                       data-external-chat-open="true"
                       data-external-odkaz-id="@krok.SourceExterniOdkazId.Value"
                       data-external-zaznam-id="@Model.ZaznamId"
                       data-schedule-actual-from-vyjadreni
                       title="@tooltip"
                       aria-label="@tooltip">
                <gov-icon size="s" name="chat" type="components" aria-hidden="true"></gov-icon>
            </pm-button>
        }
    </div>
    @if (renderManualForAutoEligible)
    {
        <partial name="_ScheduleBlockManualCellInput" model="@(new PmTracker.Web.Models.ViewModels.ScheduleBlockManualCellViewModel
        {
            Krok = krok,
            ManualInputIndex = manualInputIndex,
            ZaznamId = Model.ZaznamId,
            CanEditManualActual = canEdit,
            IsLocked = isLocked
        })" />
    }
}
else if (isManualKrok)
{
    @* FIX 2026-05-04: Manuální krok 2/5/8/9 — render OBOU variant (manual input + bubble z vyjádření)
       + chevron-down dropdown pro výběr "Ručně" / "Z vyjádření". Volba se posílá v hidden inputu
       ManualActualKroky[i].PreferredZdroj ("Manual" / "Auto"). Server (RecordService.SaveRecord)
       Auto = reset DELAY row na Rezim=Auto, Zdroj=Neznamo, HodnotaInt=null. *@
    if (canEdit)
    {
        var isoValue = krok.ZdrojSkutecnosti == PmTracker.Web.Services.Records.ZdrojSkutecnosti.Manual
            ? krok.SkutecneDatum.ToString("yyyy-MM-dd")
            : string.Empty;
        var displayValue = krok.ZdrojSkutecnosti == PmTracker.Web.Services.Records.ZdrojSkutecnosti.Manual
            ? krok.SkutecneDatum.ToString("dd.MM.yyyy")
            : string.Empty;
        var hasVyjadreniBinding = krok.SourceVyjadreniDatum.HasValue;
        var initialPreferredZdroj = krok.ZdrojSkutecnosti == PmTracker.Web.Services.Records.ZdrojSkutecnosti.FromVyjadreni
            ? "Auto"
            : "Manual";
        var manualVariantShowOn = hasVyjadreniBinding ? "Manual" : null;
        var vyjadreniDatumDisplay = krok.SourceVyjadreniDatum?.ToString("dd.MM.yyyy") ?? string.Empty;
        var vyjadreniDatumTooltip = string.IsNullOrEmpty(vyjadreniDatumDisplay)
            ? "Datum z vyjádření zatím není dostupné."
            : $"Z vyjádření {vyjadreniDatumDisplay}";

        <input type="hidden"
               name="ManualActualKroky[@manualInputIndex].Poradi"
               value="@krok.KrokIndex"
               data-manual-krok-keyhidden />
        <input type="hidden"
               name="ManualActualKroky[@manualInputIndex].PreferredZdroj"
               value="@initialPreferredZdroj"
               data-manual-krok-preferred-zdroj
               data-manual-krok-key="@krok.KrokIndex" />

        <div class="schedule-actual-manual schedule-actual-manual-editable"
             data-schedule-actual-source="manual"
             data-rezim-show-on="@manualVariantShowOn">
            @await Html.PartialAsync(
                "_AppDateField",
                new AppDateFieldViewModel
                {
                    Name = $"ManualActualKroky[{manualInputIndex}].AbsolutniDatum",
                    IsoValue = isoValue,
                    DisplayValue = displayValue,
                    Locked = false,
                    Clearable = true,  // FIX 2026-05-05: user musí mít možnost smazat datum z manuálního kroku
                    AriaLabel = $"Skutečnost kroku {krok.Nazev}",
                    ContainerCssClass = "schedule-actual-manual-date",
                    ExtraDataAttributes = new Dictionary<string, object?>
                    {
                        ["data-manual-krok-input"] = "true",
                        ["data-manual-krok-index"] = krok.KrokIndex.ToString(),
                        ["data-manual-krok-key"] = krok.KrokIndex.ToString()
                    }
                })
        </div>

        @if (hasVyjadreniBinding)
        {
            <div class="schedule-actual-from-vyjadreni"
                 data-schedule-actual-source="vyjadreni"
                 data-rezim-show-on="Auto">
                <span class="schedule-actual-datum" data-manual-krok-readonly>@vyjadreniDatumDisplay</span>
                @if (krok.SourceExterniOdkazId.HasValue && Model.ZaznamId > 0)
                {
                    <pm-button variant="Ghost"
                               size="Small"
                               native-type="button"
                               data-external-chat-open="true"
                               data-external-odkaz-id="@krok.SourceExterniOdkazId.Value"
                               data-external-zaznam-id="@Model.ZaznamId"
                               data-schedule-actual-from-vyjadreni
                               title="@vyjadreniDatumTooltip"
                               aria-label="@vyjadreniDatumTooltip">
                        <gov-icon size="s" name="chat" type="components" aria-hidden="true"></gov-icon>
                    </pm-button>
                }
            </div>

            @* Chevron dropdown — výběr "Ručně" / "Z vyjádření". Klient JS aktualizuje
               data-skutecnost-rezim na cell + hidden PreferredZdroj. Pre-selected = current ZdrojSkutecnosti. *@
            <details class="schedule-actual-cell__dropdown"
                     data-manual-zdroj-dropdown
                     data-krok-key="@krok.KrokIndex">
                <summary class="schedule-actual-cell__dropdown-summary"
                         title="Zvolit zdroj skutečnosti"
                         aria-label="Zvolit zdroj skutečnosti">
                    <span class="schedule-actual-cell__dropdown-chevron" aria-hidden="true">▼</span>
                </summary>
                <ul class="schedule-actual-cell__dropdown-list" role="menu">
                    <li role="none">
                        <button type="button" role="menuitem"
                                class="schedule-actual-cell__dropdown-btn"
                                data-manual-zdroj-select="Manual"
                                aria-current="@(initialPreferredZdroj == "Manual" ? "true" : "false")">
                            <span aria-hidden="true">✍️</span>
                            <span>Ručně</span>
                        </button>
                    </li>
                    <li role="none">
                        <button type="button" role="menuitem"
                                class="schedule-actual-cell__dropdown-btn"
                                data-manual-zdroj-select="Auto"
                                aria-current="@(initialPreferredZdroj == "Auto" ? "true" : "false")">
                            <gov-icon size="s" name="chat" type="components" aria-hidden="true"></gov-icon>
                            <span>Z vyjádření</span>
                        </button>
                    </li>
                </ul>
            </details>
        }
    }
    else
    {
        var readonlyLabel = krok.ZdrojSkutecnosti == PmTracker.Web.Services.Records.ZdrojSkutecnosti.Manual
            ? krok.SkutecneDatum.ToString("dd.MM.yyyy")
            : "—";
        var lockedTooltip = isLocked
            ? "Skutečnost tohoto kroku je uzamčená — čeká se na rozhodnutí návrhu."
            : "Nemáte oprávnění editovat skutečnost.";
        <div class="schedule-actual-manual schedule-actual-manual-readonly" data-schedule-actual-source="manual">
            <span class="schedule-actual-datum"
                  data-manual-krok-readonly
                  data-manual-krok-locked="@(isLocked ? "true" : "false")"
                  title="@lockedTooltip">@readonlyLabel</span>
        </div>
    }
}
else
{
    @* Auto krok bez vazby — varovná ikona (Auto rezim variant) *@
    <div class="schedule-actual-pending" data-schedule-actual-source="none" data-rezim-show-on="Auto">
        <span class="schedule-actual-datum" data-manual-krok-readonly>—</span>
        <span class="schedule-actual-warning"
              data-manual-krok-warning
              title="Automat zatím nenašel vhodné vyjádření.">
            <gov-icon size="s" name="exclamation-triangle-fill" type="components" aria-hidden="true"></gov-icon>
        </span>
    </div>
    @if (renderManualForAutoEligible)
    {
        <partial name="_ScheduleBlockManualCellInput" model="@(new PmTracker.Web.Models.ViewModels.ScheduleBlockManualCellViewModel
        {
            Krok = krok,
            ManualInputIndex = manualInputIndex,
            ZaznamId = Model.ZaznamId,
            CanEditManualActual = canEdit,
            IsLocked = isLocked
        })" />
    }
}
    </div>
</div>
