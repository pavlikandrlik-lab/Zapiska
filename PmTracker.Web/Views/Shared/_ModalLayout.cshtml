@{
    Layout = null;
    var modalTitleId = ViewData["ModalTitleId"]?.ToString();
    if (string.IsNullOrWhiteSpace(modalTitleId))
    {
        modalTitleId = "modal-title";
    }

    var variant = ViewData["ModalVariant"]?.ToString();
    var normalizedVariant = string.Equals(variant, "record-editor", StringComparison.OrdinalIgnoreCase)
        ? "record-editor"
        : string.Equals(variant, "wide", StringComparison.OrdinalIgnoreCase)
            ? "wide"
            : "default";

    var overflowVisible = ViewData["ModalOverflowVisible"] is bool overflowBool
        ? overflowBool
        : string.Equals(ViewData["ModalOverflowVisible"]?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
}
@*
    Fáze 2E: <gov-dialog> nahrazuje custom .modal-overlay markup.
    Variants (default/wide/record-editor) + overflow-visible flag nese
    data-modal-variant / data-modal-overflow-visible atribut; CSS scope
    přes gov-dialog[data-modal-variant="..."] přibude v Task 5.

    Kompatibilita pro Task 3 JS:
    - data-modal-container — JS v modals.js + ajax.js hledá [data-modal-container]
      pro zásahy do modálu; nastaveno přímo na gov-dialog.
    - data-modal-close — close button zachovává tento atribut pro
      bootstrap.js click handler (app-level close flow s dirty-check).
    - Title slot — prázdný v layoutu; jednotlivé view si rendrují svůj
      vlastní <h2 id="record-modal-title">...</h2> uvnitř body, takže
      přemapování není potřeba (potvrzeno v plan Task 0 findings).
    - Floating-root (pro person/datetime pickery) je přemístěn do globálního
      #floating-panel-root v _Layout.cshtml (Task 3); floating-root atribut
      se v tomto layoutu již nevyskytuje (shadow DOM kolize gov-dialog).

    role="dialog" + aria-modal="true" jsou interní součástí gov-dialog shadow DOM
    (viz p-c99cc786.entry.js), Razor je nevydává jako HTML atributy. Jsou přítomné
    až po upgrade custom elementu (vyžaduje JS). Pre-upgrade stav je pro naši
    aplikaci přijatelný, protože celá aplikace vyžaduje JS pro provoz.

    block-close="true" + block-backdrop-close="true" činí gov-dialog purely
    presentational — Esc + backdrop click + vestavěný X button NEvyvolávají
    self-close přímo přes gov-dialog interní handlery. Tím kontrolujeme close
    přes bootstrap.js (data-modal-close handler s dirty-check →
    requestRecordEditorModalClose).
*@
<gov-dialog open="true"
            block-close="true"
            block-backdrop-close="true"
            data-modal-container
            data-modal-variant="@normalizedVariant"
            data-modal-overflow-visible="@(overflowVisible ? "true" : "false")"
            aria-labelledby="@modalTitleId"
            tabindex="-1">
    @*
        Close button: ponecháváme vlastní <button data-modal-close> s class modal-close
        jako JS hook (bootstrap.js delegace volá requestRecordEditorModalClose s dirty-check).
        Bez slot atributu — gov-dialog 4.2.9 neexpozuje "header-actions" slot (jen icon / title /
        footer / default). Button spadne do default slotu a renderuje se uvnitř content oblasti.
        Gov-dialog má vestavěný close button v headeru (gov-button.gov-dialog__close); jeho
        event wiring v bootstrap.js proběhne v Task 5/6 po runtime verifikaci (Task 4).
    *@
    <button class="modal-close" type="button" data-modal-close aria-label="Zavřít dialog">
        <span class="modal-close-icon" aria-hidden="true">&#10005;</span>
    </button>
    <div class="modal-content">
        @RenderBody()
    </div>
</gov-dialog>
