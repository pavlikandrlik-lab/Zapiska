@model PageHeaderViewModel

<section class="page-header">
    @if (!string.IsNullOrWhiteSpace(Model.BackUrl))
    {
        if (Model.UseRecordEditorBackNavigation)
        {
            <pm-button variant="Ghost"
                       size="Small"
                       href="@Model.BackUrl"
                       data-record-editor-cancel="true"
                       data-record-editor-back-url="@Model.BackUrl">
                @(Model.BackLabel ?? "Zpět")
            </pm-button>
        }
        else
        {
            <pm-button variant="Ghost" size="Small" href="@Model.BackUrl">@(Model.BackLabel ?? "Zpět")</pm-button>
        }
    }
    @* Content blok jen když je co zobrazit — Title/Subtitle/Badge lze vynechat
       (např. podstránka chce jen back tlačítko). Stránky s Title beze změny. *@
    @if (!string.IsNullOrWhiteSpace(Model.Title)
        || !string.IsNullOrWhiteSpace(Model.Subtitle)
        || !string.IsNullOrWhiteSpace(Model.Badge))
    {
        <div class="page-header-content">
            @if (!string.IsNullOrWhiteSpace(Model.Title))
            {
                <h1>@Model.Title</h1>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
            {
                <p class="muted">@Model.Subtitle</p>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Badge))
            {
                <span class="badge">@Model.Badge</span>
            }
        </div>
    }
</section>
