@inject PmTracker.Web.Services.Common.IApplicationVersionProvider ApplicationVersionProvider

<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Zápiska</title>
    <link rel="stylesheet" href="~/css/govcz.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body">
    @{
        var currentController = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).ToLowerInvariant();
        string NavClass(string controller) => currentController == controller ? "app-nav-link active" : "app-nav-link";
        var userContext = ViewBag.CurrentUserContext as CurrentUserContextViewModel;
        var roleList = userContext?.RoleKody is IReadOnlyList<string> roles
            ? string.Join(", ", roles)
            : string.Empty;
        var canViewPeopleTab = userContext?.HasPermissionPrefix(PermissionKeys.PeoplePrefix) ?? false;
        var canViewCiselnikyTab = userContext?.HasPermissionPrefix(PermissionKeys.CiselnikyPrefix) ?? false;
        var canViewSettingsTab = userContext?.HasPermissionPrefix(PermissionKeys.SettingsPrefix) ?? false;
    }
    <a class="skip-link" href="#main">Přeskočit na obsah</a>

    <header class="app-header">
        <div class="app-topbar">
            <div class="app-brand">
                <div class="app-logo" aria-hidden="true">
                    <img class="app-logo-image" src="~/images/zapiska-logo.svg" alt="" />
                </div>
                <div>
                    <div class="app-title">Zápiska</div>
                </div>
            </div>

            <div class="app-user-tools">
                <label class="gov-theme-switch app-theme-switch" for="theme-switch-main">
                    <input id="theme-switch-main" type="checkbox" data-theme-switch aria-label="Přepnout tmavý režim" />
                    <span class="gov-theme-switch-track" aria-hidden="true">
                        <span class="gov-theme-switch-icon gov-theme-switch-icon-sun">
                            <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                <path d="M12 4.75a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0V5.5a.75.75 0 0 1 .75-.75Zm0 11a3.75 3.75 0 1 0 0-7.5 3.75 3.75 0 0 0 0 7.5Zm7.25-4.5a.75.75 0 0 1 0 1.5h-1.5a.75.75 0 0 1 0-1.5h1.5Zm-13 0a.75.75 0 0 1 0 1.5h-1.5a.75.75 0 0 1 0-1.5h1.5Zm9.046-4.296a.75.75 0 0 1 1.061 0l1.061 1.061a.75.75 0 0 1-1.06 1.06l-1.062-1.06a.75.75 0 0 1 0-1.061Zm-8.652 8.652a.75.75 0 0 1 1.06 0l1.061 1.061a.75.75 0 1 1-1.06 1.06l-1.061-1.06a.75.75 0 0 1 0-1.061Zm9.713 1.06a.75.75 0 0 1 1.061 1.061l-1.061 1.061a.75.75 0 0 1-1.06-1.06l1.06-1.062Zm-8.652-8.651a.75.75 0 0 1 0 1.06L6.984 10.14a.75.75 0 0 1-1.06-1.06l1.06-1.062a.75.75 0 0 1 1.061 0ZM12 17a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 12 17Z" />
                            </svg>
                        </span>
                        <span class="gov-theme-switch-icon gov-theme-switch-icon-moon">
                            <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                <path d="M14.72 3.78a.75.75 0 0 1 .86.86 7.25 7.25 0 0 0 8.78 8.78.75.75 0 0 1 .86.86A9.25 9.25 0 1 1 14.72 3.78Zm-.91 1.77a7.75 7.75 0 1 0 7.64 7.64 8.75 8.75 0 0 1-7.64-7.64Z" transform="translate(-1.5 -1.5) scale(0.95)" />
                            </svg>
                        </span>
                        <span class="gov-theme-switch-thumb"></span>
                    </span>
                    <span class="gov-theme-switch-label">Vzhled</span>
                </label>

                <div class="user-menu" data-user-menu>
                    <button class="user-menu-toggle" type="button" data-user-menu-toggle aria-expanded="false" aria-haspopup="menu">
                        <span class="app-user-name">@ViewBag.CurrentUserName</span>
                        <span class="app-user-org">@ViewBag.CurrentUserOrgCode</span>
                    </button>
                    <div class="user-menu-panel" data-user-menu-panel hidden>
                        <div class="user-menu-meta">
                            <strong>@ViewBag.CurrentUserName</strong>
                            <span>@(string.IsNullOrWhiteSpace(ViewBag.CurrentUserEmail as string) ? "-" : ViewBag.CurrentUserEmail)</span>
                            <span>@ViewBag.CurrentUserOrg</span>
                            <span>@roleList</span>
                        </div>
                        <a class="user-menu-link" asp-controller="Profil" asp-action="Index">Můj profil</a>
                        <a class="user-menu-link" asp-controller="Profil" asp-action="Index" asp-fragment="moje-prava">Moje práva</a>
                    </div>
                </div>
            </div>
        </div>

        <nav class="app-nav" aria-label="Hlavní menu">
            <a class="@NavClass("projekty")" asp-controller="Projekty" asp-action="Index">Projekty</a>
            @if (canViewPeopleTab)
            {
                <a class="@NavClass("osoby")" asp-controller="Osoby" asp-action="Index">Osoby</a>
            }
            @if (canViewCiselnikyTab)
            {
                <a class="@NavClass("ciselniky")" asp-controller="Ciselniky" asp-action="Index">Číselníky</a>
            }
            <a class="@NavClass("jednani")" asp-controller="Jednani" asp-action="Index">Jednání</a>
            @if (canViewSettingsTab)
            {
                <a class="@NavClass("nastaveni")" asp-controller="Nastaveni" asp-action="Index">Nastavení</a>
            }
        </nav>
    </header>

    <main id="main" class="app-main">
        @if (TempData["ErrorMessage"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-error">@errorMessage</div>
        }
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="app-footer-grid">
            <div>
                <h3>Dokumenty</h3>
                <a asp-controller="Dokumentace" asp-action="UzivatelskaPrirucka">Uživatelská příručka</a>
                <a asp-controller="Dokumentace" asp-action="TechnickaDokumentace">Technická dokumentace</a>
                <a asp-controller="Dokumentace" asp-action="Qa">Q and A</a>
                <a asp-controller="Dokumentace" asp-action="Changelog">Changelog verzí</a>
            </div>
            <div>
                <h3>Informace</h3>
                <a href="https://servicedesk.fis.acr" target="_blank" rel="noopener noreferrer">Servicedesk</a>
                <a href="https://www.fis.acr/fis" target="_blank" rel="noopener noreferrer">Portál FIS</a>
                <a href="https://www.portalcechy.sis.acr" target="_blank" rel="noopener noreferrer">Portál ŠIS</a>
            </div>
            <div>
                <h3>Podpora</h3>
                <span>FIS: 973 200 840</span>
                <span>ISSP: 973 225 500</span>
                <span>ŠIS: 973 211 111</span>
            </div>
        </div>
        <div class="app-footer-meta">
            <small class="app-footer-version">Verze @ApplicationVersionProvider.DisplayVersion</small>
        </div>
    </footer>

    <div id="modal-root" class="modal-root" aria-hidden="true"></div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
