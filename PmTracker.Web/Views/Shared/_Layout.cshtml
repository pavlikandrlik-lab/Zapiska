@inject PmTracker.Web.Services.Common.IApplicationVersionProvider ApplicationVersionProvider
@inject Microsoft.Extensions.Options.IOptions<PmTracker.Web.Services.Search.SearchOptions> SearchOptionsAccessor

@{
    var themeModeCookie = Context.Request.Cookies["pmtracker.theme.mode"];
    var serverThemeMode = string.Equals(themeModeCookie, "dark", System.StringComparison.OrdinalIgnoreCase)
        ? "dark"
        : string.Equals(themeModeCookie, "light", System.StringComparison.OrdinalIgnoreCase)
            ? "light"
            : null;
}

<!DOCTYPE html>
<html lang="cs" data-theme="@serverThemeMode" data-theme-mode="@serverThemeMode">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Zápiska</title>
    <link rel="stylesheet" href="~/lib/gov-design-system/styles/lib/tokens.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/gov-design-system/dist/core/core.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/govcz.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/quill/quill.snow.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body">
    @{
        var currentController = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).ToLowerInvariant();
        var suppressActiveNavigation = string.Equals(currentController, "dashboard", System.StringComparison.OrdinalIgnoreCase);
        string NavClass(string controller) => !suppressActiveNavigation && currentController == controller ? "app-nav-link active" : "app-nav-link";
        var nav = ViewData["NavPermissions"] as NavPermissionsViewModel;
        var roleList = nav?.CurrentUserRoles is { Count: > 0 } roles
            ? string.Join(", ", roles)
            : string.Empty;
    }
    <a class="skip-link" href="#main">Přeskočit na obsah</a>

    <header class="app-header">
        <div class="app-topbar">
            <a class="app-brand" asp-controller="Dashboard" asp-action="Index" aria-label="Přejít na hlavní přehled">
                <div class="app-logo" aria-hidden="true">
                    <img class="app-logo-image" src="~/images/zapiska-logo.svg" alt="" />
                </div>
                <div>
                    <div class="app-title">Zápiska</div>
                </div>
            </a>

            @* Globální hledání v layoutu používá gov-form-search přímo (ne pm-search), protože
               pm-search (Fáze 2D) zatím nepodporuje slot="button-erase" (clear query button)
               ani atributy identifier + autocomplete na vnořeném gov-form-input.
               Tech debt: rozšířit pm-search o Erasable property a předávání dalších atributů. *@
            <form data-global-search
                  method="get"
                  asp-controller="Search"
                  asp-action="Index"
                  class="app-search"
                  role="search"
                  data-search-enabled="@(SearchOptionsAccessor.Value.Enabled ? "true" : "false")">
                <gov-form-search color="primary" size="m">
                    <gov-form-input slot="input" size="m" name="q" placeholder="Hledání"
                                    identifier="app-global-search-input"
                                    aria-label="Globální vyhledávání"
                                    autocomplete="off"></gov-form-input>
                    <gov-button slot="button-erase" size="s" color="primary" type="base"
                                data-global-search-erase hidden aria-label="Smazat dotaz">
                        <gov-icon slot="icon-start" name="x" type="components"></gov-icon>
                    </gov-button>
                    <gov-button slot="button" color="primary" size="s" type="solid">
                        Hledat
                    </gov-button>
                </gov-form-search>
                <div data-global-search-dropdown class="app-search-dropdown" hidden></div>
            </form>

            <div class="app-user-tools">
                <!-- gov-theme-switch Web Component (gov-design-system 4.x) emituje gov-change event.
                     theme.js zachycuje event, řídí 3-stavový model (light/dark/auto) a persistuje
                     volbu do cookie pmtracker.theme.mode. gov-theme-switch slouží pouze jako UI prvek. -->
                <div data-theme-switch class="app-theme-switch">
                    <gov-theme-switch
                        aria-label-light="Přepnout na tmavý mód"
                        aria-label-dark="Přepnout na světlý mód"
                        label-light="Světlý mód"
                        label-dark="Tmavý mód"
                        size="m">
                    </gov-theme-switch>
                </div>

                <div class="user-menu" data-user-menu>
                    <button class="user-menu-toggle" type="button" data-user-menu-toggle aria-expanded="false" aria-haspopup="menu">
                        <span class="app-user-name">@nav?.CurrentUserDisplayName</span>
                        <span class="app-user-org">@nav?.CurrentUserOrgCode</span>
                    </button>
                    <div class="user-menu-panel" data-user-menu-panel hidden>
                        <div class="user-menu-meta">
                            <strong>@nav?.CurrentUserDisplayName</strong>
                            <span>@(string.IsNullOrWhiteSpace(nav?.CurrentUserEmail) ? "-" : nav?.CurrentUserEmail)</span>
                            <span>@nav?.CurrentUserOrg</span>
                            <span>@roleList</span>
                        </div>
                        <a class="user-menu-link" asp-controller="Profil" asp-action="Index">Můj profil</a>
                        <a class="user-menu-link" asp-controller="Profil" asp-action="Index" asp-fragment="moje-prava">Moje práva</a>
                    </div>
                </div>
            </div>
        </div>

        <nav class="app-nav" aria-label="Hlavní menu">
            <a class="@NavClass("dashboard")" asp-controller="Dashboard" asp-action="Index">Přehled</a>
            <a class="@NavClass("projekty")" asp-controller="Projekty" asp-action="Index">Projekty</a>
            @if (nav?.CanViewPeople == true)
            {
                <a class="@NavClass("osoby")" asp-controller="Osoby" asp-action="Index">Osoby</a>
            }
            @if (nav?.CanViewCiselniky == true)
            {
                <a class="@NavClass("ciselniky")" asp-controller="Ciselniky" asp-action="Index">Číselníky</a>
            }
            <a class="@NavClass("jednani")" asp-controller="Jednani" asp-action="Index">Jednání</a>
            @if (nav?.CanViewSettings == true)
            {
                <a class="@NavClass("nastaveni")" asp-controller="Nastaveni" asp-action="Index">Nastavení</a>
            }
        </nav>
    </header>

    @{
        var bodyClass = ViewData["BodyClass"]?.ToString();
        var mainClass = bodyClass == "dashboard-page" ? "app-main app-main--fluid" : "app-main";
    }
    <main id="main" class="@mainClass">
        @if (TempData["ErrorMessage"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
        {
            <gov-message color="error">@errorMessage</gov-message>
        }
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="app-footer-grid">
            <div>
                <h3>Dokumenty</h3>
                <a asp-controller="Dokumentace" asp-action="UzivatelskaPrirucka">Uživatelská příručka</a>
                <a asp-controller="Dokumentace" asp-action="StromDokumentace">Technická dokumentace</a>
                <a asp-controller="Dokumentace" asp-action="Qa">Q and A</a>
                <a asp-controller="Dokumentace" asp-action="Changelog">Changelog verzí</a>
            </div>
            <div>
                <h3>Informace</h3>
                <a href="https://servicedesk.fis.acr" target="_blank" rel="noopener noreferrer">Servicedesk</a>
                <a href="https://www.fis.acr/fis" target="_blank" rel="noopener noreferrer">Portál FIS</a>
                <a href="https://www.portalcechy.sis.acr" target="_blank" rel="noopener noreferrer">Portál ŠIS</a>
            </div>
            <div>
                <h3>Podpora</h3>
                <span>FIS: 973 200 840</span>
                <span>ISSP: 973 225 500</span>
                <span>ŠIS: 973 211 111</span>
            </div>
        </div>
        <div class="app-footer-meta">
            <small class="app-footer-version">Verze @ApplicationVersionProvider.DisplayVersion</small>
        </div>
    </footer>

    <div id="modal-root" class="modal-root" aria-hidden="true"></div>

    @* Fáze 2E: globální floating-root pro pickery mounté nad modály.
       Gov-dialog shadow DOM není vhodný host (z-index + positioning kolize),
       takže person-picker / datetime-picker mají singleton root zde.
       ui.js:getFloatingLayerRoot vrací tohle vždy. *@
    <div id="floating-panel-root" aria-hidden="true"></div>

    <script type="module" src="~/lib/gov-design-system/dist/core/core.esm.min.js" asp-append-version="true"></script>
    <script src="~/lib/quill/quill.min.js" asp-append-version="true"></script>
    @* ES modules: browser si načte site.js, které přes imports natáhne všechny moduly.
       Žádný bundling, žádný build step, žádná ruční synchronizace site.bundle.js. HTTP/2
       multiplexing + per-file cache invalidation = srovnatelná rychlost pro interní admin app. *@
    <script type="module" src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/global-search.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
