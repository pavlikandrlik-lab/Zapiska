@model HarmonogramBlockViewModel
@{
    var isEditor = string.Equals(Model.Mode, "record-editor", StringComparison.OrdinalIgnoreCase);
    var rootCssClass = isEditor ? "schedule-editor" : "schedule-card-timeline";
    var overviewShellCssClass = isEditor ? "schedule-mini-gantt schedule-mini-gantt-grid" : "schedule-overview-timeline";
    var overviewRowCssClass = isEditor ? "schedule-mini-gantt-row" : "schedule-overview-row";
    var overviewLabelCssClass = isEditor ? "schedule-mini-gantt-row-label" : "schedule-overview-label";
    var overviewTrackCssClass = isEditor ? "schedule-mini-gantt-track schedule-mini-gantt-row-track" : "schedule-overview-track";
    var overviewAxisSpacerCssClass = isEditor ? "schedule-mini-gantt-axis-spacer" : "schedule-overview-axis-spacer";
    var overviewAxisCssClass = isEditor ? "timeline-axis schedule-mini-gantt-axis-track" : "timeline-axis schedule-overview-axis";
    var overviewSegmentCssClass = isEditor ? "schedule-mini-gantt-segment" : "schedule-overview-segment";
    var overviewMarkerCssClass = isEditor ? "schedule-mini-gantt-marker" : "schedule-overview-marker";
    // V editoru musíme vyrenderovat segmenty pro VŠECHNY kroky (i zero-duration),
    // aby je JS mohl zobrazit, když uživatel zadá kladné trvání. Segmenty s width=0
    // se schovávají přes display:none ve schedule.js (applySegmentLayout/resetSegmentLayout).
    // V readonly (card) variantě filtrujeme zero-duration, abychom se vyhnuli artefaktům.
    // Phase 9 (DESIGN-9-D, 2026-05-01): žádné skrývání kroků — všechny vždy v DOMu.
    // Per-row visibility (planned vs actual) řešená inline níže přes display:none style.
    var visibleCompactSteps = Model.Kroky
        .OrderBy(krok => krok.KrokIndex)
        .ToList();
    // Plán D Task 8: pořadí manual kroků v rámci ManualActualKroky[] binding.
    // Počítá se jen pro kroky, u kterých opravdu renderujeme manual input/read-only.
    var manualInputIndex = 0;
    var lockedManualKrokKeys = Model.LockedManualKrokKeys ?? new HashSet<int>();
    // Datum-model (Fáze 3b): server-vypočtené pozice baru pro statická zobrazení (jediný zdroj
    // pravdy). NULL = editor → block.js pozicuje live z editovaných datumů.
    var ovl = Model.OverviewLayout;
    var ovlSeg = ovl?.Segments.ToDictionary(s => s.Poradi);
    string Pct(double v) => v.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture) + "%";
}

<div class="@rootCssClass schedule-block"
     data-schedule-block
     data-schedule-mode="@Model.Mode"
     data-schedule-record-id="@Model.RecordId"
     data-schedule-start="@Model.DatumZalozeni.ToString("yyyy-MM-dd")"
     data-schedule-deadline="@Model.TerminUkonceni.ToString("yyyy-MM-dd")"
     @(isEditor ? "data-record-schedule-editor" : null)
     style="--record-schedule-delay-color:@Model.DelayBarvaHex;">
    @if (isEditor)
    {
        @if (!string.IsNullOrEmpty(Model.ScheduleVersion))
        {
            <input type="hidden" name="ScheduleVersion" value="@Model.ScheduleVersion" />
        }
        @if (Model.Permissions.IsScheduleLocked)
        {
            <gov-message color="warning">
                Harmonogram je do vyřízení aktivního návrhu uzamčený.
            </gov-message>
        }
        else if (Model.Permissions.IsPlanLocked)
        {
            <gov-message color="warning">
                Plánová část harmonogramu je do vyřízení aktivního návrhu uzamčená.
            </gov-message>
        }
        else if (Model.Permissions.CanEditDuration && !Model.Permissions.CanEditDelay)
        {
            <gov-message color="primary">
                V tomto režimu lze měnit pouze plánovou část harmonogramu. Skutečnost zůstává jen pro čtení.
            </gov-message>
        }

        var stavOk = Model.Souhrn.Dokonceno || Model.Souhrn.PrekroceniDni <= 0;
        var skluz = Model.Souhrn.PrekroceniDni;
        var stavText = Model.Souhrn.Dokonceno ? "Dokončeno"
            : skluz > 0 ? $"Aktuální krok: {Model.Souhrn.AktualniKrokNazev} · skluz +{skluz} dní"
            : skluz < 0 ? $"Aktuální krok: {Model.Souhrn.AktualniKrokNazev} · v předstihu {-skluz} dní"
            : $"Aktuální krok: {Model.Souhrn.AktualniKrokNazev} · dle plánu";
        <div class="schedule-summary-grid">
            <div><span class="label">Termín:</span> <strong data-schedule-summary-deadline>@Model.Souhrn.TerminUkolu.ToString("dd.MM.yyyy")</strong></div>
            <div><span class="label">Plán dokončení:</span> <strong data-schedule-summary-baseline>@Model.Souhrn.BaselineDokonceni.ToString("dd.MM.yyyy")</strong></div>
            <div><span class="label">Trvání:</span> <strong data-schedule-summary-duration>@Model.Souhrn.CelkoveTrvaniDni</strong> dnů</div>
            <div class="schedule-status-line @(stavOk ? "ok" : "late")">
                <span class="label">Stav:</span>
                <strong data-schedule-summary-state>@stavText</strong>
            </div>
        </div>
    }

    <div class="@overviewShellCssClass" @(isEditor ? "data-record-mini-gantt" : null)>
        @if (isEditor)
        {
            <div class="@overviewAxisSpacerCssClass" aria-hidden="true"></div>
            <div class="@overviewAxisCssClass"
                 data-schedule-axis="overview"
                 data-timeline-axis
                 data-axis-start="@Model.DatumZalozeni.ToString("yyyy-MM-dd")"
                 data-axis-end="@Model.TerminUkonceni.ToString("yyyy-MM-dd")"></div>
        }

        @foreach (var row in new[] { ("planned", "Plán"), ("actual", "Skutečnost") })
        {
            <div class="@overviewRowCssClass" data-schedule-overview-row="@row.Item1">
                <span class="@overviewLabelCssClass">@row.Item2</span>
                <div class="@overviewTrackCssClass" data-schedule-overview-track="@row.Item1">
                    <div class="@overviewMarkerCssClass today"
                         data-schedule-marker="today"
                         @(isEditor ? "data-schedule-gantt-today" : null)
                         style="@(ovl is null ? null : $"left:{Pct(ovl.TodayPct)}")"
                         title="Dnes"></div>
                    <div class="@overviewMarkerCssClass @(isEditor ? null : "deadline")"
                         data-schedule-marker="deadline"
                         @(isEditor ? "data-schedule-gantt-deadline" : null)
                         style="@(ovl is null ? null : $"left:{Pct(ovl.DeadlinePct)}")"></div>
                    @foreach (var krok in visibleCompactSteps)
                    {
                        // Phase 9 (DESIGN-9-D + 10-A, 2026-05-01): per-row segment visibility.
                        //   planned row: hidden pokud TrvaniDni == 0
                        //   actual row: hidden pokud OdchylkaDni == NULL (krok ještě nenastal)
                        var segmentTitle = row.Item1 == "planned"
                            ? $"{krok.Nazev}: plán {krok.BaselineDatum:dd.MM.yyyy}"
                            : $"{krok.Nazev}: skutečnost {(krok.OdchylkaDni.HasValue ? krok.SkutecneDatum!.Value.ToString("dd.MM.yyyy") : "—")}";
                        var ariaLabel = row.Item1 == "planned"
                            ? $"Krok {krok.KrokIndex} {krok.Nazev}: plán {krok.BaselineDatum:dd.MM.yyyy}"
                            : $"Krok {krok.KrokIndex} {krok.Nazev}: skutečnost {(krok.OdchylkaDni.HasValue ? krok.SkutecneDatum!.Value.ToString("dd.MM.yyyy") : "krok ještě nenastal")}";
                        var isPlannedHidden = row.Item1 == "planned" && krok.TrvaniDni <= 0;
                        var isActualHidden = row.Item1 == "actual" && !krok.OdchylkaDni.HasValue;

                        // Server-side pozice (statická zobrazení). NULL layout = editor → JS.
                        string positionStyle = string.Empty;
                        if (ovlSeg is not null && ovlSeg.TryGetValue(krok.KrokIndex, out var seg))
                        {
                            var left = row.Item1 == "planned" ? seg.PlanLeftPct : seg.ActualLeftPct;
                            var width = row.Item1 == "planned" ? seg.PlanWidthPct : seg.ActualWidthPct;
                            var hide = row.Item1 == "planned" ? (isPlannedHidden || width <= 0) : (isActualHidden || !seg.HasActual);
                            positionStyle = hide ? "display:none;" : $"left:{Pct(left)};width:calc({Pct(width)} + 1px);";
                        }
                        else
                        {
                            positionStyle = (isPlannedHidden || isActualHidden) ? "display:none;" : string.Empty;
                        }
                        <span class="@overviewSegmentCssClass"
                              role="img"
                              aria-label="@ariaLabel"
                              data-rainbow-segment-label-full="@krok.Nazev"
                              data-rainbow-segment-label-short="@krok.KrokIndex"
                              data-schedule-segment-kind="@row.Item1"
                              data-step-index="@krok.KrokIndex"
                              data-step-has-actual="@(krok.OdchylkaDni.HasValue ? "true" : "false")"
                              style="background:@krok.BarvaHex;@positionStyle"
                              title="@segmentTitle"></span>
                    }
                </div>
            </div>
        }

        @if (!isEditor)
        {
            <div class="schedule-overview-axis-row">
                <span class="@overviewAxisSpacerCssClass" aria-hidden="true"></span>
                <div class="@overviewAxisCssClass"
                     data-schedule-axis="overview"
                     data-timeline-axis
                     data-axis-start="@Model.DatumZalozeni.ToString("yyyy-MM-dd")"
                     data-axis-end="@((Model.OverviewLayout?.AxisEnd ?? Model.TerminUkonceni).ToString("yyyy-MM-dd"))"></div>
            </div>
        }
    </div>

    @if (isEditor)
    {
        <div class="schedule-mini-legend">Plán / Skutečnost / Dnes / Termín</div>
    }
    else
    {
        var miniSkluz = Model.Souhrn.PrekroceniDni;
        var miniStav = Model.Souhrn.Dokonceno ? "Dokončeno"
            : miniSkluz > 0 ? $"Aktuální krok: {Model.Souhrn.AktualniKrokNazev} · skluz +{miniSkluz} dní"
            : miniSkluz < 0 ? $"Aktuální krok: {Model.Souhrn.AktualniKrokNazev} · v předstihu {-miniSkluz} dní"
            : $"Aktuální krok: {Model.Souhrn.AktualniKrokNazev} · dle plánu";
        var miniOk = Model.Souhrn.Dokonceno || miniSkluz <= 0;
        <div class="schedule-layered-summary">
            <span>Plán: <strong data-schedule-summary-baseline>@Model.Souhrn.BaselineDokonceni.ToString("dd.MM.yyyy")</strong></span>
            <span>Termín: <strong data-schedule-summary-deadline>@Model.Souhrn.TerminUkolu.ToString("dd.MM.yyyy")</strong></span>
            <span class="schedule-status-line @(miniOk ? "ok" : "late")">Stav: <strong data-schedule-summary-state>@miniStav</strong></span>
        </div>

        <div class="gantt-steps schedule-steps" data-schedule-steps data-schedule-record-id="@Model.RecordId" hidden="hidden">
            <div class="schedule-layered-legend schedule-layered-legend--steps">
                <span><span class="schedule-layered-legend-swatch planned"></span>Plán</span>
                <span><span class="schedule-layered-legend-swatch actual"></span>Skutečnost</span>
                <span><span class="schedule-layered-legend-swatch today"></span>Dnes</span>
            </div>
            <div class="schedule-layered-axis-row">
                <span class="schedule-layered-axis-spacer" aria-hidden="true"></span>
                <div class="timeline-axis schedule-layered-axis"
                     data-schedule-axis="breakdown"
                     data-timeline-axis
                     data-axis-start="@Model.DatumZalozeni.ToString("yyyy-MM-dd")"
                     data-axis-end="@((ovl?.AxisEnd ?? Model.TerminUkonceni).ToString("yyyy-MM-dd"))"></div>
            </div>
            @* Phase 9 (DESIGN-9-D + 10-A, 2026-05-01): žádný filter, render každý krok plně.
               Tolerance hodnot:
                 hasPlan = TrvaniDni > 0
                 hasActual = OdchylkaDni.HasValue (NULL = krok nenastal, žádný actual segment) *@
            @foreach (var krok in Model.Kroky.OrderBy(k => k.KrokIndex))
            {
                var hasPlan = krok.TrvaniDni > 0;
                var hasActual = krok.OdchylkaDni.HasValue;
                var odchylka = krok.OdchylkaDni ?? 0;
                var offsetLabel = odchylka > 0 ? $"+{odchylka} dnů"
                                : odchylka < 0 ? $"{odchylka} dnů"
                                : "0 dnů";
                var offsetCssClass = odchylka > 0 ? "late" : odchylka < 0 ? "ahead" : null;
                PmTracker.Web.Services.Schedules.ScheduleBarSegment? bseg = null;
                if (ovlSeg is not null) { ovlSeg.TryGetValue(krok.KrokIndex, out bseg); }
                var plannedHiddenStyle = hasPlan && bseg is not null && bseg.PlanWidthPct > 0
                    ? $"left:{Pct(bseg.PlanLeftPct)};width:calc({Pct(bseg.PlanWidthPct)} + 1px);"
                    : "width:0;visibility:hidden;";
                var actualPosStyle = bseg is not null && bseg.HasActual
                    ? $"left:{Pct(bseg.ActualLeftPct)};width:calc({Pct(bseg.ActualWidthPct)} + 1px);"
                    : string.Empty;
                <div class="gantt-step-row"
                     data-schedule-step-row
                     data-step-index="@krok.KrokIndex"
                     data-step-name="@krok.Nazev"
                     data-step-color="@krok.BarvaHex"
                     data-step-duration="@krok.TrvaniDni"
                     data-step-delay="@(krok.OdchylkaDni?.ToString() ?? "")"
                     data-step-has-plan="@(hasPlan ? "true" : "false")"
                     data-step-has-actual="@(hasActual ? "true" : "false")">
                    <div class="gantt-step-name">
                        <span>@krok.Nazev</span>
                        @if (hasActual)
                        {
                            <span class="gantt-step-offset @offsetCssClass" data-schedule-offset>@offsetLabel</span>
                        }
                    </div>
                    <div class="schedule-layered-track schedule-layered-track--step" data-schedule-breakdown-track>
                        <div class="schedule-layered-marker today"
                             data-schedule-breakdown-today
                             style="@(ovl is null ? null : $"left:{Pct(ovl.TodayPct)}")"
                             title="Dnes"></div>
                        <span class="schedule-layered-segment planned"
                              role="img"
                              aria-label="Krok @krok.KrokIndex @krok.Nazev: plán @krok.BaselineDatum.ToString("dd.MM.yyyy")"
                              data-segment-tooltip="Krok @krok.KrokIndex @krok.Nazev: plán @krok.BaselineDatum.ToString("dd.MM.yyyy")"
                              data-rainbow-segment-label-full="@krok.Nazev"
                              data-rainbow-segment-label-short="@krok.KrokIndex"
                              data-schedule-breakdown-segment="planned"
                              data-step-index="@krok.KrokIndex"
                              data-step-zero-plan="@(hasPlan ? "false" : "true")"
                              style="background:@krok.BarvaHex;@plannedHiddenStyle"></span>
                        @if (hasActual)
                        {
                            <span class="schedule-layered-segment actual"
                                  role="img"
                                  aria-label="Krok @krok.KrokIndex @krok.Nazev: skutečnost @krok.SkutecneDatum!.Value.ToString("dd.MM.yyyy")"
                                  data-segment-tooltip="Krok @krok.KrokIndex @krok.Nazev: skutečnost @krok.SkutecneDatum!.Value.ToString("dd.MM.yyyy")"
                                  data-schedule-breakdown-segment="actual"
                                  data-step-index="@krok.KrokIndex"
                                  style="@actualPosStyle"></span>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @if (isEditor)
    {
        <div class="schedule-table-wrap">
            <table class="table schedule-table">
                <thead>
                    <tr>
                        <th>Krok</th>
                        <th>Trvání / datum</th>
                        <th>Skutečnost / datum</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Kroky.Count; i++)
                    {
                        var krok = Model.Kroky[i];
                        // Datum-model: disabled logika čistě z permission setu. Mrtvé offset gating přes
                        // krok.TrvaniTypId/ZpozdeniTypId zrušeno — v datum-modelu se nikdy nenastavovalo
                        // (vždy 0) → editor zamykal všechny plán/skutečnost inputy (regrese migrace).
                        // Proposal-diff highlight (durationChanged/delayChanged) běžel přes offset TypId;
                        // dokud se proposal-diff nepředělá na datum-model, je vypnutý (false/null).
                        var durationChanged = false;
                        var delayChanged = false;
                        string? durationTooltip = null;
                        string? delayTooltip = null;
                        var canEditDuration = !Model.Permissions.IsPlanLocked
                            && !Model.Permissions.IsScheduleLocked
                            && Model.Permissions.CanEditDuration
                            && (!Model.Permissions.IsAddOnlyMode || krok.TrvaniDni <= 0);
                        var canEditDelay = !Model.Permissions.IsScheduleLocked
                            && Model.Permissions.CanEditDelay;
                        var dateDisabled = !Model.Permissions.IsTaskCategory || !canEditDuration;
                        var delayDateDisabled = !Model.Permissions.IsTaskCategory || !canEditDelay;
                        <tr data-schedule-step-row
                            data-step-index="@krok.KrokIndex"
                            data-step-name="@krok.Nazev"
                            data-step-color="@krok.BarvaHex"
                            data-step-duration="@krok.TrvaniDni"
                            data-step-delay="@krok.OdchylkaDni"
                            data-step-actual-iso="@(krok.OdchylkaDni.HasValue ? krok.SkutecneDatum!.Value.ToString("yyyy-MM-dd") : string.Empty)">
                            <td>@krok.Nazev</td>
                            <td>
                                @* DESIGN-9-F (2026-05-02): DURATION input redesign — primární editor je
                                   kalendář (datum konce kroku). Trvání ve dnech se vypočte JS-em z rozdílu
                                   (datum konce - datum začátku) a propíše do hidden input pro form POST.
                                   Stepper +/− odstraněn — datum-driven flow je sjednocený se skutečností. *@
                                <div class="schedule-stacked-input @(durationChanged ? "proposal-field-changed" : null)"
                                     title="@durationTooltip">
                                    @* Datum-model (Fáze 3b): jeden HarmonogramHodnoty[i] na krok — Poradi + PlanDatum.
                                       Plánové datum konce kroku je primární editovatelná hodnota (žádné offsety). *@
                                    <input type="hidden" name="HarmonogramHodnoty[@i].Poradi" value="@krok.KrokIndex" />
                                    <div class="schedule-duration-row">
                                        @await Html.PartialAsync(
                                            "_AppDateField",
                                            new AppDateFieldViewModel
                                            {
                                                Name = $"HarmonogramHodnoty[{i}].PlanDatum",
                                                IsoValue = krok.BaselineDatum.ToString("yyyy-MM-dd"),
                                                DisplayValue = krok.BaselineDatum.ToString("dd.MM.yyyy"),
                                                Locked = dateDisabled,
                                                AriaLabel = $"Datum konce kroku {krok.Nazev}",
                                                ContainerCssClass = $"schedule-date-field schedule-date-field-stacked{(durationChanged ? " proposal-field-changed" : string.Empty)}",
                                                ExtraDataAttributes = new Dictionary<string, object?>
                                                {
                                                    ["data-schedule-duration-calendar"] = "true",
                                                    ["data-schedule-plan-step"] = krok.KrokIndex.ToString(),
                                                    ["title"] = durationTooltip
                                                }
                                            })
                                        <span class="schedule-duration-days-readonly"
                                              data-schedule-duration-readonly
                                              aria-label="Trvání ve dnech"
                                              title="Trvání kroku v kalendářních dnech (vypočteno z datumu konce a začátku kroku)">
                                            @krok.TrvaniDni dnů
                                        </span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @{
                                    // Plán D Task 8: Skutečnost sloupec — rozhodnutí mezi 4 scénáři:
                                    //  A) Manual krok {2,5,8,9} → date input (editable/read-only) přes _ScheduleBlockManualCell
                                    //  B) Auto krok s ZdrojSkutecnosti.FromVyjadreni → read-only odchylka + chat ikona
                                    //  C) Auto krok s ZdrojSkutecnosti.None → warning ikona (jen u existujícího záznamu)
                                    //  D) Ostatní (Create flow, legacy) → původní delay input UI
                                    //
                                    // U Create flow (RecordId = 0) ještě neexistuje žádná vazba / skutečnost,
                                    // takže ani warning ani read-only zobrazení nedává smysl — padá to na legacy
                                    // delay input, který umožní pre-fill. Manual kroky ale renderujeme vždy
                                    // (i u Create — schéma 3 pre-bound vazby).
                                    var zdrojSkut = krok.ZdrojSkutecnosti;
                                    var isKrokLocked = krok.KrokIndex >= 1 && lockedManualKrokKeys.Contains(krok.KrokIndex);
                                    var hasExistingRecord = Model.RecordId > 0;
                                    var useManualCell = krok.IsManualKrok;
                                    var useFromVyjadreniCell = !useManualCell
                                        && hasExistingRecord
                                        && zdrojSkut == PmTracker.Web.Services.Records.ZdrojSkutecnosti.FromVyjadreni;
                                    var useNoneCell = !useManualCell
                                        && !useFromVyjadreniCell
                                        && hasExistingRecord
                                        && zdrojSkut == PmTracker.Web.Services.Records.ZdrojSkutecnosti.None;
                                    // FIX 2026-05-04: master switch Manual rezim podporuje ruční datum i pro auto-eligible
                                    // kroky 1/3/4/6/7/10. Tj. assignedManualIndex se přiděluje VŠEM task-eligible cells
                                    // (ne jen 2/5/8/9). Cell partial render obě varianty (auto bubble + manual input)
                                    // a CSS pravidlo na data-skutecnost-rezim řídí výchozí viditelnost.
                                    var allowManualForAutoEligible = !useManualCell && hasExistingRecord && Model.CanEditManualActual;
                                    var canShowManualForRezim = useManualCell || allowManualForAutoEligible;
                                    var assignedManualIndex = canShowManualForRezim ? manualInputIndex++ : -1;
                                }
                                @* Datum-model (Fáze 3b): skutečnost (datum) řeší manuální buňka přes
                                   ManualActualKroky[]; plán už nese HarmonogramHodnoty[i].PlanDatum výše.
                                   Žádné offset DELAY páry. *@
                                @if (useManualCell)
                                {
                                    @await Html.PartialAsync(
                                        "_ScheduleBlockManualCell",
                                        new ScheduleBlockManualCellViewModel
                                        {
                                            Krok = krok,
                                            ManualInputIndex = assignedManualIndex,
                                            ZaznamId = Model.RecordId,
                                            CanEditManualActual = Model.CanEditManualActual,
                                            IsLocked = isKrokLocked
                                        })
                                }
                                else if (useFromVyjadreniCell)
                                {
                                    @await Html.PartialAsync(
                                        "_ScheduleBlockManualCell",
                                        new ScheduleBlockManualCellViewModel
                                        {
                                            Krok = krok,
                                            ManualInputIndex = assignedManualIndex,
                                            ZaznamId = Model.RecordId,
                                            CanEditManualActual = Model.CanEditManualActual,
                                            IsLocked = isKrokLocked
                                        })
                                }
                                else if (useNoneCell)
                                {
                                    @await Html.PartialAsync(
                                        "_ScheduleBlockManualCell",
                                        new ScheduleBlockManualCellViewModel
                                        {
                                            Krok = krok,
                                            ManualInputIndex = assignedManualIndex,
                                            ZaznamId = Model.RecordId,
                                            CanEditManualActual = Model.CanEditManualActual,
                                            IsLocked = isKrokLocked
                                        })
                                }
                                else
                                {
                                    // Datum-model (Fáze 3b): fallback (Create flow / ostatní) — skutečnost je
                                    // datum kroku (HarmonogramHodnoty[i].SkutecnostDatum), žádné offsety/steppery.
                                    // Prázdné = krok ještě nenastal.
                                    var hasActualDate = krok.OdchylkaDni.HasValue;
                                    var skutecnostIso = hasActualDate ? krok.SkutecneDatum!.Value.ToString("yyyy-MM-dd") : string.Empty;
                                    var skutecnostDisplay = hasActualDate ? krok.SkutecneDatum!.Value.ToString("dd.MM.yyyy") : string.Empty;
                                    <div class="schedule-stacked-input @(delayChanged ? "proposal-field-changed" : null)"
                                         title="@delayTooltip">
                                        @await Html.PartialAsync(
                                            "_AppDateField",
                                            new AppDateFieldViewModel
                                            {
                                                Name = $"HarmonogramHodnoty[{i}].SkutecnostDatum",
                                                IsoValue = skutecnostIso,
                                                DisplayValue = skutecnostDisplay,
                                                Locked = delayDateDisabled,
                                                Clearable = true,
                                                AriaLabel = $"Skutečnost kroku {krok.Nazev}",
                                                ContainerCssClass = $"schedule-date-field schedule-date-field-stacked{(delayChanged ? " proposal-field-changed" : string.Empty)}",
                                                ExtraDataAttributes = new Dictionary<string, object?>
                                                {
                                                    ["data-schedule-delay-date"] = "true",
                                                    ["data-schedule-actual-step"] = krok.KrokIndex.ToString(),
                                                    ["title"] = delayTooltip
                                                }
                                            })
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
