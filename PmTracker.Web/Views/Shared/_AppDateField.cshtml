@model AppDateFieldViewModel
@using System.Text.Encodings.Web
@*
    Razor wrapper kolem <pm-date-field> Custom Elementu (PmTracker.Web/wwwroot/js/components/pm-date-field.js).
    Existující call sites (ZaznamEdit basic, _ScheduleBlock plán + skutečnost, _ScheduleBlockManualCell, NewMeetingModal)
    používají typovaný AppDateFieldViewModel — wrapper rendere atributy elementu, samotná HTML struktura
    a kalendářní logika jsou v Custom Elementu.
*@
@{
    var lockedAttr = Model.Locked ? "true" : "false";
    var containerClassAttr = HtmlEncoder.Default.Encode(Model.ContainerCssClass ?? string.Empty);
    var nameAttr = HtmlEncoder.Default.Encode(Model.Name ?? string.Empty);
    var isoAttr = HtmlEncoder.Default.Encode(Model.IsoValue ?? string.Empty);
    var displayAttr = HtmlEncoder.Default.Encode(Model.DisplayValue ?? string.Empty);
    var ariaAttr = HtmlEncoder.Default.Encode(Model.AriaLabel ?? "Otevřít kalendář");

    var extraAttributeMarkup = string.Empty;
    if (Model.ExtraDataAttributes.Count > 0)
    {
        var parts = new List<string>();
        foreach (var attribute in Model.ExtraDataAttributes)
        {
            if (string.IsNullOrWhiteSpace(attribute.Key))
            {
                continue;
            }
            var value = attribute.Value?.ToString();
            if (string.IsNullOrWhiteSpace(value))
            {
                continue;
            }
            parts.Add($"{attribute.Key}=\"{HtmlEncoder.Default.Encode(value)}\"");
        }
        extraAttributeMarkup = string.Join(" ", parts);
    }
}
<pm-date-field name="@nameAttr"
               iso-value="@isoAttr"
               display-value="@displayAttr"
               locked="@lockedAttr"
               aria-label="@ariaAttr"
               container-css-class="@containerClassAttr"
               @Html.Raw(extraAttributeMarkup)></pm-date-field>
