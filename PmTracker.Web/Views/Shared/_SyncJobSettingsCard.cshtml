@model PmTracker.Web.Models.ViewModels.Sync.SyncJobSettingsCardViewModel

@{
    @* AnchorAt: zobrazujeme + bindujeme v lokálním čase serveru. ASP.NET model binder
       parsuje datetime-local string bez TZ jako lokální čas → DateTimeOffset má TZ serveru.
       Display přes UtcDateTime by způsobil drift o TZ offset při každém save+reload. *@
    var anchorLocal = Model.AnchorAt.LocalDateTime.ToString("yyyy-MM-ddTHH:mm");
    var disabledAttr = Model.CanManage ? null : "disabled";
}

<section class="sync-job-card" data-sync-job-card data-job-key="@Model.JobKey">
    <header class="sync-job-card__head">
        <h3 class="sync-job-card__title">@Model.Title</h3>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="sync-job-card__desc muted">@Model.Description</p>
        }
    </header>

    @if (Model.IsRunning)
    {
        <pm-alert variant="Info" role="status">
            Právě běží @(Model.LastTriggerKind == "manual" ? "(manuální spuštění)" : "(automatický tick)")
            @if (Model.RunStartedAt is not null)
            {
                <text> od @Model.RunStartedAt.Value.ToLocalTime().ToString("HH:mm:ss")</text>
            }
        </pm-alert>
    }

    <form asp-controller="NastaveniSync" asp-action="Save" asp-route-jobKey="@Model.JobKey" method="post" class="sync-job-card__form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="JobKey" value="@Model.JobKey" />

        <div class="sync-job-card__row sync-job-card__row--switch">
            <span class="sync-job-card__label">Zapnuto</span>
            @* gov-form-switch nereflektuje checked do form-data → držíme stav přes hidden input,
               JS sync (bootstrap.js → handleDocumentChange → syncSyncCardSwitchHidden). *@
            <input type="hidden" name="IsEnabled" value="@(Model.IsEnabled ? "true" : "false")" data-sync-card-switch-state />
            <gov-form-switch size="m"
                             data-sync-card-switch
                             data-job-key="@Model.JobKey"
                             @(Model.IsEnabled ? "checked" : null)
                             @disabledAttr>
                <span slot="label"><label>Aktivní synchronizace</label></span>
            </gov-form-switch>
        </div>

        <label class="sync-job-card__row">
            <span class="sync-job-card__label">Perioda (minuty)</span>
            <gov-form-input size="m"
                            input-type="number"
                            name="PeriodMinutes"
                            value="@Model.PeriodMinutes"
                            min="5"
                            max="10080"
                            @disabledAttr></gov-form-input>
        </label>

        <label class="sync-job-card__row">
            <span class="sync-job-card__label">Anchor (lokální čas)</span>
            <gov-form-input size="m"
                            input-type="datetime-local"
                            name="AnchorAt"
                            value="@anchorLocal"
                            @disabledAttr></gov-form-input>
        </label>

        <div class="sync-job-card__actions">
            <pm-button variant="Primary" native-type="submit" disabled="@(!Model.CanManage)">
                Uložit
            </pm-button>
        </div>
    </form>

    @if (Model.CanManage)
    {
        <form asp-controller="NastaveniSync"
              asp-action="RunNow"
              asp-route-jobKey="@Model.JobKey"
              method="post"
              class="sync-job-card__run-now">
            @Html.AntiForgeryToken()
            <input type="hidden" name="JobKey" value="@Model.JobKey" />
            <pm-button variant="Secondary"
                       native-type="submit"
                       disabled="@Model.IsRunning"
                       title="Spustit synchronizaci ihned (ignoruje plánovač)">
                Spustit teď
            </pm-button>
        </form>
    }

    @if (Model.UpcomingRuns.Count > 0)
    {
        <div class="sync-job-card__upcoming">
            <h4 class="sync-job-card__upcoming-title">Nejbližší plánovaná spuštění</h4>
            <ol class="sync-job-card__upcoming-list">
                @foreach (var when in Model.UpcomingRuns)
                {
                    <li>@when.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</li>
                }
            </ol>
            <p class="sync-job-card__upcoming-hint muted">
                Jen ukázka — přepočítá se po uložení změny periody nebo anchoru.
            </p>
        </div>
    }

    <div class="sync-job-card__status">
        <h4 class="sync-job-card__status-title">Status posledního běhu</h4>
        @if (Model.LastRunAt is null)
        {
            <p class="muted">Zatím nespuštěno.</p>
        }
        else
        {
            <dl class="sync-job-card__status-dl">
                <dt>Čas</dt>
                <dd>@Model.LastRunAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</dd>
                <dt>Spouštěč</dt>
                <dd>@(Model.LastTriggerKind == "manual" ? "Manuální" : "Automatický")</dd>
                @if (Model.LastResult is not null)
                {
                    <dt>OK</dt><dd>@Model.LastResult.OkCount</dd>
                    <dt>Chyby</dt><dd>@Model.LastResult.ErrorCount</dd>
                    @if (Model.LastResult.DurationMs is not null)
                    {
                        <dt>Trvání</dt><dd>@Model.LastResult.DurationMs ms</dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.LastResult.ErrorSummary))
                    {
                        <dt>Shrnutí chyb</dt><dd>@Model.LastResult.ErrorSummary</dd>
                    }
                }
            </dl>
        }
    </div>
</section>
