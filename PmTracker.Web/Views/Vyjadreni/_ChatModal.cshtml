@using PmTracker.Web.Models.Entities
@using PmTracker.Web.Models.ViewModels.Vyjadreni
@model VyjadreniModalViewModel

@{
    var canEdit = Model.CanEdit;
    var autosaveKey = $"pmtracker.chatmodal.autosave.{Model.ZaznamId}.{Model.ExterniOdkazId}";
    // Spec 2026-04-28: NES vazby jsou odpojené od harmonogramu — modal pro NES neukazuje
    // stepper sekci ani drag-drop hint v footeru. Ostatní typy (PMP/PNF) zobrazují stepper.
    var isNes = string.Equals(Model.TiketTyp, "NES", StringComparison.OrdinalIgnoreCase);
}

<div class="pm-chat-modal"
     data-chat-modal-root
     data-zaznam-id="@Model.ZaznamId"
     data-externi-odkaz-id="@Model.ExterniOdkazId"
     data-projekt-id="@Model.ProjektId"
     data-autosave-key="@autosaveKey"
     aria-label="Vyjádření a termíny">

    <header class="pm-chat-modal__header">
        <div class="pm-chat-modal__title">
            <span class="pm-chat-modal__cislo">@Model.TiketCislo</span>
            @if (!string.IsNullOrWhiteSpace(Model.TiketTyp))
            {
                <span class="pm-chat-modal__typ">@Model.TiketTyp</span>
            }
            @* Spec 2026-04-29: uzivatel + subsystem - modul mezi typem a popisem stručně. *@
            @if (!string.IsNullOrWhiteSpace(Model.TiketUzivatel))
            {
                <span class="pm-chat-modal__uzivatel">@Model.TiketUzivatel</span>
            }
            @{
                var hasSubsystem = !string.IsNullOrWhiteSpace(Model.TiketSubsystem);
                var hasModul = !string.IsNullOrWhiteSpace(Model.TiketModul);
            }
            @if (hasSubsystem || hasModul)
            {
                <span class="pm-chat-modal__sub-mod">@(hasSubsystem ? Model.TiketSubsystem : "—") - @(hasModul ? Model.TiketModul : "—")</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.TiketStrucne))
            {
                <span class="pm-chat-modal__strucne">@Model.TiketStrucne</span>
            }
        </div>
        <div class="pm-chat-modal__meta">
            @if (Model.LastHarvestedAt.HasValue)
            {
                <span class="pm-chat-modal__harvested-at" title="Poslední automatické vytěžení">
                    Vytěženo @Model.LastHarvestedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                </span>
            }
            @if (canEdit)
            {
                <form class="pm-chat-modal__reharvest-form" data-reharvest-form method="post" action="/Vyjadreni/ReHarvest">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="externiOdkazId" value="@Model.ExterniOdkazId" />
                    <pm-button variant="Secondary"
                               size="Small"
                               native-type="submit"
                               data-reharvest-btn
                               title="Znovu spustit automatické vytěžení vyjádření">
                        Znovu vytěžit
                    </pm-button>
                </form>
            }
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.EmptyMessage))
    {
        <gov-alert variant="info" role="status">
            @Model.EmptyMessage
        </gov-alert>
    }

    <div class="pm-chat-modal__body" role="group">
        <section class="pm-chat-modal__timeline" aria-label="Vyjádření">
            @if (Model.Bubliny.Count == 0)
            {
                <p class="pm-chat-modal__empty">Žádné bubliny.</p>
            }
            else
            {
                <ul class="pm-chat-modal__bubbles" role="list">
                    @* Spec 2026-04-29: intro bublina (HOT_ZAZNAMY.popis) jako první, řazení
                       reálných bublin DESC podle data. Intro nemá smysluplný datum (DateTime.MinValue)
                       takže se přirozeně objeví jako poslední v ASC; explicitně ji řadíme první. *@
                    @foreach (var bubble in Model.Bubliny.OrderByDescending(b => b.IsTicketIntro).ThenBy(b => b.Datum))
                    {
                        var autor = string.IsNullOrWhiteSpace(bubble.Autor) ? bubble.AutorLogin : bubble.Autor;
                        var klassP = string.IsNullOrWhiteSpace(bubble.Predikat) ? string.Empty : $"pm-chat-bubble--{bubble.Predikat.ToLowerInvariant()}";
                        var isAssigned = bubble.NavazanoNaKrokKey.HasValue;
                        var introClass = bubble.IsTicketIntro ? "pm-chat-bubble--intro" : string.Empty;
                        <li class="pm-chat-bubble @klassP @introClass @(isAssigned ? "pm-chat-bubble--assigned" : string.Empty)"
                            data-bubble
                            data-vyjadreni-id="@bubble.VyjadreniId"
                            data-datum="@bubble.Datum.ToString("o")"
                            data-predikat="@bubble.Predikat"
                            draggable="false"
                            role="listitem"
                            tabindex="0">
                            <div class="pm-chat-bubble__meta">
                                @if (bubble.IsTicketIntro)
                                {
                                    <span class="pm-chat-bubble__intro-label">Popis tiketu</span>
                                    @if (!string.IsNullOrWhiteSpace(autor))
                                    {
                                        <span class="pm-chat-bubble__autor">@autor</span>
                                    }
                                }
                                else
                                {
                                    @* User feedback 2026-04-29: AD resolver v offline intranetu vrací
                                       "Neznámý (login)" → ne smysluplné. Zobrazujeme přímo HOT_VYJADRENI.tym
                                       (autor span) + HOT_VYJADRENI.zpracoval (raw login, tym span style). *@
                                    @if (!string.IsNullOrWhiteSpace(bubble.Tym))
                                    {
                                        <span class="pm-chat-bubble__autor">@bubble.Tym</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(bubble.AutorLogin))
                                    {
                                        <span class="pm-chat-bubble__tym">@bubble.AutorLogin</span>
                                    }
                                    <time class="pm-chat-bubble__datum" datetime="@bubble.Datum.ToString("o")">
                                        @bubble.Datum.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    </time>
                                }
                                @* Spec 2026-04-29-modal-vyjadreni-dropdown §1, §6 — krok selector
                                   vpravo nahoře v meta line: badge (pokud assigned) nebo dropdown (pokud ne).
                                   Intro bublina nemá selector / badge. *@
                                <div class="pm-chat-bubble__krok">
                                    @if (bubble.IsTicketIntro)
                                    {
                                        // No selector for intro
                                    }
                                    else if (bubble.AssignedKrokKey.HasValue)
                                    {
                                        <gov-tag color="@bubble.AssignedKrokColor" size="s">
                                            Krok @bubble.AssignedKrokPoradi
                                        </gov-tag>
                                        @if (canEdit && !bubble.AssignedKrokIsPinned)
                                        {
                                            <button type="button"
                                                    class="pm-chat-bubble__krok-clear"
                                                    data-clear-bubble-binding
                                                    data-vyjadreni-id="@bubble.VyjadreniId"
                                                    title="Odebrat krok">
                                                ×
                                            </button>
                                        }
                                    }
                                    else if (canEdit && !isNes && bubble.StepOptions.Count > 0)
                                    {
                                        var dropdownOptions = bubble.StepOptions
                                            .Select(o => new
                                            {
                                                value = o.KrokKey.ToString(),
                                                label = $"Krok {o.KrokPoradi}: {o.Nazev}",
                                                disabled = o.IsDisabled,
                                                title = o.DisabledReason
                                            })
                                            .Cast<object>()
                                            .Prepend(new { value = "", label = "— vyber krok —", disabled = false, title = (string?)null });
                                        <gov-form-select size="s"
                                                         data-bubble-step-selector
                                                         data-vyjadreni-id="@bubble.VyjadreniId"
                                                         data-vyjadreni-datum="@bubble.Datum.ToString("o")"
                                                         options="@System.Text.Json.JsonSerializer.Serialize(dropdownOptions)">
                                        </gov-form-select>
                                    }
                                </div>
                            </div>
                            <div class="pm-chat-bubble__popis" style="white-space: pre-wrap;">
                                @bubble.PopisPlainText
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>

        @if (!isNes)
        {
            @* Spec 2026-04-29-modal-vyjadreni-dropdown §2 — stepper jako informational dashboard:
               sticky aligned kroky vedle bound bublin, click-to-scroll na bublinu.
               Buffer odstraněn — nepřiřazené kroky jsou implicit v dropdown options bublin. *@
            var prirazeneKroky = Model.Kroky.Where(k => k.AktualniVyjadreniId.HasValue).OrderBy(k => k.KrokPoradi).ToList();

        <section class="pm-chat-modal__stepper" aria-label="Kroky harmonogramu">
            <gov-stepper size="m" data-aligned-stepper>
                @foreach (var krok in prirazeneKroky)
                {
                    string color = krok.AktualniSource switch
                    {
                        (byte)VazbaSource.Auto => "success",
                        (byte)VazbaSource.Manual => "warning",
                        _ => "neutral"
                    };
                    <gov-stepper-item color="@color"
                                      identifier="krok-@krok.KrokKey"
                                      data-step
                                      data-krok-key="@krok.KrokKey"
                                      data-krok-poradi="@krok.KrokPoradi"
                                      data-vazba-id="@krok.VazbaId"
                                      data-source="@color"
                                      data-current-vyjadreni-id="@krok.AktualniVyjadreniId"
                                      data-current-datum="@krok.AktualniVyjadreniDatum?.ToString("o")"
                                      data-in-buffer="false">
                        <span slot="prefix">@krok.KrokPoradi</span>
                        <span slot="headline">@krok.Nazev</span>
                        <span slot="content">
                            @krok.AktualniVyjadreniDatum?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            @if (canEdit)
                            {
                                <button type="button" class="pm-chat-step__clear"
                                        data-clear-binding
                                        title="Odpojit krok od bubliny — krok se vrátí do bufferu">
                                    Odpojit
                                </button>
                            }
                        </span>
                    </gov-stepper-item>
                }
            </gov-stepper>
        </section>
        }
    </div>

    @if (canEdit && !isNes)
    {
        <footer class="pm-chat-modal__footer">
            <small class="pm-chat-modal__hint">
                Přetáhněte krok (vpravo) svisle na vyjádření (vlevo). Krok se přilepí k nejbližšímu vyjádření u kurzoru.
            </small>
            <div class="pm-chat-modal__status" data-chat-status aria-live="polite"></div>
        </footer>
    }

    @Html.AntiForgeryToken()
</div>
