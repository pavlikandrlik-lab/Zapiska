@model IReadOnlyList<DashboardFocusItemViewModel>

@if (Model.Count == 0)
{
    <p class="muted">Nenašli se žádné relevantní neukončené záznamy.</p>
}
else
{
    <div class="dashboard-focus-list">
        @foreach (var item in Model)
        {
            <a class="dashboard-focus-item" href="@item.DetailUrl">
                <div class="dashboard-focus-identity">
                    <span class="dashboard-item-project">@item.ProjectCode</span>
                    <span class="badge">@item.State</span>
                </div>
                <div class="dashboard-focus-content">
                    <div class="dashboard-focus-title">@item.RecordNumber - @item.Title</div>
                    @if (!string.IsNullOrWhiteSpace(item.Goal))
                    {
                        <p class="dashboard-item-description">@item.Goal</p>
                    }
                </div>
                <dl class="dashboard-focus-meta">
                    <div>
                        <dt>Vlastník</dt>
                        <dd>@item.Owner</dd>
                    </div>
                    <div>
                        <dt>Subsystem</dt>
                        <dd>@item.Subsystem</dd>
                    </div>
                    <div>
                        <dt>Založeno</dt>
                        <dd>@item.CreatedAt.ToString("dd.MM.yyyy")</dd>
                    </div>
                    <div>
                        <dt>Termín</dt>
                        <dd>@(item.Deadline?.ToString("dd.MM.yyyy") ?? "-")</dd>
                    </div>
                </dl>
            </a>
        }
    </div>
}
