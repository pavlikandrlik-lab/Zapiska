@model DashboardNewsListPageViewModel
@{
    ViewData["Title"] = Model.PageTitle;
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Title = Model.PageTitle,
    Subtitle = Model.Subtitle,
    BackUrl = Model.BackUrl,
    BackLabel = Model.BackLabel
})

<section class="dashboard-list-page dashboard-list-page-narrow">
    @await Html.PartialAsync("_DashboardNewsList", Model.Items)

    @if (Model.CanLoadMore && !string.IsNullOrWhiteSpace(Model.LoadMoreUrl))
    {
        <div class="dashboard-page-actions">
            <a class="btn" href="@Model.LoadMoreUrl">Načíst další</a>
        </div>
    }
</section>
