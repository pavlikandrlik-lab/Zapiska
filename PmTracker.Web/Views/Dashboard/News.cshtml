@model DashboardNewsListPageViewModel
@{
    ViewData["Title"] = Model.PageTitle;
    ViewData["BodyClass"] = "dashboard-page"; // stejně jako Focus → app-main--fluid (margin:0), zarovnání shora
}

@* Navigaci „zpět" nese drobečková lišta (frame bar pod menu); _PageHeader odstraněn (2026-07-04).
   Tab title v prohlížeči řídí ViewData["Title"] výše. *@
<section class="dashboard-list-page dashboard-list-page-narrow">
    @await Html.PartialAsync("_DashboardNewsList", Model.Items)

    @if (Model.CanLoadMore && !string.IsNullOrWhiteSpace(Model.LoadMoreUrl))
    {
        <div class="dashboard-page-actions">
            <pm-button variant="Secondary" href="@Model.LoadMoreUrl">Načíst další</pm-button>
        </div>
    }
</section>
