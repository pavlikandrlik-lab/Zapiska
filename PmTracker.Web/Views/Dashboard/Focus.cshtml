@model DashboardFocusListPageViewModel
@{
    ViewData["Title"] = Model.PageTitle;
    ViewData["BodyClass"] = "dashboard-page";
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Title = Model.PageTitle,
    Subtitle = Model.Subtitle,
    BackUrl = Model.BackUrl,
    BackLabel = Model.BackLabel
})

<section class="dashboard-list-page">
    @await Html.PartialAsync("_DashboardFocusList", Model.Items)
</section>
