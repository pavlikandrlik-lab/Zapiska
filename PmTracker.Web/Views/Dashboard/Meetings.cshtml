@model DashboardMeetingsListPageViewModel
@{
    ViewData["Title"] = Model.PageTitle;
}

@* Title + Subtitle záměrně vynechány (user 2026-06-09) — jen back tlačítko.
   Tab title v prohlížeči řídí ViewData["Title"] výše. *@
@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Title = "", // prázdný → _PageHeader nadpis nevyrenderuje (required member, nutno nastavit)
    BackUrl = Model.BackUrl,
    BackLabel = Model.BackLabel
})

<section class="dashboard-list-page dashboard-list-page-narrow">
    @await Html.PartialAsync("_DashboardMeetingsList", Model.Items)
</section>
