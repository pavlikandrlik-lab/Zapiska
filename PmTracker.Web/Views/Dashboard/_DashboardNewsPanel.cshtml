@model DashboardNewsPanelViewModel

<div class="dashboard-panel-body">
    <div class="dashboard-panel-header">
        <div>
            <h2>Co je nového</h2>
            <p class="muted">Poslední relevantní změny od ostatních uživatelů.</p>
        </div>
        <span class="dashboard-panel-count">@Model.LoadedCount / @Model.TotalCount</span>
    </div>

    @await Html.PartialAsync("_DashboardNewsList", Model.Items)

    <div class="dashboard-panel-footer">
        <pm-button variant="Ghost" size="Small" href="@Model.ListUrl">Zobrazit více</pm-button>
    </div>
</div>
