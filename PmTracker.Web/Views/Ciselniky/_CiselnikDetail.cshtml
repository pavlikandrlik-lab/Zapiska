@model CiselnikDetailViewModel
@{
    static (string DisplayLabel, string Email) SplitPersonLabel(string rawLabel)
    {
        if (string.IsNullOrWhiteSpace(rawLabel))
        {
            return (string.Empty, string.Empty);
        }

        var trimmed = rawLabel.Trim();
        var emailStart = trimmed.LastIndexOf(" <", StringComparison.Ordinal);
        if (emailStart > 0 && trimmed.EndsWith('>'))
        {
            var label = trimmed[..emailStart].Trim();
            var email = trimmed[(emailStart + 2)..^1].Trim();
            return (label, email);
        }

        return (trimmed, string.Empty);
    }
}

@* Nadpis číselníku (název + klíč) odstraněn (user 2026-06-10) — první je „Nová
   položka". Orientaci dává sidebar (zvýrazněný aktivní číselník). *@

@if (Model.CanEditThisCiselnik && Model.CanCreate)
{
    <div class="header-actions">
        <pm-button variant="Primary" href="#ciselnik-novy-radek">Nová položka</pm-button>
    </div>
}

<section class="card">
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Kód</th>
                <th>Název</th>
                @foreach (var sloupec in Model.SloupceNavic)
                {
                    <th>@sloupec</th>
                }
                <th>Zámek</th>
                <th class="table-actions">Akce</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var polozka in Model.Polozky)
        {
            var locked = polozka.IsLocked;
            <tr>
                <td>@polozka.Id</td>
                <td>@polozka.Kod</td>
                <td>@polozka.Nazev</td>
                @foreach (var hodnota in polozka.HodnotyNavic)
                {
                    <td>
                        @if (Model.IsHarmonogramCiselnik && !string.IsNullOrWhiteSpace(hodnota))
                        {
                            <span class="ciselnik-color-chip">
                                <span class="ciselnik-color-swatch" style="background:@hodnota;" aria-hidden="true"></span>
                                <code>@hodnota</code>
                            </span>
                        }
                        else
                        {
                            @hodnota
                        }
                    </td>
                }
                <td>
                    @if (locked)
                    {
                        <span class="lock">Zamčeno</span>
                    }
                    else
                    {
                        <span class="unlock">Odemčeno</span>
                    }
                </td>
                <td class="table-actions">
                    @if (Model.CanEditThisCiselnik)
                    {
                        <div class="table-actions-inline">
                            <pm-button variant="Secondary" size="Small" data-modal-url="@Url.Action("EditRow", "Ciselniky", new { key = Model.Key, id = polozka.Id })" disabled="@((locked && !polozka.CanChangeLockState) || !polozka.CanEdit)">Upravit</pm-button>
                            @if (polozka.CanDelete)
                            {
                                <form class="table-action-inline-form" asp-controller="Ciselniky" asp-action="DeleteRow" method="post" onsubmit="return confirm('Opravdu chcete tuto položku smazat?');">
                                    <input type="hidden" name="Key" value="@Model.Key" />
                                    <input type="hidden" name="Id" value="@polozka.Id" />
                                    <pm-button variant="Ghost" size="Small" native-type="submit" disabled="@(locked && !polozka.CanChangeLockState)">Smazat</pm-button>
                                </form>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="muted">Pouze čtení</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</section>

@if (Model.CanEditThisCiselnik && Model.CanCreate)
{
    <section class="card" id="ciselnik-novy-radek">
        <h3>Nová položka</h3>
        <form class="form-grid" asp-controller="Ciselniky" asp-action="SaveRow" method="post" data-ajax-submit="true">
            <input type="hidden" name="Key" value="@Model.Key" />
            <label>
                Kód
                <input type="text" name="Kod" required />
            </label>
            <label>
                Název
                <input type="text" name="Nazev" required />
            </label>
            @if (Model.SloupceNavic.Count > 0)
            {
                <label>
                    @Model.SloupceNavic[0]
                    @if (Model.IsSubsystemCiselnik && Model.IsHodnotaNavicSelect)
                    {
                        <div class="office-picker"
                             data-person-picker="single"
                             data-person-picker-placeholder="Vyhledejte vedoucího podle jména nebo emailu..."
                             data-person-picker-empty="Nenalezeny odpovídající osoby.">
                            <input type="hidden" name="HodnotyNavic[0]" value="" data-person-picker-hidden required />
                            <div class="office-searchbox" data-floating-anchor>
                                <input type="search" autocomplete="off" data-person-picker-input required />
                                <div class="office-search-panel" data-person-picker-panel data-floating-panel data-floating-kind="person-search" data-floating-match-width="true" hidden>
                                    <div class="office-search-results" data-person-picker-results role="listbox" aria-label="Výsledky osob"></div>
                                </div>
                            </div>
                            <div class="person-picker-source" data-person-picker-source hidden>
                                @foreach (var option in Model.HodnotaNavicVolby)
                                {
                                    var parsed = SplitPersonLabel(option.Label);
                                    <div data-id="@option.Value"
                                         data-label="@parsed.DisplayLabel"
                                         data-email="@parsed.Email"></div>
                                }
                            </div>
                        </div>
                    }
                    else if (Model.IsHodnotaNavicSelect)
                    {
                        <select name="HodnotyNavic[0]" required="@Model.IsHodnotaNavicRequired">
                            <option value="">Vyberte osobu</option>
                            @foreach (var option in Model.HodnotaNavicVolby)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                    }
                    else
                    {
                        if (Model.IsHarmonogramCiselnik)
                        {
                            <input type="color" name="HodnotyNavic[0]" value="#EF4444" />
                        }
                        else
                        {
                            <input type="text" name="HodnotyNavic[0]" />
                        }
                    }
                </label>
            }
            @if (!Model.IsSubsystemCiselnik && !Model.IsHarmonogramCiselnik && Model.CanChangeLockState)
            {
                <label class="filter-inline">
                    <input type="checkbox" name="IsLocked" value="true" />
                    Uzamknout položku
                </label>
            }
            <div class="form-actions">
                <pm-button variant="Primary" native-type="submit">Uložit</pm-button>
            </div>
        </form>
    </section>
}
