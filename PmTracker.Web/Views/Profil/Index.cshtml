@model ProfilPageViewModel
@{
    ViewData["Title"] = "Můj profil";
    ViewData["BodyClass"] = "dashboard-page";
}

@* Nadpis stránky odstraněn (user 2026-06-09) — generická hlavička pryč; orientaci dává hlavní menu. Tab title řídí ViewData["Title"]. *@

<div class="profile-layout">
    <section class="card">
        <h2>Identita</h2>
        <dl class="profile-meta">
            <div>
                <dt>Jméno</dt>
                <dd>@Model.Uzivatel.DisplayName</dd>
            </div>
            <div>
                <dt>Email</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Uzivatel.Email) ? "-" : Model.Uzivatel.Email)</dd>
            </div>
            <div>
                <dt>Organizační celek</dt>
                <dd>@Model.Uzivatel.OrganizacniCelek</dd>
            </div>
            <div>
                <dt>Role</dt>
                @* A5 (2026-07-08): jen počet — výčet je hned níže v „Moje role a práva". *@
                <dd><a href="#moje-prava">@Model.MojeRole.Count rolí</a></dd>
            </div>
        </dl>
    </section>

    <section class="card profile-preferences-card">
        <h2>Předvolby</h2>
        <p class="muted">Uloženo pouze v tomto prohlížeči na tomto počítači. Každou předvolbu lze smazat samostatně.</p>
        <ul class="preferences-list" data-preferences-list></ul>
        <p class="muted" data-preferences-empty hidden>Žádné uložené předvolby.</p>
        <p class="profile-preference-status" data-preferences-status aria-live="polite"></p>
    </section>

    @* Karta „Vyhledávání (admin)" (reindex FTS) zanikla se zrušením indexové vrstvy
       (spec 2026-09-17 §5). Vyhledávání jede přímo nad ostrými tabulkami, není co reindexovat. *@
</div>

<section id="moje-prava" class="card profile-rights-card">
    <div class="panel-header">
        <div>
            <h2>Moje role a práva</h2>
            @* A5 (2026-07-08): jednotné karty per INSTANCE role (aplikační / projektová /
               subsystémová) — nahrazuje dřívější oddělenou tabulku „Odvozená práva". *@
            <p class="muted">Všechny přiřazené role (aplikační, projektové i subsystémové) a jejich akce včetně rozsahu.</p>
        </div>
    </div>

    @if (Model.MojeRole.Count == 0)
    {
        <p class="muted">Uživatel nemá přiřazenou žádnou aktivní roli.</p>
    }
    else
    {
        <div class="profile-role-list">
        @foreach (var role in Model.MojeRole)
        {
            <details class="profile-role-card" data-role-typ="@role.TypRole">
                <summary class="profile-role-summary">
                    <span class="profile-role-summary-main">
                        <span class="profile-role-typ badge">@role.TypRole</span>
                        <span class="profile-role-name">@role.RoleNazev</span>
                        <code>@role.RoleKod</code>
                        @if (!string.IsNullOrWhiteSpace(role.ProjektZkratka))
                        {
                            <span class="profile-role-scope">Projekt: <strong>@role.ProjektZkratka</strong></span>
                        }
                        @if (!string.IsNullOrWhiteSpace(role.SubsystemKod))
                        {
                            <span class="profile-role-scope">Subsystém: <strong>@role.SubsystemKod</strong></span>
                        }
                    </span>
                    <span class="profile-role-summary-meta">@role.Akce.Count akcí</span>
                </summary>

                @if (!string.IsNullOrWhiteSpace(role.Popis))
                {
                    <p class="muted profile-role-description">@role.Popis</p>
                }

                @if (role.Akce.Count == 0)
                {
                    <p class="muted">Tato role nemá přiřazenou žádnou akci.</p>
                }
                else
                {
                    <table class="table profile-role-table">
                        <thead>
                            <tr>
                                <th>Akce</th>
                                <th>Název</th>
                                <th>Přístup</th>
                                <th>Rozsah</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var action in role.Akce)
                        {
                            <tr>
                                <td><code>@action.PermissionKlic</code></td>
                                <td>@action.PermissionNazev</td>
                                <td>
                                    @if (action.IsAllowed)
                                    {
                                        <span class="unlock">Povoleno</span>
                                    }
                                    else
                                    {
                                        <span class="lock">Zakázáno</span>
                                    }
                                </td>
                                <td>@action.ScopeSummary</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </details>
        }
        </div>
    }
</section>
