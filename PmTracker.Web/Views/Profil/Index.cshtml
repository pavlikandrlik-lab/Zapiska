@model ProfilPageViewModel
@{
    ViewData["Title"] = "Můj profil";
}

<section class="page-header">
    <div>
        <h1>Můj profil</h1>
        <p class="muted">Identita uživatele.</p>
    </div>
</section>

<div class="profile-layout">
    <section class="card">
        <h2>Identita</h2>
        <dl class="profile-meta">
            <div>
                <dt>Jméno</dt>
                <dd>@Model.Uzivatel.DisplayName</dd>
            </div>
            <div>
                <dt>Email</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Uzivatel.Email) ? "-" : Model.Uzivatel.Email)</dd>
            </div>
            <div>
                <dt>Organizační celek</dt>
                <dd>@Model.Uzivatel.OrganizacniCelek</dd>
            </div>
            <div>
                <dt>Role</dt>
                <dd>@string.Join(", ", Model.Uzivatel.RoleKody)</dd>
            </div>
        </dl>
    </section>

    <section class="card profile-print-preference-card">
        <h2>Preferovaný formát tisku</h2>
        <p class="muted">Nastavení je uloženo pouze v tomto prohlížeči na tomto počítači.</p>
        <p><strong>Aktuálně:</strong> <span data-print-preference-current>není nastaven</span></p>
        <button class="btn ghost" type="button" data-print-preference-reset>Zrušit uloženou volbu</button>
    </section>

    <section class="card profile-preferences-card">
        <h2>Uložené filtry projektu</h2>
        <p class="muted">Výchozí filtry a dočasně zapamatovaný stav se ukládají pouze v tomto prohlížeči na tomto počítači.</p>
        <button class="btn ghost" type="button" data-project-filter-preferences-reset>Smazat uložené projektové filtry</button>
        <p class="profile-preference-status" data-project-filter-preferences-status aria-live="polite"></p>
    </section>

    <section class="card profile-preferences-card">
        <h2>Výchozí otevření editoru záznamu</h2>
        <p class="muted">Volba se ukládá pouze v tomto prohlížeči na tomto počítači.</p>
        <p><strong>Aktuálně:</strong> <span data-record-editor-preference-current>není nastaveno</span></p>
        <button class="btn ghost" type="button" data-record-editor-preference-reset>Zrušit uloženou volbu</button>
        <p class="profile-preference-status" data-record-editor-preference-status aria-live="polite"></p>
    </section>
</div>

<section id="moje-prava" class="card profile-rights-card">
    <div class="panel-header">
        <div>
            <h2>Moje role a práva</h2>
            <p class="muted">Přehled přiřazených rolí a jejich akcí včetně rozsahu.</p>
        </div>
    </div>

    @if (Model.MojeRole.Count == 0)
    {
        <p class="muted">Uživatel nemá přiřazenou žádnou aktivní roli.</p>
    }
    else
    {
        <div class="profile-role-list">
        @foreach (var role in Model.MojeRole)
        {
            <details class="profile-role-card">
                <summary class="profile-role-summary">
                    <span class="profile-role-summary-main">
                        <span class="profile-role-name">@role.RoleNazev</span>
                        <code>@role.RoleKod</code>
                    </span>
                    <span class="profile-role-summary-meta">@role.Akce.Count akcí</span>
                </summary>

                @if (!string.IsNullOrWhiteSpace(role.Popis))
                {
                    <p class="muted profile-role-description">@role.Popis</p>
                }

                @if (role.Akce.Count == 0)
                {
                    <p class="muted">Tato role nemá přiřazenou žádnou akci.</p>
                }
                else
                {
                    <table class="table profile-role-table">
                        <thead>
                            <tr>
                                <th>Akce</th>
                                <th>Název</th>
                                <th>Přístup</th>
                                <th>Rozsah</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var action in role.Akce)
                        {
                            <tr>
                                <td><code>@action.PermissionKlic</code></td>
                                <td>@action.PermissionNazev</td>
                                <td>
                                    @if (action.IsAllowed)
                                    {
                                        <span class="unlock">Povoleno</span>
                                    }
                                    else
                                    {
                                        <span class="lock">Zakázáno</span>
                                    }
                                </td>
                                <td>@action.ScopeSummary</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </details>
        }
        </div>
    }
</section>

<section class="card profile-rights-card">
    <div class="panel-header">
        <div>
            <h2>Odvozená práva z projektu a subsystému</h2>
            <p class="muted">Práva odvozená z aktivních projektových a subsystémových rolí.</p>
        </div>
    </div>

    @if (Model.OdvozenaPrava.Count == 0)
    {
        <p class="muted">Nebyly nalezeny žádné odvozené granty.</p>
    }
    else
    {
        <table class="table profile-role-table">
            <thead>
                <tr>
                    <th>Akce</th>
                    <th>Název</th>
                    <th>Přístup</th>
                    <th>Rozsah</th>
                    <th>Zdroj</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pravo in Model.OdvozenaPrava)
                {
                    <tr>
                        <td><code>@pravo.PermissionKlic</code></td>
                        <td>@pravo.PermissionNazev</td>
                        <td>
                            @if (pravo.IsAllowed)
                            {
                                <span class="unlock">Povoleno</span>
                            }
                            else
                            {
                                <span class="lock">Zakázáno</span>
                            }
                        </td>
                        <td>@pravo.ScopeSummary</td>
                        <td>@pravo.SourceSummary</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
