@model OsobyIndexViewModel
@{
    ViewData["Title"] = "Osoby";
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Title = Model.PageTitle,
    Subtitle = "Globální seznam identit včetně organizační příslušnosti.",
    BackUrl = Model.BackUrl,
    BackLabel = Model.BackLabel
})

<div class="header-actions">
    @if (Model.CanManagePeople)
    {
        <button class="btn" type="button" data-modal-url="@Url.Action("AdPersonModal", "Osoby")">Přidat z AD</button>
        <button class="btn primary" type="button" data-modal-url="@Url.Action("ManualPersonModal", "Osoby")">Přidat ručně</button>
    }
    else
    {
        <span class="muted">Pouze čtení</span>
    }
</div>

<section class="card" data-osoby-table-card>
    <table class="table">
        <thead>
            <tr>
                <th>Jméno</th>
                <th>Příjmení</th>
                <th>Titul</th>
                <th>Email</th>
                <th>Organizace</th>
                <th>Organizační celek</th>
                <th>AD</th>
                @if (Model.CanManagePeople)
                {
                    <th class="table-actions">Akce</th>
                }
            </tr>
        </thead>
        <tbody>
        @foreach (var osoba in Model.Osoby)
        {
            <tr>
                <td>@osoba.Jmeno</td>
                <td>@osoba.Prijmeni</td>
                <td>@(string.IsNullOrWhiteSpace(osoba.Titul) ? "-" : osoba.Titul)</td>
                <td>@(string.IsNullOrWhiteSpace(osoba.Email) ? "-" : osoba.Email)</td>
                <td>@(osoba.Organizace ?? "-")</td>
                <td>@(osoba.OrganizacniCelek ?? "-")</td>
                <td>@(osoba.JeAdUcet ? "Ano" : "Ne")</td>
                @if (Model.CanManagePeople)
                {
                    <td class="table-actions">
                        <button class="btn small"
                                type="button"
                                data-modal-url="@Url.Action("ManualPersonModal", "Osoby", new { id = osoba.Id })">Upravit</button>
                        <form class="table-action-inline-form"
                              asp-controller="Osoby"
                              asp-action="Delete"
                              method="post"
                              onsubmit="return confirm('Opravdu odstranit osobu @($"{osoba.Jmeno} {osoba.Prijmeni}")?');">
                            <input type="hidden" name="Id" value="@osoba.Id" />
                            <button class="btn ghost small" type="submit">Odstranit</button>
                        </form>
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
</section>
