@model DashboardCardViewModel

@if (!string.IsNullOrWhiteSpace(Model.Controller) && !string.IsNullOrWhiteSpace(Model.Action))
{
    <a class="dashboard-card card @(Model.IsPrimary ? "dashboard-card-primary" : null)"
       asp-controller="@Model.Controller"
       asp-action="@Model.Action">
        <div class="dashboard-card-head">
            <h3>@Model.Title</h3>
            @if (!string.IsNullOrWhiteSpace(Model.Badge))
            {
                <span class="badge">@Model.Badge</span>
            }
        </div>
        <p>@Model.Description</p>
        @if (!string.IsNullOrWhiteSpace(Model.Meta))
        {
            <span class="dashboard-card-meta">@Model.Meta</span>
        }
    </a>
}
else
{
    <article class="dashboard-card card dashboard-card-placeholder" aria-disabled="true">
        <div class="dashboard-card-head">
            <h3>@Model.Title</h3>
            @if (!string.IsNullOrWhiteSpace(Model.Badge))
            {
                <span class="badge">@Model.Badge</span>
            }
        </div>
        <p>@Model.Description</p>
    </article>
}
