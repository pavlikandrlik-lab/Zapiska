@model DashboardPageViewModel
@{
    ViewData["Title"] = Model.PageTitle;
}

@await Html.PartialAsync("_PageHeader", new PageHeaderViewModel
{
    Title = Model.PageTitle,
    Subtitle = "Původní Home view je zachované jen jako fallback. Hlavní homepage běží v dashboard controlleru."
})

<div class="card">
    <p class="muted">Použijte dashboard na <a asp-controller="Dashboard" asp-action="Index">hlavní stránce přehledu</a>.</p>
</div>
