{
    "root": true,
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "env": {
        "browser": true,
        "es2022": true
    },
    "rules": {
        "max-lines": ["warn", { "max": 300, "skipBlankLines": true, "skipComments": true }]
    },
    "ignorePatterns": [
        "lib/"
    ]
}
