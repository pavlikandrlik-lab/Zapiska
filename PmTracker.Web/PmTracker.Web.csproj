<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppVersion>0.8</AppVersion>
    <Version>$(AppVersion)</Version>
    <InformationalVersion>$(AppVersion)</InformationalVersion>
    <UserSecretsId>7a025cd5-959a-4dd2-8705-8993a850699b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.2.0" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.12" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="System.DirectoryServices" Version="8.0.0" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PmTracker.ServiceDesk.Contracts\PmTracker.ServiceDesk.Contracts.csproj" />
    <ProjectReference Include="..\PmTracker.ServiceDesk.Sql\PmTracker.ServiceDesk.Sql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FIX 2026-05-04: appsettings.json + appsettings.Development.json se nedistribuují publish
         outputem (oba obsahují secrets — produkce Integrated Security, dev SQL Auth pro Colima).
         Production server (IIS) si admin nakopíruje vlastní appsettings.json podle šablony
         appsettings.example.json. Lokální dev používá appsettings.Development.json přes
         dotnet run / IIS Express, ale do Release publish output ho nezahrnujeme.
         CopyToPublishDirectory=Never u publish itemu, Content Remove ho vyhodí z dependencies. -->
    <Content Remove="appsettings.json" />
    <None Remove="appsettings.json" />
    <Content Update="appsettings.Development.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\docs\technical\*.md">
      <Link>DocsContent\technical\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\docs\user-guide.md">
      <Link>DocsContent\user-guide.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\docs\qa.md">
      <Link>DocsContent\qa.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\CHANGELOG.md">
      <Link>DocsContent\changelog.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
