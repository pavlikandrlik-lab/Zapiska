/* -------------------- Validace seedu -------------------- */
DECLARE @missingCodes TABLE (code nvarchar(255));
INSERT INTO @missingCodes (code)
SELECT req.code
FROM (VALUES (N'PLAN'), (N'RUN'), (N'DONE'), (N'DELETED')) AS req(code)
WHERE NOT EXISTS (
    SELECT 1
    FROM dbo.ciselnik_stavu_projektu sp
    WHERE UPPER(sp.kod) = req.code
);

IF EXISTS (SELECT 1 FROM @missingCodes)
BEGIN
    DECLARE @err nvarchar(max) = N'';
    DECLARE @throwMessage nvarchar(max);
    SELECT @err = CASE WHEN @err = N'' THEN code ELSE @err + N', ' + code END
    FROM @missingCodes
    ORDER BY code;

    SET @throwMessage = N'Chybí povinné hodnoty v ciselnik_stavu_projektu: ' + @err;
    THROW 52001, @throwMessage, 1;
END
GO
