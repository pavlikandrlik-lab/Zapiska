    delay_barva_hex nvarchar(7) NOT NULL CONSTRAINT DF_harmonogram_sablony_delay_barva_hex DEFAULT (N'#DC2626'),
    is_aktivni bit NOT NULL CONSTRAINT DF_harmonogram_sablony_is_aktivni DEFAULT (0),
    created_at datetime2 NOT NULL CONSTRAINT DF_harmonogram_sablony_created_at DEFAULT (SYSUTCDATETIME()),
    created_by int NULL,
    CONSTRAINT CK_harmonogram_sablony_delay_barva_hex CHECK (
        delay_barva_hex LIKE N'#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]'
