    nazev nvarchar(500) NOT NULL,
    hodnota int NOT NULL,
    is_locked bit NOT NULL CONSTRAINT DF_ciselnik_harmonogram_typu_is_locked DEFAULT (1),
    sablona_verze int NOT NULL,
    krok_key uniqueidentifier NOT NULL,
    krok_poradi int NOT NULL,
    je_zpozdeni bit NOT NULL,
    barva_hex nvarchar(7) NULL,
    CONSTRAINT CK_ciselnik_harmonogram_typu_krok_poradi_positive CHECK (krok_poradi > 0),
    CONSTRAINT CK_ciselnik_harmonogram_typu_barva_hex CHECK (
        barva_hex IS NULL OR barva_hex LIKE N'#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]'
    )
