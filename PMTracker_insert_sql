    aktualni_typ_ukolu_id int NULL,
    stav_ukolu_id int NULL,
    cislo_zaznamu int NOT NULL,
    cislo_viditelne nvarchar(32) NULL,
    cislo_viditelne_typ tinyint NOT NULL CONSTRAINT DF_projektove_zaznamy_cislo_viditelne_typ DEFAULT (0),
    cislo_viditelne_a int NOT NULL CONSTRAINT DF_projektove_zaznamy_cislo_viditelne_a DEFAULT (0),
    cislo_viditelne_b int NOT NULL CONSTRAINT DF_projektove_zaznamy_cislo_viditelne_b DEFAULT (0),
    cislo_jednani_zdroj_id int NULL,
    nazev nvarchar(255) NOT NULL,
    popis text NULL,
    vlastnik_id int NOT NULL,
    datum_zalozeni date NOT NULL,
    datum_ukonceni date NOT NULL,
    subsystem_id int NOT NULL,
    harmonogram_sablona_verze int NOT NULL CONSTRAINT DF_projektove_zaznamy_harmonogram_sablona_verze DEFAULT (1),
    CONSTRAINT CK_projektove_zaznamy_cislo_viditelne_typ CHECK (cislo_viditelne_typ IN (0, 1)),
    CONSTRAINT CK_projektove_zaznamy_cislo_viditelne_consistency CHECK (
        (cislo_viditelne_typ = 0 AND cislo_jednani_zdroj_id IS NULL AND cislo_viditelne_b = 0)
        OR
        (cislo_viditelne_typ = 1 AND cislo_jednani_zdroj_id IS NOT NULL AND cislo_viditelne_b > 0)
    )
);
